    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-1">
      <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/60">
        <span class="text-slate-500 block text-xs font-medium mb-1">Government Embassy Fee:</span>
        <span class="font-extrabold text-slate-900 text-sm block">Direct to Embassy / VFS</span>
        <span class="text-[11px] text-slate-500 mt-0.5 block">Zero platform markup or cut</span>
      </div>

      <div class="p-4 rounded-2xl bg-emerald-50/50 border border-emerald-200/60">
        <span class="text-emerald-800 block text-xs font-medium mb-1">TravlTik Platform Fee:</span>
        <span class="font-extrabold text-emerald-950 text-sm block">$5 / $10 / $15</span>
        <span class="text-[11px] text-emerald-700 mt-0.5 block">Protected in Milestone Escrow</span>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/60">
        <span class="text-slate-500 block text-xs font-medium mb-1">Hidden Convenience Markups:</span>
        <span class="font-black text-emerald-600 text-sm block">$0.00 — Zero Markup</span>
        <span class="text-[11px] text-slate-500 mt-0.5 block">Guaranteed no unexpected surprises</span>
