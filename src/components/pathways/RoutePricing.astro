---
// src/components/pathways/RoutePricing.astro
interface Props {
  country: string;
  purpose: string;
}
const { country, purpose } = Astro.props;
---

<div class="mt-8 p-6 rounded-2xl bg-slate-50 border border-slate-200 shadow-sm">
  <div class="mb-5">
    <h3 class="text-lg font-bold text-slate-900">Choose Your Service Level</h3>
    <p class="text-sm text-slate-500 mt-1">
      Transparent pricing. No hidden fees. Escrow protected.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    <!-- Tier 1: DIY Assisted ($29) -->
    <div class="p-5 rounded-2xl border border-slate-200 bg-white hover:shadow-lg transition-shadow flex flex-col justify-between">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">DIY Assisted</div>
        <div class="flex items-baseline gap-1 mt-2">
          <span class="text-3xl font-black text-slate-900">$29</span>
          <span class="text-xs text-slate-500">/ self-file with AI</span>
        </div>
        <p class="text-xs text-slate-500 mt-2">AI document validation &amp; submission guide</p>
        <ul class="mt-4 space-y-2 text-xs text-slate-600">
          <li class="flex items-start gap-2"><span class="text-emerald-500">✓</span><span>AI Document Checklist &amp; Pre-audit</span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-500">✓</span><span>SOP &amp; Cover Letter Generator</span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-500">✓</span><span>Biometric Photo Resizer Tool</span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-500">✓</span><span>Consular Form Auto-Fill Guide</span></li>
        </ul>
      </div>
      <a href={`/checkout?tier=starter&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
         class="block w-full mt-5 py-2.5 text-center border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
        Select DIY — $29
      </a>
    </div>

    <!-- Tier 2: Legal Review ($199) -->
    <div class="p-5 rounded-2xl border-2 border-[#00a896] bg-teal-50/30 relative hover:shadow-xl transition-shadow flex flex-col justify-between">
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-[#00a896] text-white text-[10px] font-bold rounded-full uppercase tracking-wider shadow-sm">
        Most Popular
      </span>
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-[#00a896]">Legal Review</div>
        <div class="flex items-baseline gap-1 mt-2">
          <span class="text-3xl font-black text-slate-900">$199</span>
          <span class="text-xs text-slate-500">/ Licensed Attorney Check</span>
        </div>
        <p class="text-xs text-slate-600 mt-2">AI + Licensed RCIC / MARA counsel vetting</p>
        <ul class="mt-4 space-y-2 text-xs text-slate-700">
          <li class="flex items-start gap-2"><span class="text-[#00a896]">✓</span><span>Everything in DIY Assisted</span></li>
          <li class="flex items-start gap-2"><span class="text-[#00a896]">✓</span><span>Official RCIC / MARA / Solicitor Review</span></li>
          <li class="flex items-start gap-2"><span class="text-[#00a896]">✓</span><span>Detailed Refusal Risk Audit Report</span></li>
          <li class="flex items-start gap-2"><span class="text-[#00a896]">✓</span><span>100% Escrow Milestone Protection</span></li>
        </ul>
      </div>
      <a href={`/checkout?tier=professional&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
         class="block w-full mt-5 py-2.5 text-center bg-[#00a896] hover:bg-[#028090] text-white rounded-lg text-sm font-semibold transition-colors shadow-sm">
        Select Legal Review — $199
      </a>
    </div>

    <!-- Tier 3: Concierge Filing ($399) -->
    <div class="p-5 rounded-2xl border border-slate-200 bg-white hover:shadow-lg transition-shadow flex flex-col justify-between">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-amber-700">Concierge</div>
        <div class="flex items-baseline gap-1 mt-2">
          <span class="text-3xl font-black text-slate-900">$399</span>
          <span class="text-xs text-slate-500">/ Complete White-Glove</span>
        </div>
        <p class="text-xs text-slate-500 mt-2">End-to-end representation with priority escrow</p>
        <ul class="mt-4 space-y-2 text-xs text-slate-600">
          <li class="flex items-start gap-2"><span class="text-amber-600">✓</span><span>Everything in Legal Review</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600">✓</span><span>Dedicated Licensed Case Officer</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600">✓</span><span>VFS Appointment Priority Booking</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600">✓</span><span>Mock Consular Interview Prep</span></li>
        </ul>
      </div>
      <a href={`/checkout?tier=concierge&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
         class="block w-full mt-5 py-2.5 text-center border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
        Select Concierge — $399
      </a>
    </div>

  </div>

  <div class="mt-5 flex items-center justify-center gap-4 text-xs text-slate-500 flex-wrap">
    <span class="flex items-center gap-1"><span class="text-emerald-500">🔒</span>Escrow Protected</span>
    <span class="flex items-center gap-1"><span class="text-emerald-500">↩️</span>7-Day Refund</span>
    <span class="flex items-center gap-1"><span class="text-emerald-500">✓</span>No Hidden Fees</span>
  </div>
</div>
