---
// src/components/pathways/RoutePricing.astro
interface Props {
  country: string;
  purpose: string;
}
const { country, purpose } = Astro.props;
---

<div class="mt-8 p-6 rounded-2xl bg-slate-50 border border-slate-200 shadow-sm">
  <div class="mb-5">
    <h3 class="text-lg font-bold text-slate-900">Choose Your Service Level</h3>
    <p class="text-sm text-slate-500 mt-1">
      Transparent pricing. No hidden fees. Escrow protected.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    <!-- Tier 1: Starter ($5 - 3 queries) -->
    <div class="p-5 rounded-2xl border border-slate-200 bg-white hover:shadow-lg transition-shadow flex flex-col justify-between">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Starter Pathway</div>
        <div class="flex items-baseline gap-1 mt-2">
          <span class="text-3xl font-black text-slate-900">$5</span>
          <span class="text-xs text-slate-500">/ 3 AI Visa Queries</span>
        </div>
        <p class="text-xs text-slate-500 mt-2">Full consular requirements, AI checklist &amp; pathway search</p>
        <ul class="mt-4 space-y-2 text-xs text-slate-600">
          <li class="flex items-start gap-2"><span class="text-emerald-500 font-bold">✓</span><span><strong>3 Full AI Visa Queries</strong></span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-500 font-bold">✓</span><span>Consular Document Checklist &amp; Pre-audit</span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-500 font-bold">✓</span><span>Biometric Photo Resizer Tool</span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-500 font-bold">✓</span><span>Instant Digital Activation</span></li>
        </ul>

        <!-- Govt vs Platform Fee Transparency Breakdown (Step 38) -->
        <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 space-y-1">
          <div class="flex justify-between items-center">
            <span>Govt Embassy Fee:</span>
            <span class="font-semibold text-slate-700">Paid direct to Govt</span>
          </div>
          <div class="flex justify-between items-center">
            <span>TravlTik Service Fee:</span>
            <span class="font-semibold text-slate-900">$5 (Included)</span>
          </div>
        </div>
      </div>
      <a href={`/checkout?tier=starter&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
         class="block w-full mt-5 py-2.5 text-center border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
        Select Starter — $5
      </a>
    </div>

    <!-- Tier 2: Professional ($10 - 10 queries) -->
    <div class="p-5 rounded-2xl border-2 border-[#00a896] bg-teal-50/30 relative hover:shadow-xl transition-shadow flex flex-col justify-between">
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-[#00a896] text-white text-[10px] font-bold rounded-full uppercase tracking-wider shadow-sm">
        Most Popular
      </span>
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-[#00a896]">Professional Pack</div>
        <div class="flex items-baseline gap-1 mt-2">
          <span class="text-3xl font-black text-slate-900">$10</span>
          <span class="text-xs text-slate-500">/ 10 AI Visa Queries</span>
        </div>
        <p class="text-xs text-slate-600 mt-2">Complete dossier preparation + SOP &amp; Cover Letter builder</p>
        <ul class="mt-4 space-y-2 text-xs text-slate-700">
          <li class="flex items-start gap-2"><span class="text-[#00a896] font-bold">✓</span><span><strong>10 AI Visa Queries</strong></span></li>
          <li class="flex items-start gap-2"><span class="text-[#00a896] font-bold">✓</span><span>SOP &amp; Cover Letter Generator</span></li>
          <li class="flex items-start gap-2"><span class="text-[#00a896] font-bold">✓</span><span>Detailed Refusal Risk Audit Report</span></li>
          <li class="flex items-start gap-2"><span class="text-[#00a896] font-bold">✓</span><span>100% Escrow Milestone Protection</span></li>
        </ul>

        <!-- Govt vs Platform Fee Transparency Breakdown (Step 38) -->
        <div class="mt-4 pt-3 border-t border-teal-200/60 text-[11px] text-slate-600 space-y-1">
          <div class="flex justify-between items-center">
            <span>Govt Embassy Fee:</span>
            <span class="font-semibold text-slate-700">Paid direct to Govt</span>
          </div>
          <div class="flex justify-between items-center">
            <span>TravlTik Service Fee:</span>
            <span class="font-semibold text-teal-900">$10 (Included)</span>
          </div>
        </div>
      </div>
      <a href={`/checkout?tier=professional&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
         class="block w-full mt-5 py-2.5 text-center bg-[#00a896] hover:bg-[#028090] text-white rounded-lg text-sm font-semibold transition-colors shadow-sm">
        Select Pro — $10
      </a>
    </div>

    <!-- Tier 3: Concierge / Premium ($15 - 25 queries) -->
    <div class="p-5 rounded-2xl border border-slate-200 bg-white hover:shadow-lg transition-shadow flex flex-col justify-between">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-amber-700">Concierge Pack</div>
        <div class="flex items-baseline gap-1 mt-2">
          <span class="text-3xl font-black text-slate-900">$15</span>
          <span class="text-xs text-slate-500">/ 25 AI Visa Queries</span>
        </div>
        <p class="text-xs text-slate-500 mt-2">Maximum queries &amp; priority consular dossier validation</p>
        <ul class="mt-4 space-y-2 text-xs text-slate-600">
          <li class="flex items-start gap-2"><span class="text-amber-600 font-bold">✓</span><span><strong>25 AI Visa Queries</strong></span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600 font-bold">✓</span><span>Everything in Professional Pack</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600 font-bold">✓</span><span>Consular Form Auto-Fill Guide</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600 font-bold">✓</span><span>VFS Appointment Readiness Checklist</span></li>
        </ul>

        <!-- Govt vs Platform Fee Transparency Breakdown (Step 38) -->
        <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 space-y-1">
          <div class="flex justify-between items-center">
            <span>Govt Embassy Fee:</span>
            <span class="font-semibold text-slate-700">Paid direct to Govt</span>
          </div>
          <div class="flex justify-between items-center">
            <span>TravlTik Service Fee:</span>
            <span class="font-semibold text-slate-900">$15 (Included)</span>
          </div>
        </div>
      </div>
      <a href={`/checkout?tier=concierge&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
         class="block w-full mt-5 py-2.5 text-center border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
        Select Concierge — $15
      </a>
    </div>

  </div>

  <!-- Transparent Fee Summary Card (Step 38) -->
  <div class="mt-6 p-4 rounded-xl bg-white border border-slate-200/90 shadow-2xs text-xs">
    <div class="font-bold text-slate-900 mb-2 flex items-center gap-1.5">
      <span class="text-emerald-600 font-black">ℹ️</span>
      <span>Fee Transparency Breakdown</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 border-t border-slate-100">
      <div>
        <span class="text-slate-500 block text-[11px]">Government Embassy Fee:</span>
        <span class="font-bold text-slate-800 text-xs">Direct to Embassy / VFS</span>
      </div>
      <div>
        <span class="text-slate-500 block text-[11px]">TravlTik Platform Fee:</span>
        <span class="font-bold text-[#00a896] text-xs">$5 / $10 / $15 (Milestone Escrow)</span>
      </div>
      <div>
        <span class="text-slate-500 block text-[11px]">Hidden Charges:</span>
        <span class="font-black text-emerald-700 text-xs">$0.00 — Zero Markup</span>
      </div>
    </div>
  </div>

  <div class="mt-5 flex items-center justify-center gap-4 text-xs text-slate-500 flex-wrap">
    <span class="flex items-center gap-1"><span class="text-emerald-500">🔒</span>Escrow Protected</span>
    <span class="flex items-center gap-1"><span class="text-emerald-500">↩️</span>7-Day Refund</span>
    <span class="flex items-center gap-1"><span class="text-emerald-500">✓</span>No Hidden Fees</span>
  </div>
</div>
