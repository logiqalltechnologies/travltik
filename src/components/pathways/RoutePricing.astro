---
// src/components/pathways/RoutePricing.astro
interface Props {
  country: string;
  purpose: string;
}
const { country, purpose } = Astro.props;
---

<div class="mt-10 relative">
  <!-- Ambient background glow effects -->
  <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-full max-w-4xl h-72 bg-gradient-to-r from-emerald-500/10 via-teal-500/10 to-blue-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <!-- Header Section -->
  <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-xs font-semibold mb-3.5 shadow-xs">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>TRANSPARENT PRICING · NO HIDDEN FEES · ESCROW PROTECTED</span>
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-slate-950 font-sora leading-tight">
      Choose Your <span class="bg-gradient-to-r from-emerald-600 via-teal-600 to-purple-700 bg-clip-text text-transparent">Service Level</span>
    </h2>

    <p class="text-sm sm:text-base text-slate-600 mt-2.5 max-w-xl mx-auto">
      Consular-grade AI dossier checks, verified requirements, and tailored visa roadmaps with complete milestone protection.
    </p>

    {country && (
      <div class="mt-3 inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium border border-slate-200/60">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Destination: <strong class="text-slate-900">{country}</strong> {purpose ? `· ${purpose}` : ''}</span>
      </div>
    )}
  </div>

  <!-- Pricing Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch max-w-6xl mx-auto">

    <!-- Tier 1: Starter Pathway ($5 - 3 queries) -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between p-6 sm:p-7 relative group hover:-translate-y-1">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="inline-block px-3 py-1 bg-slate-100 text-slate-700 text-[11px] font-bold rounded-lg uppercase tracking-wider">
            Starter Pathway
          </span>
          <span class="text-[11px] font-medium text-slate-500">Self-Apply</span>
        </div>

        <div class="flex items-baseline gap-1.5 mt-2 mb-1">
          <span class="text-4xl sm:text-5xl font-black text-slate-950 font-sora tracking-tight">$5</span>
          <span class="text-xs text-slate-500 font-medium">/ 3 AI Visa Queries</span>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 mt-2 mb-5 leading-relaxed">
          Full consular requirements, AI checklist &amp; pathway search for self-submission.
        </p>

        <div class="h-px bg-slate-100 my-4"></div>

        <ul class="space-y-3 text-xs sm:text-sm text-slate-700">
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="font-semibold text-slate-900">3 Full AI Visa Queries</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span>Consular Document Checklist &amp; Pre-audit</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span>Biometric Photo Resizer Tool</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span>Instant Digital Activation</span>
          </li>
        </ul>

        <!-- Govt vs Platform Fee Transparency Box -->
        <div class="mt-6 p-3 rounded-xl bg-slate-50 border border-slate-200/70 text-[11px] text-slate-600 space-y-1.5">
          <div class="flex justify-between items-center">
            <span>Govt Embassy Fee:</span>
            <span class="font-semibold text-slate-800">Paid direct to Govt</span>
          </div>
          <div class="flex justify-between items-center">
            <span>TravlTik Service Fee:</span>
            <span class="font-bold text-slate-950">$5 (Included)</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-2">
        <a href={`/checkout?tier=starter&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
           class="w-full inline-flex items-center justify-center gap-2 py-3 px-5 text-center border border-slate-300 rounded-xl text-sm font-bold text-slate-800 bg-white hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all duration-200 shadow-xs hover:shadow-md">
          <span>Select Starter — $5</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Tier 2: Professional Pack ($10 - Most Popular Centerpiece) -->
    <div class="bg-gradient-to-b from-white via-white to-emerald-50/20 rounded-3xl border-2 border-emerald-500 shadow-xl shadow-emerald-950/10 ring-4 ring-emerald-500/15 flex flex-col justify-between p-6 sm:p-7 relative group md:-translate-y-2 hover:-translate-y-3 transition-all duration-300">
      <!-- Most Popular Ribbon Badge -->
      <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
        <span class="inline-flex items-center gap-1.5 px-4 py-1 bg-gradient-to-r from-emerald-600 to-teal-600 text-white text-[11px] font-extrabold rounded-full uppercase tracking-wider shadow-md">
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          MOST POPULAR · RECOMMENDED
        </span>
      </div>

      <div>
        <div class="flex items-center justify-between mb-3 mt-1">
          <span class="inline-block px-3 py-1 bg-emerald-100/80 text-emerald-900 text-[11px] font-extrabold rounded-lg uppercase tracking-wider">
            Professional Pack
          </span>
          <span class="text-[11px] font-semibold text-emerald-700">Best Value</span>
        </div>

        <div class="flex items-baseline gap-1.5 mt-2 mb-1">
          <span class="text-4xl sm:text-5xl font-black text-slate-950 font-sora tracking-tight">$10</span>
          <span class="text-xs text-slate-600 font-semibold">/ 10 AI Visa Queries</span>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 mt-2 mb-5 leading-relaxed">
          Complete dossier preparation + SOP &amp; Cover Letter builder with risk evaluation.
        </p>

        <div class="h-px bg-emerald-100 my-4"></div>

        <ul class="space-y-3 text-xs sm:text-sm text-slate-800">
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center mt-0.5 shadow-xs">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="font-bold text-slate-950">10 AI Visa Queries (Deep Audit)</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center mt-0.5 shadow-xs">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="font-semibold text-slate-900">SOP &amp; Cover Letter Generator</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center mt-0.5 shadow-xs">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="font-semibold text-slate-900">Detailed Refusal Risk Audit Report</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center mt-0.5 shadow-xs">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="font-semibold text-slate-900">100% Escrow Milestone Protection</span>
          </li>
        </ul>

        <!-- Govt vs Platform Fee Transparency Box -->
        <div class="mt-6 p-3 rounded-xl bg-emerald-50/80 border border-emerald-200/80 text-[11px] text-slate-700 space-y-1.5">
          <div class="flex justify-between items-center">
            <span>Govt Embassy Fee:</span>
            <span class="font-semibold text-slate-800">Paid direct to Govt</span>
          </div>
          <div class="flex justify-between items-center">
            <span>TravlTik Service Fee:</span>
            <span class="font-bold text-emerald-950">$10 (Included)</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-2">
        <a href={`/checkout?tier=professional&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
           class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-5 text-center bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 hover:from-emerald-500 hover:to-teal-500 text-white rounded-xl text-sm font-bold transition-all duration-200 shadow-lg shadow-emerald-600/30 group">
          <span>Select Pro — $10</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Tier 3: Concierge Pack ($15 - 25 queries) -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between p-6 sm:p-7 relative group hover:-translate-y-1">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="inline-block px-3 py-1 bg-amber-50 text-amber-900 border border-amber-200/60 text-[11px] font-bold rounded-lg uppercase tracking-wider">
            Concierge Pack
          </span>
          <span class="text-[11px] font-medium text-amber-700">VIP Priority</span>
        </div>

        <div class="flex items-baseline gap-1.5 mt-2 mb-1">
          <span class="text-4xl sm:text-5xl font-black text-slate-950 font-sora tracking-tight">$15</span>
          <span class="text-xs text-slate-500 font-medium">/ 25 AI Visa Queries</span>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 mt-2 mb-5 leading-relaxed">
          Maximum queries &amp; priority consular dossier validation for complex applications.
        </p>

        <div class="h-px bg-slate-100 my-4"></div>

        <ul class="space-y-3 text-xs sm:text-sm text-slate-700">
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="font-bold text-slate-950">25 AI Visa Queries</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span>Everything in Professional Pack</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span>Consular Form Auto-Fill Guide</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span>VFS Appointment Readiness Checklist</span>
          </li>
        </ul>

        <!-- Govt vs Platform Fee Transparency Box -->
        <div class="mt-6 p-3 rounded-xl bg-slate-50 border border-slate-200/70 text-[11px] text-slate-600 space-y-1.5">
          <div class="flex justify-between items-center">
            <span>Govt Embassy Fee:</span>
            <span class="font-semibold text-slate-800">Paid direct to Govt</span>
          </div>
          <div class="flex justify-between items-center">
            <span>TravlTik Service Fee:</span>
            <span class="font-bold text-slate-950">$15 (Included)</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-2">
        <a href={`/checkout?tier=concierge&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
           class="w-full inline-flex items-center justify-center gap-2 py-3 px-5 text-center border border-slate-300 rounded-xl text-sm font-bold text-slate-800 bg-white hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all duration-200 shadow-xs hover:shadow-md">
          <span>Select Concierge — $15</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

  </div>

  <!-- Transparent Fee Summary Banner -->
  <div class="mt-10 p-5 sm:p-7 rounded-3xl bg-white border border-slate-200/90 shadow-sm max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-100">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-black text-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
