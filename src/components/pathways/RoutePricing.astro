---
// src/components/pathways/RoutePricing.astro
interface Props {
  country: string;
  purpose: string;
}
const { country, purpose } = Astro.props;
---

<div class="mt-8 p-6 rounded-2xl bg-slate-50 border border-slate-200 shadow-sm">
  <div class="mb-5">
    <h3 class="text-lg font-bold text-slate-900">Choose Your Service Level</h3>
    <p class="text-sm text-slate-500 mt-1">
      Transparent pricing. No hidden fees. Escrow protected.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    <!-- Tier 1: Starter ($5 = 3 Queries) -->
    <div class="p-5 rounded-2xl border border-slate-200 bg-white hover:shadow-lg transition-shadow flex flex-col justify-between">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Starter</div>
        <div class="flex items-baseline gap-1 mt-2">
          <span class="text-3xl font-black text-slate-900">$5</span>
          <span class="text-xs text-slate-500">/ 3 queries</span>
        </div>
        <p class="text-xs text-slate-500 mt-2">AI-powered visa guidance</p>
        <ul class="mt-4 space-y-2 text-xs text-slate-600">
          <li class="flex items-start gap-2"><span class="text-emerald-500">✓</span><span>3 AI query credits</span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-500">✓</span><span>AI Document Checklist</span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-500">✓</span><span>Photo Resizer & Spec Checker</span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-500">✓</span><span>Document Vault Access</span></li>
        </ul>
      </div>
      <a href={`/checkout?tier=starter&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
         class="block w-full mt-5 py-2.5 text-center border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
        Get Started — $5
      </a>
    </div>

    <!-- Tier 2: Professional ($29 = 10 Queries + Legal) -->
    <div class="p-5 rounded-2xl border-2 border-blue-500 bg-blue-50/50 relative hover:shadow-xl transition-shadow flex flex-col justify-between">
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-blue-600 text-white text-[10px] font-bold rounded-full uppercase tracking-wider shadow-sm">
        Most Popular
      </span>
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-blue-700">Professional</div>
        <div class="flex items-baseline gap-1 mt-2">
          <span class="text-3xl font-black text-slate-900">$29</span>
          <span class="text-xs text-slate-500">/ 10 queries + Legal</span>
        </div>
        <p class="text-xs text-slate-600 mt-2">AI + Licensed consultant review</p>
        <ul class="mt-4 space-y-2 text-xs text-slate-700">
          <li class="flex items-start gap-2"><span class="text-blue-600">✓</span><span>10 AI query credits</span></li>
          <li class="flex items-start gap-2"><span class="text-blue-600">✓</span><span>Everything in Starter</span></li>
          <li class="flex items-start gap-2"><span class="text-blue-600">✓</span><span>MARA / RCIC Consultant Check</span></li>
          <li class="flex items-start gap-2"><span class="text-blue-600">✓</span><span>Document Vetting & Sign-off</span></li>
          <li class="flex items-start gap-2"><span class="text-blue-600">✓</span><span>Escrow Protection</span></li>
        </ul>
      </div>
      <a href={`/checkout?tier=professional&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
         class="block w-full mt-5 py-2.5 text-center bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition-colors shadow-sm">
        Select Professional — $29
      </a>
    </div>

    <!-- Tier 3: Concierge ($199 = Unlimited + Priority) -->
    <div class="p-5 rounded-2xl border border-slate-200 bg-white hover:shadow-lg transition-shadow flex flex-col justify-between">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-amber-700">Concierge</div>
        <div class="flex items-baseline gap-1 mt-2">
          <span class="text-3xl font-black text-slate-900">$199</span>
          <span class="text-xs text-slate-500">/ Unlimited + Priority</span>
        </div>
        <p class="text-xs text-slate-500 mt-2">End-to-end filing with priority escrow</p>
        <ul class="mt-4 space-y-2 text-xs text-slate-600">
          <li class="flex items-start gap-2"><span class="text-amber-600">✓</span><span>Unlimited AI queries</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600">✓</span><span>Everything in Professional</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600">✓</span><span>VFS Appointment Booking</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600">✓</span><span>Priority Escrow Release</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-600">✓</span><span>Dedicated Account Manager</span></li>
        </ul>
      </div>
      <a href={`/checkout?tier=concierge&country=${encodeURIComponent(country || '')}&purpose=${encodeURIComponent(purpose || '')}`}
         class="block w-full mt-5 py-2.5 text-center border border-slate-300 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
        Select Concierge — $199
      </a>
    </div>

  </div>

  <div class="mt-5 flex items-center justify-center gap-4 text-xs text-slate-500 flex-wrap">
    <span class="flex items-center gap-1"><span class="text-emerald-500">🔒</span>Escrow Protected</span>
    <span class="flex items-center gap-1"><span class="text-emerald-500">↩️</span>7-Day Refund</span>
    <span class="flex items-center gap-1"><span class="text-emerald-500">✓</span>No Hidden Fees</span>
  </div>
</div>
