---
// src/components/layout/MobileNav.astro
import { MAIN_NAV } from '../../../config/navigation';
import { Home, Compass, Sparkles, Users, Briefcase, ShieldCheck } from 'lucide-react';

const pathname = Astro.url.pathname;

const ICON_MAP: Record<string, any> = {
  "/ai-tools": Sparkles,
  "/find-experts": Users,
  "/jobs": Briefcase,
  "/escrow": ShieldCheck,
  "/self-apply": Compass,
};

const mobileNavItems = [
  { href: "/", label: "Home", icon: Home },
  ...MAIN_NAV.filter((item) => ["/ai-tools", "/find-experts", "/jobs", "/escrow"].includes(item.href)).map((item) => ({
    href: item.href,
    label: item.label,
    icon: ICON_MAP[item.href] || Compass,
  })),
];
---

<nav id="mobile-bottom-nav" aria-label="Bottom Mobile Navigation" class="md:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center bg-white/95 backdrop-blur-md h-14 border-t border-slate-200/80 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] px-2 transition-transform duration-300 ease-in-out">
  {mobileNavItems.map((item) => {
    // Exact or prefix matching
    const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
    const Icon = item.icon;
    return (
      <a
        href={item.href}
        class={`flex flex-col items-center justify-center flex-1 py-1 transition-all duration-150 rounded-xl ${
          isActive ? "text-[#00a896] font-bold" : "text-slate-500 hover:text-slate-900 font-medium"
        }`}
      >
        <div class={`relative p-1 rounded-xl transition-colors ${isActive ? "bg-teal-50" : ""}`}>
          <Icon class={`w-5 h-5 transition-transform ${isActive ? "scale-105 stroke-[2.2]" : "stroke-[1.8]"}`} />
        </div>
        <span class="text-[10px] tracking-tight mt-0.5">{item.label}</span>
      </a>
    );
  })}
</nav>

<script is:inline>
  (() => {
    let lastScrollY = window.scrollY;
    const nav = document.getElementById('mobile-bottom-nav');
    if (!nav) return;

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      if (currentScrollY > lastScrollY && currentScrollY > 60) {
        // Scrolled down
        nav.style.transform = 'translateY(100%)';
      } else {
        // Scrolled up
        nav.style.transform = 'translateY(0)';
      }
      lastScrollY = currentScrollY;
    }, { passive: true });
  })();
</script>

