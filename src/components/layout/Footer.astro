---
// src/components/layout/Footer.astro
// Unified Executive Landing-Style Footer across all pages
---

<footer class="bg-gradient-to-b from-[#f7f2fe] via-[#f7f2fe] to-[#eee3fc] pt-16 sm:pt-20 pb-10 px-4 sm:px-8 rounded-t-[40px] md:rounded-t-[48px] border-t border-[#dccaf7]/60 text-slate-800 relative z-10 selection:bg-[#00a878]/20 selection:text-[#00a878]">
  <div class="max-w-7xl mx-auto">
    <!-- Main 5-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12">
      
      <!-- Brand & Newsletter Column (Span 4) -->
      <div class="lg:col-span-4 space-y-5">
        <a href="/" class="inline-block">
          <img src="/logo.png" alt="TravlTik" class="h-10 sm:h-11 w-auto" />
        </a>
        <p class="text-[14px] sm:text-[15px] text-[#675f80] leading-relaxed max-w-sm">
          The global marketplace for visas, jobs, study and relocation, with licensed experts and escrow-protected payments.
        </p>

        <!-- Newsletter Subscription Form -->
        <form id="global-nl-form" class="flex items-center bg-white rounded-full p-1.5 border border-[#dccaf7] focus-within:border-brand focus-within:ring-2 focus-within:ring-brand/20 shadow-sm max-w-sm transition-all"" onsubmit="return false;">
          <input 
            id="global-nl-email" 
            type="email" 
            required 
            placeholder="Your email for visa news" 
            class="flex-1 bg-transparent px-4 text-sm text-slate-800 placeholder-[#7e749a] outline-none min-w-0"
          />
          <button 
            type="submit" 
            id="global-nl-btn" 
            class="bg-gradient-to-r from-[#00c985] to-[#00b070] hover:from-[#00b070] hover:to-[#008f5a] text-white text-xs sm:text-sm font-bold px-5 py-2.5 rounded-full shadow-md shadow-[#00b070]/25 transition-all duration-200 shrink-0 cursor-pointer"
          >
            Subscribe
          </button>
        </form>

        <!-- Social Icons Row -->
        <div class="flex items-center gap-2.5 pt-1">
          <a href="https://facebook.com/travltik" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 rounded-full bg-white text-[#430f7a] hover:bg-[#00b070] hover:text-white flex items-center justify-center border border-[#dccaf7] shadow-2xs hover:-translate-y-0.5 transition-all duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
            </svg>
          </a>
          <a href="https://twitter.com/travltik" target="_blank" rel="noopener noreferrer" aria-label="X" class="w-10 h-10 rounded-full bg-white text-[#430f7a] hover:bg-[#00b070] hover:text-white flex items-center justify-center border border-[#dccaf7] shadow-2xs hover:-translate-y-0.5 transition-all duration-200">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M4 4l16 16M20 4 4 20" />
            </svg>
          </a>
          <a href="https://instagram.com/travltik" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 rounded-full bg-white text-[#430f7a] hover:bg-[#00b070] hover:text-white flex items-center justify-center border border-[#dccaf7] shadow-2xs hover:-translate-y-0.5 transition-all duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a href="https://linkedin.com/company/travltik" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-10 h-10 rounded-full bg-white text-[#430f7a] hover:bg-[#00b070] hover:text-white flex items-center justify-center border border-[#dccaf7] shadow-2xs hover:-translate-y-0.5 transition-all duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect x="2" y="9" width="4" height="12" />
              <circle cx="4" cy="4" r="2" />
            </svg>
          </a>
          <a href="https://youtube.com/@travltik" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-10 h-10 rounded-full bg-white text-[#430f7a] hover:bg-[#00b070] hover:text-white flex items-center justify-center border border-[#dccaf7] shadow-2xs hover:-translate-y-0.5 transition-all duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" />
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Services (Span 2) -->
      <div class="lg:col-span-2">
        <h5 class="font-sora text-[#430f7a] text-sm font-extrabold mb-4 tracking-tight">Services</h5>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href="/find-experts" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Visas &amp; PR</a></li>
          <li><a href="/find-experts?category=student" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Study abroad</a></li>
          <li><a href="/jobs" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Jobs abroad</a></li>
          <li><a href="/tours" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Tours &amp; packages</a></li>
          <li><a href="/find-experts" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Housing</a></li>
        </ul>
      </div>

      <!-- Column 3: Explore (Span 2) -->
      <div class="lg:col-span-2">
        <h5 class="font-sora text-[#430f7a] text-sm font-extrabold mb-4 tracking-tight">Explore</h5>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href="/find-experts" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Find consultants</a></li>
          <li><a href="/planner" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">AI Trip Planner</a></li>
          <li><a href="/community" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Community chat</a></li>
          <li><a href="/#destinations" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Destinations</a></li>
          <li><a href="/visa-guide" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Blog &amp; guides</a></li>
        </ul>
      </div>

      <!-- Column 4: Company (Span 2) — with Add Your Business & Claim Your Business -->
      <div class="lg:col-span-2">
        <h5 class="font-sora text-[#430f7a] text-sm font-extrabold mb-4 tracking-tight">Company</h5>
        <ul class="space-y-2.5 text-[14px]">
          <li><a href="/about" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">About TravlTik</a></li>
          <li><a href="/channel-partner" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Become a consultant</a></li>
          <li>
            <a href="/add-business" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-flex items-center gap-1.5 font-semibold transition-all duration-150">
              <span class="text-xs text-[#00b070] font-black">›</span> Add Your Business
            </a>
          </li>
          <li>
            <a href="/biz/claim" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-flex items-center gap-1.5 font-semibold transition-all duration-150">
              <span class="text-xs text-[#00b070] font-black">›</span> Claim Your Business
            </a>
          </li>
          <li><a href="/escrow" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Escrow Protection</a></li>
          <li><a href="/privacy" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Privacy Policy</a></li>
          <li><a href="/support" class="text-[#4b4268] hover:text-[#00b070] hover:translate-x-1 inline-block transition-all duration-150">Contact &amp; Support</a></li>
        </ul>
      </div>

      <!-- Column 5: Get the app (Span 2) -->
      <div class="lg:col-span-2">
        <h5 class="font-sora text-[#430f7a] text-sm font-extrabold mb-4 tracking-tight">Get the app</h5>
        <div class="flex flex-col gap-2.5 max-w-[200px]">
          <div class="group relative inline-block">
            <div class="app-btn relative overflow-hidden flex items-center gap-3 px-4 py-2.5 bg-white border border-[#dccaf7] group-hover:border-[#00b070] group-hover:shadow-[0_4px_14px_rgba(0,176,112,0.15)] rounded-xl text-[#430f7a] transition-all duration-200 cursor-pointer select-none">
              <div class="flex items-center gap-3 transition-all duration-200 group-hover:opacity-0 group-hover:-translate-y-1">
                <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M16.500 12.500c0-2.500 2-3.500 2-3.500-1.100-1.600-2.800-1.800-3.400-1.800-1.400-.1-2.800.8-3.500.8s-1.800-.8-3-.8C6.700 7.300 4.500 9 4.500 12.600c0 3.600 2.500 8.200 4.500 8.200 1 0 1.600-.7 3-.7s1.900.7 3 .7c2 0 3.700-3.300 4-4.300-1.800-.8-2.500-2.200-2.500-4zM14.500 5.500c.7-.8 1-1.900.9-3-1 .1-2.100.7-2.800 1.500-.6.700-1 1.800-.9 2.800 1 .1 2.100-.5 2.800-1.300z" />
                </svg>
                <div class="text-left">
                  <small class="block text-[10px] text-[#675f80] font-medium leading-none mb-0.5">Download on the</small>
                  <b class="block text-[13px] font-bold font-sora leading-tight">App Store</b>
                </div>
              </div>
              <div class="absolute inset-0 flex items-center justify-center gap-1.5 opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200 text-[#00b070] font-extrabold text-xs">
                <span class="w-2 h-2 rounded-full bg-[#00b070]"></span>
                <span>Coming Soon</span>
              </div>
            </div>
          </div>

          <div class="group relative inline-block">
            <div class="app-btn relative overflow-hidden flex items-center gap-3 px-4 py-2.5 bg-white border border-[#dccaf7] group-hover:border-[#00b070] group-hover:shadow-[0_4px_14px_rgba(0,176,112,0.15)] rounded-xl text-[#430f7a] transition-all duration-200 cursor-pointer select-none">
              <div class="flex items-center gap-3 transition-all duration-200 group-hover:opacity-0 group-hover:-translate-y-1">
                <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M5 3.5v17l15-8.5z" />
                </svg>
                <div class="text-left">
                  <small class="block text-[10px] text-[#675f80] font-medium leading-none mb-0.5">Get it on</small>
                  <b class="block text-[13px] font-bold font-sora leading-tight">Google Play</b>
                </div>
              </div>
              <div class="absolute inset-0 flex items-center justify-center gap-1.5 opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200 text-[#00b070] font-extrabold text-xs">
                <span class="w-2 h-2 rounded-full bg-[#00b070]"></span>
                <span>Coming Soon</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Security Strip -->
    <div class="pt-6 border-t border-[#dccaf7]/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#675f80] font-medium">
      <div class="text-center md:text-left">
        <span>© 2026 TravlTik. All rights reserved. </span>
        <a href="/terms" class="underline hover:text-[#00b070] transition-colors ml-1">Terms</a> · 
        <a href="/privacy" class="underline hover:text-[#00b070] transition-colors mx-1">Privacy</a> · 
        <a href="/escrow" class="underline hover:text-[#00b070] transition-colors ml-1">Escrow policy</a>
      </div>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 bg-white px-3.5 py-1.5 rounded-full font-bold text-[#430f7a] text-xs shadow-2xs border border-[#dccaf7]/60">
          <svg class="w-3.5 h-3.5 text-[#00b070]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="10" width="16" height="11" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
          </svg>
          Escrow secured
        </span>

        <span class="inline-flex items-center gap-1.5 bg-white px-3.5 py-1.5 rounded-full font-bold text-[#430f7a] text-xs shadow-2xs border border-[#dccaf7]/60">
          <svg class="w-3.5 h-3.5 text-[#00b070]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          Licence verified
        </span>
      </div>
    </div>

    <!-- Statutory Regulatory Disclosure (Clean, Compact & Collapsible) -->
    <div class="mt-6 pt-4 border-t border-[#dccaf7]/40 text-center">
      <p class="text-[11px] text-[#7e749a] max-w-4xl mx-auto leading-relaxed">
        <strong>Statutory Regulatory Disclosure:</strong> TravlTik is an independent private mobility marketplace and technology platform, not an embassy, consular post, or government authority. Final visa adjudication rests exclusively with destination sovereign authorities. All client payments are protected in milestone escrow.
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  // Newsletter Form & App Buttons on all pages
  (function() {
    // Newsletter form handler
    const nlForm = document.getElementById('global-nl-form');
    if (nlForm) {
      nlForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const btn = document.getElementById('global-nl-btn');
        const inp = document.getElementById('global-nl-email');
        if (inp && inp.value) {
          btn.textContent = 'Subscribed! ✓';
          btn.style.background = '#008f5a';
          inp.value = '';
          setTimeout(() => {
            btn.textContent = 'Subscribe';
            btn.style.background = '';
          }, 3500);
        }
      });
    }
  })();
</script>

