---
// src/components/layout/Header.astro
import { TripPlannerModal } from '../interactive/TripPlannerModal';
import { MAIN_NAV, FOOTER_NAV } from '../../../config/navigation';
import { Search, MapPin, Menu, X, Globe, ChevronDown, GraduationCap, Briefcase, Compass, Scale, FileText, Calendar, PenLine, HeartHandshake, Plane, DollarSign, LogOut, LayoutDashboard, MessageSquare, Sparkles, Bell, Zap, Award, Camera, FileCheck2, ShieldCheck, Users } from 'lucide-react';
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';

const ICONS: Record<string, any> = {
    GraduationCap,
    Briefcase,
    Compass,
    Scale,
    Sparkles,
    Camera,
    FileCheck2,
    FileText,
    Calendar,
    HeartHandshake,
    Plane,
    Award,
};
---

<!-- Top Utility Bar (Scrolls away naturally with the page) -->
<div id="top-utility-bar" class="w-full bg-linear-to-r from-[#F4E8F9] via-[#FAF5FC] to-[#E9FBF0] border-b border-slate-200/80 text-xs sm:text-[13px] font-semibold text-[#430f7a] overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 lg:px-8 h-10 flex items-center justify-between whitespace-nowrap">
    
    <!-- LEFT: Contact Info (Phone + Email) -->
    <div class="flex items-center gap-4 sm:gap-6">
      <a href="tel:+917661989366" class="flex items-center gap-1.5 text-[#430f7a] hover:text-[#00b070] transition-colors">
        <span class="text-sm">📞</span>
        <span>+91 766 1989 366</span>
      </a>
      <a href="mailto:hello@travltik.com" class="hidden sm:flex items-center gap-1.5 text-[#430f7a] hover:text-[#00b070] transition-colors">
        <span class="text-sm">✉️</span>
        <span>hello@travltik.com</span>
      </a>
    </div>

    <!-- CENTER: Escrow Protection Text -->
    <a href="/escrow" class="hidden md:inline-flex items-center gap-2 bg-white px-3.5 py-1 rounded-full shadow-2xs text-[#430f7a] hover:text-[#00b070] transition-colors text-xs font-semibold">
      <span>🔒</span>
      <span>Every payment protected by milestone escrow</span>
    </a>

    <!-- RIGHT: Language / Currency -->
    <div class="flex items-center gap-1.5 text-[#430f7a] hover:text-[#00b070] cursor-pointer transition-colors">
      <span>🌐</span>
      <span>English · INR</span>
    </div>

  </div>
</div>

<header id="main-header" class="sticky top-0 left-0 w-full z-50 transition-all duration-300 border-b border-slate-200/80 shadow-xs" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4); border-bottom: 1px solid rgba(0, 0, 0, 0.08);">
    <div class="max-w-[1440px] mx-auto px-4 lg:px-8 relative flex items-center justify-between gap-6 xl:gap-8 h-[82px]">
        
        <!-- 1. LEFT: Logo -->
        <div class="flex items-center shrink-0 py-1 pointer-events-auto">
            <a href="/" class="flex items-center gap-2 focus:outline-none" aria-label="TravlTik Home">
                <img id="header-logo-img" src="/logo.png?v=8" class="h-9 sm:h-10 lg:h-[44px] max-h-[46px] w-auto max-w-[140px] sm:max-w-[170px] lg:max-w-none object-contain transition-all duration-200" alt="TravlTik Logo" />
            </a>
        </div>

        <!-- 2. CENTER: Navigation Links (Locked in center with flex-1 justify-center) -->
        <nav aria-label="Main navigation" class="hidden lg:flex items-center flex-1 justify-center gap-6 xl:gap-8 font-plus-jakarta">
            {MAIN_NAV.map((item) => (
                item.children && item.children.length > 0 ? (
                    <div class="relative py-3 group">
                        <button class="font-plus-jakarta text-[14px] xl:text-[15px] font-semibold text-slate-700 hover:text-[#00a896] whitespace-nowrap transition-colors flex items-center gap-1 focus:outline-none cursor-pointer">
                            {item.label}
                            <ChevronDown class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#00a896] transition-all duration-200 group-hover:rotate-180" />
                        </button>
                        <div class="absolute top-full left-0 pt-2 w-[280px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top-left z-50">
                            <div class="bg-white rounded-2xl border border-slate-100 shadow-xl p-3 flex flex-col gap-1 text-slate-800">
                                {item.children.map((child, cIdx) => {
                                    const IconComponent = child.icon ? ICONS[child.icon] : null;
                                    const isAiTools = item.label === "AI Tools";
                                    const showDivider = isAiTools && cIdx === 4;
                                    const iconColor = child.href === "/ai-tools" ? "text-amber-500" :
                                                     child.href === "/ai-tools/photo-resizer" ? "text-emerald-600" :
                                                     child.href === "/ai-tools/pdf-audit" ? "text-[#00a896]" :
                                                     child.href === "/ai-tools/sop-generator" ? "text-blue-600" :
                                                     "text-slate-400";
                                    return (
                                        <>
                                            {showDivider && <div class="my-1 border-t border-slate-100" />}
                                            <a href={child.href} class="flex items-center gap-2.5 py-2 px-3 rounded-xl hover:bg-slate-50 text-slate-700 hover:text-emerald-600 transition-all duration-150 group/item">
                                                {IconComponent && <IconComponent class={`w-4 h-4 ${iconColor} group-hover/item:text-emerald-600 transition-colors shrink-0`} />}
                                                <span class={`${isAiTools && cIdx >= 4 ? "text-[13px]" : "text-[14px]"} font-medium`}>{child.label}</span>
                                            </a>
                                        </>
                                    );
                                })}
                            </div>
                        </div>
                    </div>
                ) : (
                    <div class="py-3">
                        <a href={item.href} class="font-plus-jakarta text-[14px] xl:text-[15px] font-semibold text-slate-700 hover:text-[#00a896] whitespace-nowrap transition-colors flex items-center gap-1 focus:outline-none cursor-pointer">
                            {item.label}
                        </a>
                    </div>
                )
            ))}
        </nav>

        <!-- 3. RIGHT: Auth & CTA Buttons (Desktop) -->
        <div class="hidden lg:flex items-center gap-2 xl:gap-3 shrink-0 z-50 font-plus-jakarta">
            <!-- Contact Link -->
            <a href="/support" id="contact-btn" class="text-[14px] font-bold text-[#4b4268] hover:text-[#00a896] transition-colors px-3 py-2">
                Contact
            </a>

            <!-- Subtle Divider (shown only when logged in) -->
            <div id="nav-logged-in-divider" class="w-px h-5 shrink-0 mx-1.5 hidden bg-slate-200"></div>

            <!-- Auth Buttons Wrapper -->
            <div class="flex items-center gap-2" id="nav-auth-buttons-wrapper">
                <a href="/login" id="login-btn" class="text-[14.5px] font-bold text-[#430f7a] hover:text-[#00a896] transition-colors px-3 py-2 whitespace-nowrap cursor-pointer">
                    Log in
                </a>
                <a href="/signup" id="signup-btn" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#00b070] hover:bg-[#009282] text-white text-[14px] font-bold transition-all shadow-md shadow-emerald-500/25 active:scale-95 whitespace-nowrap">
                    <span>Get started</span>
                    <span class="text-base leading-none">→</span>
                </a>
            </div>

            <!-- Desktop Profile Dropdown (hydrated dynamically on client) -->
            <div id="nav-profile-block" class="relative hidden py-2 group font-plus-jakarta" aria-hidden="true">
                <button id="nav-profile-trigger" class="flex items-center gap-2.5 pl-1.5 pr-3.5 py-1.5 border rounded-full transition-all focus:outline-none shadow-2xs bg-slate-50 hover:bg-slate-100 text-slate-900 border-slate-200">
                    <div class="w-8 h-8 rounded-full overflow-hidden flex items-center justify-center bg-[#00a896] text-white shadow-2xs shrink-0 border border-[#00a896]/30" id="nav-profile-avatar-container">
                        <img id="nav-profile-avatar-img" class="w-full h-full object-cover hidden" src="" alt="avatar" />
                        <span class="font-bold text-xs" id="nav-profile-avatar-letters"></span>
                    </div>
                    <span id="nav-profile-pill-name" class="font-medium text-xs max-w-[110px] truncate"></span>
                    <ChevronDown class="w-3.5 h-3.5 shrink-0 text-slate-400" />
                </button>
                
                <!-- Dropdown Menu -->
                <div class="absolute right-0 top-[90%] pt-4 w-[220px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top-right z-50">
                    <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-2.5 flex flex-col gap-1.5">
                        <div class="px-3.5 py-2 border-b border-slate-100">
                            <div class="text-[10px] text-slate-400 font-bold tracking-wider">Signed in as</div>
                            <div class="text-sm font-bold text-black truncate mt-0.5" id="nav-profile-name"></div>
                        </div>
                        <a id="nav-profile-dashboard-link" href="/traveller/dashboard" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[14px] font-semibold text-slate-700 hover:text-[#00a896] hover:bg-[#00a896]/5 transition-all group/item">
                            <LayoutDashboard class="w-4 h-4 text-slate-400 group-hover/item:text-[#00a896] transition-colors" />
                            <span>My Dashboard</span>
                        </a>
                        <button id="nav-profile-logout-btn" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[14px] font-semibold text-slate-700 hover:text-rose-600 hover:bg-rose-50 transition-all w-full text-left cursor-pointer border-none bg-transparent group/item">
                            <LogOut class="w-4 h-4 text-slate-400 group-hover/item:text-rose-600 transition-colors" />
                            <span>Log Out</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Mobile Actions (Sign Up + Hamburger Menu Button on RIGHT) -->
        <div class="flex items-center gap-2 lg:hidden z-50 shrink-0">
            <a href="/signup" id="mobile-top-signup-btn" class="px-4 py-1.5 sm:py-2 rounded-full bg-[#00b070] hover:bg-[#009282] text-white text-xs sm:text-sm font-bold transition-all shadow-md shadow-emerald-500/25 active:scale-95 inline-flex items-center justify-center whitespace-nowrap">
                Get started
            </a>
            <a href="/traveller/dashboard" id="mobile-top-profile-btn" class="hidden items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[#00a896]/30 bg-[#00a896] text-white hover:scale-105 transition-all overflow-hidden shrink-0 shadow-sm" aria-hidden="true">
                <img id="mobile-top-profile-avatar-img" class="w-full h-full object-cover hidden" src="" alt="avatar" />
                <span class="font-black text-xs sm:text-sm text-white bg-[#00a896] w-full h-full flex items-center justify-center" id="mobile-top-profile-avatar-letters"></span>
            </a>
            <button id="mobile-menu-btn" class="w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 text-[#430f7a] transition-colors flex items-center justify-center focus:outline-none shrink-0" aria-label="Toggle Menu">
                <span id="menu-icon" class="block">
                    <Menu class="w-5 h-5 stroke-[2]" />
                </span>
                <span id="close-icon" class="hidden">
                    <X class="w-5 h-5 stroke-[2]" />
                </span>
            </button>
        </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu-drawer" aria-label="Mobile navigation" aria-hidden="true" class="hidden lg:hidden w-full bg-white border-t border-gray-100 shadow-lg max-h-[calc(100vh-64px)] overflow-y-auto z-40 transition-all duration-300">
        <div class="flex flex-col py-4 px-4 gap-1">
            {MAIN_NAV.map((item, idx) => (
                item.children && item.children.length > 0 ? (
                    <div class="border-b border-gray-50 py-1.5">
                        <button class="mobile-nav-accordion-btn w-full flex items-center justify-between py-2 text-sm font-semibold text-navy hover:bg-gray-50 rounded-lg cursor-pointer" data-target={`mobile-drawer-${idx}`}>
                            <span>{item.label}</span>
                            <ChevronDown class="mobile-nav-arrow w-4 h-4 text-gray-400 transition-transform duration-300" />
                        </button>
                        <div id={`mobile-drawer-${idx}`} class="hidden pl-4 py-1 flex flex-col gap-1.5 bg-slate-50/50 rounded-lg">
                            {item.children.map((child) => (
                                <a href={child.href} class="block py-1.5 text-xs text-slate-600 font-medium hover:text-[#00a896] transition-colors">{child.label}</a>
                            ))}
                        </div>
                    </div>
                ) : (
                    <div class="border-b border-gray-50 py-2.5">
                        <a href={item.href} class="block py-1 text-sm font-semibold text-navy hover:text-[#00a896] transition-colors">
                            {item.label}
                        </a>
                    </div>
                )
            ))}

            <!-- Mobile Contact Link -->
            <div class="border-b border-gray-50 py-2.5">
                <a href="/support" class="flex items-center gap-2 text-sm font-semibold text-navy hover:text-[#00a896] transition-colors">
                    <MessageSquare class="w-4.5 h-4.5 text-slate-500" />
                    <span>Contact</span>
                </a>
            </div>

            <!-- Mobile Legal Policies & Compliance -->
            <div class="border-b border-gray-50 py-2.5">
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Legal Policies & Compliance</div>
                <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-600">
                    {FOOTER_NAV.map((footerItem) => (
                        <a href={footerItem.href} class="hover:text-[#00a896] transition-colors">{footerItem.label}</a>
                    ))}
                </div>
            </div>

            <!-- Mobile Portal Auth Actions -->
            <div id="mobile-nav-auth-buttons" class="py-4 flex items-center gap-3 border-t border-slate-100">
                <a href="/login" class="flex-1 text-center py-2.5 border border-slate-300 hover:border-slate-800 text-slate-800 font-bold text-sm rounded-full transition-colors">
                    Log in
                </a>
                <a href="/signup" class="flex-1 text-center py-2.5 bg-[#00b070] hover:bg-[#009282] text-white font-bold text-sm rounded-full transition-all shadow-md shadow-emerald-500/25">
                    Get started
                </a>
            </div>
            <!-- Mobile Profile Actions (Hydrated dynamically on client) -->
            <div id="mobile-nav-profile-block" class="hidden py-4 border-t border-slate-200/60 flex flex-col gap-2 font-sans" aria-hidden="true">
                <div class="px-2 py-1 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full overflow-hidden flex items-center justify-center bg-[#00a896] text-white shadow-2xs shrink-0 border border-[#00a896]/30">
                        <img id="mobile-drawer-avatar-img" class="w-full h-full object-cover hidden" src="" alt="avatar" />
                        <span class="font-bold text-sm" id="mobile-drawer-avatar-letters"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="text-[10px] text-slate-400 font-bold tracking-wider">Signed in as</div>
                        <div class="text-sm font-extrabold text-black truncate mt-0.5" id="mobile-nav-profile-name"></div>
                    </div>
                </div>
                <a id="mobile-nav-profile-dashboard-link" href="/traveller/dashboard" class="block text-center py-2.5 bg-[#00a896] hover:bg-[#009282] active:bg-[#007f71] text-white font-bold text-sm rounded-xl shadow-md transition-colors">
                    My Dashboard
                </a>
                <button id="mobile-nav-profile-logout-btn" class="block text-center py-2.5 border border-slate-200 text-red-600 font-bold text-sm rounded-xl hover:bg-red-50 transition-colors w-full cursor-pointer bg-white">
                    Log Out
                </button>
            </div>
        </div>
    </div>
    <!-- Trip Planner Modal -->
    <TripPlannerModal client:load />
</header>

<script>
    // Toggle Mobile Drawer Menu & Sync Header Background
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    const headerElement = document.getElementById("main-header");
    const logoImgElement = document.getElementById("header-logo-img");

    if (mobileMenuBtn && mobileMenuDrawer && menuIcon && closeIcon) {
        mobileMenuBtn.addEventListener('click', () => {
            const isOpen = !mobileMenuDrawer.classList.contains('hidden');
            if (isOpen) {
                // Closing Drawer
                mobileMenuDrawer.classList.add('hidden');
                menuIcon.classList.remove('hidden');
                menuIcon.classList.add('block');
                closeIcon.classList.add('hidden');
                closeIcon.classList.remove('block');
            } else {
                // Opening Drawer
                mobileMenuDrawer.classList.remove('hidden');
                menuIcon.classList.add('hidden');
                menuIcon.classList.remove('block');
                closeIcon.classList.remove('hidden');
                closeIcon.classList.add('block');
            }
        });
    }

    // Toggle Mobile Accordions
    document.querySelectorAll('.mobile-nav-accordion-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-target');
            const drawerEl = targetId ? document.getElementById(targetId) : null;
            const arrowEl = btn.querySelector('.mobile-nav-arrow');
            if (drawerEl) {
                const isHidden = drawerEl.classList.contains('hidden');
                if (isHidden) {
                    drawerEl.classList.remove('hidden');
                    if (arrowEl) arrowEl.classList.add('rotate-180');
                } else {
                    drawerEl.classList.add('hidden');
                    if (arrowEl) arrowEl.classList.remove('rotate-180');
                }
            }
        });
    });
    // Dynamic Auth Header Button & Profile Dropdown Updates
    function syncAuthHeader() {
        const seekerFirst = localStorage.getItem("seeker_firstName");
        const expertBusiness = localStorage.getItem("expert_businessName");
        const userStr = (localStorage.getItem("travltik_user")) || localStorage.getItem("travltik_user");

        const isLoggedIn = Boolean(seekerFirst || expertBusiness || (userStr && userStr !== "null" && userStr !== "undefined"));

        const desktopAuthButtons = document.getElementById("nav-auth-buttons-wrapper");
        const mobileAuthButtons = document.getElementById("mobile-nav-auth-buttons");
        const loggedInDivider = document.getElementById("nav-logged-in-divider");
        const mobileTopSignupBtn = document.getElementById("mobile-top-signup-btn");
        const desktopProfileBlock = document.getElementById("nav-profile-block");
        const mobileTopProfileBtn = document.getElementById("mobile-top-profile-btn");
        const mobileProfileBlock = document.getElementById("mobile-nav-profile-block");

        if (isLoggedIn) {
            // Hide standard Auth buttons
            if (desktopAuthButtons) {
                desktopAuthButtons.classList.add("hidden");
                desktopAuthButtons.style.display = "none";
            }
            if (mobileAuthButtons) {
                mobileAuthButtons.classList.add("hidden");
                mobileAuthButtons.style.display = "none";
            }
            if (loggedInDivider) {
                loggedInDivider.classList.remove("hidden");
                loggedInDivider.style.display = "block";
            }
            if (mobileTopSignupBtn) {
                mobileTopSignupBtn.classList.add("hidden");
                mobileTopSignupBtn.style.display = "none";
            }

            // Prepare info
            let displayName = "User Profile";
            let displayLetters = "U";
            let dashboardHref = "/traveller/dashboard";
            let displayPhoto = "";

            if (expertBusiness) {
                displayName = expertBusiness;
                displayLetters = expertBusiness.charAt(0).toUpperCase();
                dashboardHref = "/service-provider/dashboard";
                displayPhoto = localStorage.getItem("expert_profilePhoto") || "";
            } else if (seekerFirst) {
                displayName = seekerFirst + " " + (localStorage.getItem("seeker_lastName") || "");
                displayLetters = seekerFirst.charAt(0).toUpperCase();
                dashboardHref = "/traveller/dashboard";
                displayPhoto = localStorage.getItem("seeker_profilePhoto") || "";
            } else if (userStr) {
                try {
                    const u = JSON.parse(userStr);
                    if (u && u.displayName) {
                        displayName = u.displayName;
                        displayLetters = u.displayName.charAt(0).toUpperCase();
                    } else if (u && u.email) {
                        displayName = u.email;
                        displayLetters = u.email.charAt(0).toUpperCase();
                    }
                    if (u && u.photoURL) {
                        displayPhoto = u.photoURL;
                    }
                    if (u && u.type === "expert") {
                        dashboardHref = "/service-provider/dashboard";
                    } else {
                        dashboardHref = "/traveller/dashboard";
                    }
                } catch(e) {}
            }

            // Show Desktop Profile Block
            if (desktopProfileBlock) {
                desktopProfileBlock.classList.remove("hidden");
                desktopProfileBlock.style.display = "block";
                const avatarLetters = document.getElementById("nav-profile-avatar-letters");
                const avatarImg = document.getElementById("nav-profile-avatar-img");
                const profileName = document.getElementById("nav-profile-name");
                const pillName = document.getElementById("nav-profile-pill-name");
                const dashboardLink = document.getElementById("nav-profile-dashboard-link");

                if (profileName) profileName.textContent = displayName;
                if (pillName) pillName.textContent = displayName.split(" ")[0];
                if (dashboardLink) dashboardLink.setAttribute("href", dashboardHref);
                
                if (displayPhoto && avatarImg) {
                    avatarImg.setAttribute("src", displayPhoto);
                    avatarImg.classList.remove("hidden");
                    if (avatarLetters) avatarLetters.classList.add("hidden");
                } else {
                    if (avatarLetters) avatarLetters.textContent = displayLetters;
                    if (avatarLetters) avatarLetters.classList.remove("hidden");
                    if (avatarImg) avatarImg.classList.add("hidden");
                }
            }

            // Show Mobile Top Header Profile Icon Button (Next to Hamburger)
            if (mobileTopProfileBtn) {
                mobileTopProfileBtn.classList.remove("hidden");
                mobileTopProfileBtn.classList.add("flex");
                mobileTopProfileBtn.style.display = "flex";
                mobileTopProfileBtn.setAttribute("href", dashboardHref);
                
                const mobileTopAvatarLetters = document.getElementById("mobile-top-profile-avatar-letters");
                const mobileTopAvatarImg = document.getElementById("mobile-top-profile-avatar-img");

                if (displayPhoto && mobileTopAvatarImg) {
                    mobileTopAvatarImg.setAttribute("src", displayPhoto);
                    mobileTopAvatarImg.classList.remove("hidden");
                    if (mobileTopAvatarLetters) mobileTopAvatarLetters.classList.add("hidden");
                } else {
                    if (mobileTopAvatarLetters) mobileTopAvatarLetters.textContent = displayLetters;
                    if (mobileTopAvatarLetters) mobileTopAvatarLetters.classList.remove("hidden");
                    if (mobileTopAvatarImg) mobileTopAvatarImg.classList.add("hidden");
                }
            }

            // Show Mobile Profile Block in Drawer
            if (mobileProfileBlock) {
                mobileProfileBlock.classList.remove("hidden");
                mobileProfileBlock.style.display = "flex";
                const mobileProfileName = document.getElementById("mobile-nav-profile-name");
                const mobileDashboardLink = document.getElementById("mobile-nav-profile-dashboard-link");
                const drawerAvatarLetters = document.getElementById("mobile-drawer-avatar-letters");
                const drawerAvatarImg = document.getElementById("mobile-drawer-avatar-img");

                if (mobileProfileName) mobileProfileName.textContent = displayName;
                if (mobileDashboardLink) mobileDashboardLink.setAttribute("href", dashboardHref);

                if (displayPhoto && drawerAvatarImg) {
                    drawerAvatarImg.setAttribute("src", displayPhoto);
                    drawerAvatarImg.classList.remove("hidden");
                    if (drawerAvatarLetters) drawerAvatarLetters.classList.add("hidden");
                } else {
                    if (drawerAvatarLetters) drawerAvatarLetters.textContent = displayLetters;
                    if (drawerAvatarLetters) drawerAvatarLetters.classList.remove("hidden");
                    if (drawerAvatarImg) drawerAvatarImg.classList.add("hidden");
                }
            }
        } else {
            // NOT logged in: Ensure Auth buttons are visible, profile blocks are hidden
            if (desktopAuthButtons) {
                desktopAuthButtons.classList.remove("hidden");
                desktopAuthButtons.style.display = "flex";
            }
            if (mobileAuthButtons) {
                mobileAuthButtons.classList.remove("hidden");
                mobileAuthButtons.style.display = "flex";
            }
            if (mobileTopSignupBtn) {
                mobileTopSignupBtn.classList.remove("hidden");
                mobileTopSignupBtn.style.display = "inline-flex";
            }
            if (loggedInDivider) {
                loggedInDivider.classList.add("hidden");
                loggedInDivider.style.display = "none";
            }
            if (desktopProfileBlock) {
                desktopProfileBlock.classList.add("hidden");
                desktopProfileBlock.style.display = "none";
            }
            if (mobileTopProfileBtn) {
                mobileTopProfileBtn.classList.add("hidden");
                mobileTopProfileBtn.style.display = "none";
            }
            if (mobileProfileBlock) {
                mobileProfileBlock.classList.add("hidden");
                mobileProfileBlock.style.display = "none";
            }
        }
    }

    // Run synchronization immediately and on page events
    syncAuthHeader();
    document.addEventListener("DOMContentLoaded", syncAuthHeader);
    window.addEventListener("storage", syncAuthHeader);

    // Handle Logout triggers
    const handleLogout = (e) => {
        e.preventDefault();
        localStorage.removeItem("travltik_user"); localStorage.removeItem("travltik_user");
        localStorage.removeItem("seeker_firstName");
        localStorage.removeItem("seeker_lastName");
        localStorage.removeItem("seeker_email");
        localStorage.removeItem("seeker_phone");
        localStorage.removeItem("seeker_passportCountry");
        localStorage.removeItem("seeker_goals");
        localStorage.removeItem("seeker_destinations");
        localStorage.removeItem("seeker_profilePhoto");
        
        localStorage.removeItem("expert_businessName");
        localStorage.removeItem("expert_email");
        localStorage.removeItem("expert_contactNumber");
        localStorage.removeItem("expert_advisorType");
        localStorage.removeItem("expert_aboutMe");
        localStorage.removeItem("expert_portfolioLink");
        localStorage.removeItem("expert_officeAddress");
        localStorage.removeItem("expert_govRegNumber");
        localStorage.removeItem("expert_expertiseTags");
        localStorage.removeItem("expert_countriesExpertise");
        localStorage.removeItem("expert_profilePhoto");
        localStorage.removeItem("expert_isLoggedIn");
        
        syncAuthHeader();
        window.location.href = "/";
    };

    const desktopLogoutBtn = document.getElementById("nav-profile-logout-btn");
    const mobileLogoutBtn = document.getElementById("mobile-nav-profile-logout-btn");

    if (desktopLogoutBtn) desktopLogoutBtn.addEventListener("click", handleLogout);
    if (mobileLogoutBtn) mobileLogoutBtn.addEventListener("click", handleLogout);
</script>
