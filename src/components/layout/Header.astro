  // DOM Elements
  const searchTriggerBtn = document.getElementById('atlys-search-trigger');
  const searchModal = document.getElementById('atlys-search-modal');
  const searchBackdrop = document.getElementById('atlys-search-backdrop');
  const searchCloseBtn = document.getElementById('global-search-close');
  const searchClearBtn = document.getElementById('global-search-clear');
  const searchInput = document.getElementById('global-search-input') as HTMLInputElement | null;
  const searchResultsContainer = document.getElementById('global-search-results');
  const searchCountBadge = document.getElementById('global-search-count');
  const filterTabs = document.querySelectorAll('.search-filter-tab');

  // User Profile Dropdown Elements
  const userBtn = document.getElementById('atlys-user-btn');
  const userDropdown = document.getElementById('atlys-user-dropdown');
  const dropdownLoggedOut = document.getElementById('atlys-dropdown-logged-out');
  const dropdownLoggedIn = document.getElementById('atlys-dropdown-logged-in');
  const dropdownUsername = document.getElementById('atlys-dropdown-username');
  const dropdownDashboardLink = document.getElementById('atlys-dropdown-dashboard-link');
  const dropdownLogoutBtn = document.getElementById('atlys-dropdown-logout-btn');

  let activeFilter = 'all';
  let activeIndex = -1;
  let currentResults: typeof SEARCH_ITEMS = [];

  // Open & Close Search Modal
  function openSearchModal() {
    if (!searchModal || !searchInput) return;
    searchModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    searchInput.value = '';
    activeFilter = 'all';
    updateFilterUI();
    renderSearchResults('');
    setTimeout(() => searchInput.focus(), 50);
  }

  function closeSearchModal() {
    if (!searchModal) return;
    searchModal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  if (searchTriggerBtn) searchTriggerBtn.addEventListener('click', openSearchModal);
  if (searchBackdrop) searchBackdrop.addEventListener('click', closeSearchModal);
  if (searchCloseBtn) searchCloseBtn.addEventListener('click', closeSearchModal);

  // Keyboard shortcut: Cmd+K / Ctrl+K / '/'
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      if (searchModal?.classList.contains('hidden')) {
        openSearchModal();
      } else {
        closeSearchModal();
      }
    } else if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearchModal();
    }
  });

  // Filter Tabs
  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      activeFilter = tab.getAttribute('data-filter') || 'all';
      updateFilterUI();
      renderSearchResults(searchInput?.value || '');
    });
  });

  function updateFilterUI() {
    filterTabs.forEach((t) => {
      const f = t.getAttribute('data-filter');
      if (f === activeFilter) {
        t.className = 'search-filter-tab px-3.5 py-1.5 rounded-full bg-[#370c63] text-white shadow-[0_4px_14px_-2px_rgba(55,12,99,0.45)] border border-[#370c63] cursor-pointer transition-all duration-150 flex items-center gap-1.5 font-bold';
      } else {
        t.className = 'search-filter-tab px-3.5 py-1.5 rounded-full bg-white text-[#4b4268] hover:text-[#1e1338] hover:bg-[#ede8f5] border border-[#ede9f6] cursor-pointer transition-all duration-150 flex items-center gap-1.5 font-semibold';
      }
    });
  }

  // Render Search Results
  function renderSearchResults(query: string) {
    if (!searchResultsContainer) return;
    const cleanQuery = query.trim().toLowerCase();
    activeIndex = -1;

    let items = SEARCH_ITEMS;
    if (activeFilter !== 'all') {
      items = items.filter((item) => item.type === activeFilter);
    }

    if (cleanQuery.length > 0) {
      if (searchClearBtn) searchClearBtn.classList.remove('hidden');
      const qTokens = cleanQuery.split(/\s+/).filter(Boolean);
      items = items.filter((item) => {
        const titleMatch = item.title.toLowerCase();
        const descMatch = item.description.toLowerCase();
        const keywordsMatch = item.keywords.join(' ').toLowerCase();
        const combined = `${titleMatch} ${descMatch} ${keywordsMatch}`;
        return qTokens.every((token) => combined.includes(token));
      });
    } else {
      if (searchClearBtn) searchClearBtn.classList.add('hidden');
    }

    currentResults = items;

    if (searchCountBadge) {
      searchCountBadge.textContent = `${items.length} ${items.length === 1 ? 'match' : 'matches'}`;
    }

    if (items.length === 0) {
      searchResultsContainer.innerHTML = `
        <div class="py-14 text-center">
          <div class="w-14 h-14 mx-auto rounded-3xl bg-gradient-to-br from-[#f7f2fe] to-[#eee3fc] border border-[#dccaf7] flex items-center justify-center text-[#430f7a] mb-3 text-2xl shadow-xs">🔍</div>
          <h4 class="text-sm font-extrabold text-[#1b1233]">No results found for "${query}"</h4>
          <p class="text-xs text-[#675f80] mt-1 max-w-sm mx-auto font-medium">Try searching for "Canada", "Dr. Sneha", "SOP Generator", "UK", or "Jobs".</p>
        </div>
      `;
      return;
    }

    searchResultsContainer.innerHTML = items
      .map((item, index) => {
        let iconBg = 'bg-gradient-to-br from-[#e2f7ee] to-[#c7f0de] text-[#008f5a] border-[#00b070]/30';
        let badgeStyle = 'bg-[#e2f7ee] text-[#008f5a] border-[#00b070]/30';
        let iconSvg = '';

        if (item.type === 'visa') {
          iconBg = 'bg-gradient-to-br from-[#e2f7ee] to-[#c7f0de] text-[#008f5a] border-[#00b070]/30';
          badgeStyle = 'bg-[#e2f7ee] text-[#008f5a] border-[#00b070]/30';
          iconSvg = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20M2 12h20"/></svg>`;
        } else if (item.type === 'expert') {
          iconBg = 'bg-gradient-to-br from-[#f7f2fe] to-[#eee3fc] text-[#430f7a] border-[#9a6bdc]/30';
          badgeStyle = 'bg-[#eee3fc] text-[#430f7a] border-[#dccaf7]';
          iconSvg = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>`;
        } else if (item.type === 'ai-tool') {
          iconBg = 'bg-gradient-to-br from-amber-50 to-amber-100/90 text-amber-700 border-amber-300/50';
          badgeStyle = 'bg-amber-50 text-amber-800 border-amber-200';
          iconSvg = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`;
        } else {
          iconBg = 'bg-gradient-to-br from-blue-50 to-indigo-100/90 text-blue-700 border-blue-300/50';
          badgeStyle = 'bg-blue-50 text-blue-700 border-blue-200';
          iconSvg = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`;
        }

        return `
          <a 
            href="${item.href}" 
            data-search-index="${index}"
            class="search-result-row group flex items-center justify-between gap-3 p-3 sm:p-3.5 rounded-2xl border border-transparent hover:border-[#dccaf7] bg-white hover:bg-gradient-to-r hover:from-[#f7f2fe]/70 hover:to-[#f1fbf6]/50 transition-all duration-200 cursor-pointer shadow-none hover:shadow-[0_4px_16px_-4px_rgba(67,15,122,0.1)] hover:-translate-y-0.5"
          >
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-11 h-11 rounded-2xl border ${iconBg} flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform shadow-2xs">
                ${iconSvg}
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h4 class="text-sm font-extrabold text-[#1b1233] group-hover:text-[#430f7a] transition-colors leading-snug">
                    ${highlightQuery(item.title, cleanQuery)}
                  </h4>
                  <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full border ${badgeStyle}">
                    ${item.category}
                  </span>
                </div>
                <p class="text-xs text-[#675f80] line-clamp-1 mt-0.5 font-medium">
                  ${highlightQuery(item.description, cleanQuery)}
                </p>
              </div>
            </div>
            <div class="shrink-0 flex items-center pl-2">
              <div class="w-8 h-8 rounded-full bg-slate-100/80 text-slate-400 group-hover:bg-[#00b070] group-hover:text-white flex items-center justify-center transition-all duration-200 group-hover:scale-105 shadow-2xs">
                <span class="text-xs font-black">→</span>
              </div>
            </div>
          </a>
        `;
      })
      .join('');
  }

  function highlightQuery(text: string, q: string) {
    if (!q) return text;
    const regex = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return text.replace(regex, '<span class="bg-[#eee3fc] text-[#430f7a] rounded px-1 font-black">$1</span>');
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      renderSearchResults((e.target as HTMLInputElement).value);
    });

    searchInput.addEventListener('keydown', (e) => {
      const rows = document.querySelectorAll('.search-result-row');
      if (rows.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % rows.length;
        updateActiveRow(rows);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + rows.length) % rows.length;
        updateActiveRow(rows);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && activeIndex < currentResults.length) {
          window.location.href = currentResults[activeIndex].href;
        } else if (currentResults.length > 0) {
          window.location.href = currentResults[0].href;
        }
      }
    });
  }

  function updateActiveRow(rows: NodeListOf<Element>) {
    rows.forEach((r, idx) => {
      if (idx === activeIndex) {
        r.classList.add('border-[#9a6bdc]', 'bg-gradient-to-r', 'from-[#f7f2fe]', 'to-[#f1fbf6]', 'shadow-[0_4px_16px_-4px_rgba(67,15,122,0.15)]');
        (r as HTMLElement).scrollIntoView({ block: 'nearest' });
      } else {
        r.classList.remove('border-[#9a6bdc]', 'bg-gradient-to-r', 'from-[#f7f2fe]', 'to-[#f1fbf6]', 'shadow-[0_4px_16px_-4px_rgba(67,15,122,0.15)]');
      }
    });
  }

  if (searchClearBtn && searchInput) {
    searchClearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchInput.focus();
      renderSearchResults('');
    });
  }

  // --- Dynamic Auth Status Sync for User Profile Button ---
  function syncAtlysAuth() {
    const seekerFirst = localStorage.getItem('seeker_firstName');
    const expertBusiness = localStorage.getItem('expert_businessName');
    const userStr = localStorage.getItem('travltik_user');

    const isLoggedIn = Boolean(seekerFirst || expertBusiness || (userStr && userStr !== 'null' && userStr !== 'undefined'));

    const userIconSvg = document.getElementById('atlys-user-icon-svg');
    const userAvatarWrap = document.getElementById('atlys-user-avatar-wrap');
    const userAvatarImg = document.getElementById('atlys-user-avatar-img') as HTMLImageElement | null;
    const userAvatarLetters = document.getElementById('atlys-user-avatar-letters');

    if (isLoggedIn) {
      let displayName = 'User';
      let displayLetters = 'U';
      let dashboardHref = '/traveller/dashboard';
      let displayPhoto = '';

      if (expertBusiness) {
        displayName = expertBusiness;
        displayLetters = expertBusiness.charAt(0).toUpperCase();
        dashboardHref = '/service-provider/dashboard';
        displayPhoto = localStorage.getItem('expert_profilePhoto') || '';
      } else if (seekerFirst) {
        displayName = seekerFirst + ' ' + (localStorage.getItem('seeker_lastName') || '');
        displayLetters = seekerFirst.charAt(0).toUpperCase();
        dashboardHref = '/traveller/dashboard';
        displayPhoto = localStorage.getItem('seeker_profilePhoto') || '';
      } else if (userStr) {
        try {
          const u = JSON.parse(userStr);
          if (u?.displayName) {
            displayName = u.displayName;
            displayLetters = u.displayName.charAt(0).toUpperCase();
          } else if (u?.email) {
            displayName = u.email;
            displayLetters = u.email.charAt(0).toUpperCase();
          }
          if (u?.photoURL) displayPhoto = u.photoURL;
          if (u?.type === 'expert') dashboardHref = '/service-provider/dashboard';
        } catch (e) {}
      }

      // Show avatar circle
      if (userIconSvg) userIconSvg.classList.add('hidden');
      if (userAvatarWrap) {
        userAvatarWrap.classList.remove('hidden');
        userAvatarWrap.classList.add('flex');
      }
      if (displayPhoto && userAvatarImg) {
        userAvatarImg.src = displayPhoto;
        userAvatarImg.classList.remove('hidden');
        if (userAvatarLetters) userAvatarLetters.classList.add('hidden');
      } else if (userAvatarLetters) {
        userAvatarLetters.textContent = displayLetters;
        userAvatarLetters.classList.remove('hidden');
      }

      // Dropdown view toggle
      if (dropdownLoggedOut) dropdownLoggedOut.classList.add('hidden');
      if (dropdownLoggedIn) {
        dropdownLoggedIn.classList.remove('hidden');
        dropdownLoggedIn.classList.add('flex');
      }
      if (dropdownUsername) dropdownUsername.textContent = displayName;
      if (dropdownDashboardLink) dropdownDashboardLink.setAttribute('href', dashboardHref);

    } else {
      // Logged out
      if (userIconSvg) userIconSvg.classList.remove('hidden');
      if (userAvatarWrap) {
        userAvatarWrap.classList.add('hidden');
        userAvatarWrap.classList.remove('flex');
      }
      if (dropdownLoggedOut) dropdownLoggedOut.classList.remove('hidden');
      if (dropdownLoggedIn) dropdownLoggedIn.classList.add('hidden');
    }
  }

  // Toggle User Dropdown
  if (userBtn && userDropdown) {
    userBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      userDropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!userDropdown.contains(e.target as Node) && !userBtn.contains(e.target as Node)) {
        userDropdown.classList.add('hidden');
      }
    });
  }

  // Logout handler
  if (dropdownLogoutBtn) {
    dropdownLogoutBtn.addEventListener('click', () => {
      localStorage.removeItem('travltik_user');
      localStorage.removeItem('seeker_firstName');
      localStorage.removeItem('seeker_lastName');
      localStorage.removeItem('seeker_profilePhoto');
      localStorage.removeItem('expert_businessName');
      localStorage.removeItem('expert_profilePhoto');
      window.location.href = '/login';
    });
  }

  // Initialize
  syncAtlysAuth();
  document.addEventListener('astro:page-load', () => {
    syncAtlysAuth();
  });
</script>
