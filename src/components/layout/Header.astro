---
// src/components/layout/Header.astro - Atlys Minimalist Header with Global OmniSearch
import { TripPlannerModal } from '../interactive/TripPlannerModal';
import { dummyExperts } from '../../data/dummyExperts';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
---

<!-- Atlys-Style Clean Sticky Header matching Landing Page Theme -->
<header id="main-header" class="sticky top-0 left-0 w-full z-40 bg-gradient-to-b from-white via-[#faf8fc] to-[#f4eff9]/60 backdrop-blur-md border-b border-[rgba(67,15,122,0.08)] shadow-[0_4px_20px_-8px_rgba(67,15,122,0.08)] transition-all duration-200">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[68px] flex items-center justify-between gap-4">
    
    <!-- 1. LEFT: TravlTik Brand Logo -->
    <div class="flex items-center shrink-0">
      <a href="/" class="flex items-center gap-2 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#00b070] rounded-lg" aria-label="TravlTik Home">
        <img 
          id="header-logo-img" 
          src="/logo.png?v=13" 
          alt="TravlTik Logo" 
          class="h-9 sm:h-10 lg:h-11 max-h-[46px] w-auto object-contain transition-transform group-hover:scale-[1.02] duration-150" 
        />
      </a>
    </div>

    <!-- 2. RIGHT: Compact Search Button + Airbnb-Style Menu Pill -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0 font-sans">
      
      <!-- Compact Search Button -->
      <button 
        id="atlys-search-trigger" 
        type="button"
        class="flex items-center gap-2 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-full bg-white hover:bg-[#faf8fc] border border-[#ede9f6] hover:border-[#dccaf7] text-[#4b4268] hover:text-[#1e1338] transition-all duration-150 cursor-pointer shadow-2xs hover:shadow-xs active:scale-95 group focus:outline-none focus:ring-2 focus:ring-[#00b070]/20"
        aria-label="Search website (⌘K)"
        title="Search visas, experts, AI tools... (⌘K)"
      >
        <svg class="w-3.5 h-3.5 text-[#00b070] group-hover:scale-110 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="text-xs font-bold tracking-tight text-[#1b1233] group-hover:text-[#430f7a]">Search</span>
        <kbd class="hidden md:inline-flex items-center px-1.5 py-0.5 text-[9.5px] font-mono font-bold text-[#8b82a3] bg-[#faf8fc] border border-[#ede9f6] rounded shadow-2xs leading-none ml-0.5">⌘K</kbd>
      </button>

      <!-- Airbnb-Style Unified Menu Pill (Hamburger + User Avatar) -->
      <div class="relative">
        <button 
          id="atlys-user-btn"
          type="button"
          class="flex items-center gap-2.5 sm:gap-3 pl-3.5 sm:pl-4 pr-1.5 py-1.5 rounded-full border border-[#ede9f6] hover:border-[#dccaf7] hover:shadow-[0_4px_16px_rgba(67,15,122,0.12)] bg-white transition-all duration-150 cursor-pointer active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#00b070]/20 min-h-[42px] sm:min-h-[44px]"
          aria-label="Main navigation menu & user account"
          aria-expanded="false"
        >
          <!-- Hamburger 3-Line Icon (Left) -->
          <svg class="w-4 h-4 sm:w-[17px] sm:h-[17px] text-[#1b1233] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>

          <!-- User Avatar Circular Badge (Right) -->
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#370c63] hover:bg-[#430f7a] text-white flex items-center justify-center shrink-0 transition-colors shadow-2xs overflow-hidden">
            <!-- Logged Out SVG Icon -->
            <svg id="atlys-user-icon-svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
            <!-- Logged In Avatar (Hydrated dynamically) -->
            <div id="atlys-user-avatar-wrap" class="hidden w-full h-full rounded-full items-center justify-center bg-[#00a896] text-white font-bold text-xs uppercase">
              <img id="atlys-user-avatar-img" class="w-full h-full object-cover hidden" src="" alt="avatar" />
              <span id="atlys-user-avatar-letters" class="leading-none text-[11px]"></span>
            </div>
          </div>
        </button>

        <!-- Account & Menu Popover / Dropdown Menu -->
        <div 
          id="atlys-user-dropdown" 
          class="hidden absolute right-0 mt-2 w-60 sm:w-64 bg-white rounded-2xl border border-slate-200 shadow-xl py-2 z-50 transform origin-top-right transition-all duration-150 font-sans"
        >
          <!-- 1. Logged Out State View -->
          <div id="atlys-dropdown-logged-out" class="flex flex-col">
            <div class="px-2 pb-1">
              <a href="/signup" class="flex items-center px-4 py-2.5 rounded-xl hover:bg-slate-50 text-slate-900 font-bold text-xs sm:text-sm transition">
                Sign up
              </a>
              <a href="/login" class="flex items-center px-4 py-2.5 rounded-xl hover:bg-slate-50 text-slate-700 font-semibold text-xs sm:text-sm transition">
                Log in
              </a>
            </div>

            <div class="my-1 border-t border-slate-100"></div>

            <div class="px-2 pt-1">
              <a href="/find-experts" class="flex items-center gap-2.5 px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-slate-50 transition">
                <span class="text-sm">👨‍⚖️</span>
                <span>Find Verified Experts</span>
              </a>
              <a href="/ai-tools" class="flex items-center gap-2.5 px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-slate-50 transition">
                <span class="text-sm">⚡</span>
                <span>AI Immigration Tools</span>
              </a>
              <a href="/jobs" class="flex items-center gap-2.5 px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-slate-50 transition">
                <span class="text-sm">💼</span>
                <span>International Jobs</span>
              </a>
              <a href="/universities" class="flex items-center gap-2.5 px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-slate-50 transition">
                <span class="text-sm">🎓</span>
                <span>Global Universities</span>
              </a>
              <a href="/escrow" class="flex items-center gap-2.5 px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-slate-50 transition">
                <span class="text-sm">🔒</span>
                <span>Milestone Escrow Protection</span>
              </a>
            </div>

            <div class="my-1 border-t border-slate-100"></div>

            <div class="px-2">
              <a href="/support" class="flex items-center gap-2.5 px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition">
                <span class="text-sm">💬</span>
                <span>Help & Support</span>
              </a>
            </div>
          </div>

          <!-- 2. Logged In State View (Hydrated) -->
          <div id="atlys-dropdown-logged-in" class="hidden flex-col">
            <div class="px-4 py-2.5 border-b border-slate-100 bg-slate-50/50">
              <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Signed in as</div>
              <div id="atlys-dropdown-username" class="text-xs font-extrabold text-slate-900 truncate mt-0.5">User</div>
            </div>
            <div class="p-2 flex flex-col gap-0.5">
              <a id="atlys-dropdown-dashboard-link" href="/traveller/dashboard" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50 transition">
                <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                <span>My Dashboard</span>
              </a>
              <a href="/find-experts" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition">
                <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                <span>Find Experts</span>
              </a>
              <a href="/ai-tools" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition">
                <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                <span>AI Tools</span>
              </a>
              <a href="/support" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition">
                <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                <span>Help & Support</span>
              </a>
            </div>
            <div class="pt-1 border-t border-slate-100 px-2 pb-1">
              <button id="atlys-dropdown-logout-btn" type="button" class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 hover:bg-rose-50 transition cursor-pointer text-left">
                <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                <span>Log out</span>
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Trip Planner Modal preserved for compatibility -->
  <TripPlannerModal client:load />
</header>

<!-- Global OmniSearch Modal with Landing Page Theme -->
<div 
  id="atlys-search-modal" 
  class="fixed inset-0 z-[100] hidden flex items-start justify-center pt-8 sm:pt-16 px-3 sm:px-4 pb-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Global Site Search"
>
  <!-- Backdrop Blur with Ambient Purple Hue -->
  <div id="atlys-search-backdrop" class="fixed inset-0 bg-[#1b1233]/60 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Card with Luxury Landing Page Styling -->
  <div class="relative w-full max-w-2xl bg-white rounded-[28px] shadow-[0_24px_70px_-15px_rgba(55,12,99,0.38)] border border-[#ede9f6] overflow-hidden z-10 flex flex-col max-h-[85vh] animate-in fade-in zoom-in-95 duration-200">
    
    <!-- Top Search Input Bar with Luxury Soft Glow -->
    <div class="relative flex items-center px-4 sm:px-6 py-1 bg-gradient-to-b from-white via-[#faf8fc] to-[#f7f2fe]/40 border-b border-[#ede9f6]">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-[#e2f7ee] to-[#d0f3e3] border border-[#00b070]/30 flex items-center justify-center text-[#00b070] shrink-0 mr-3.5 shadow-2xs">
        <svg class="w-5 h-5 stroke-[2.4]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <input 
        id="global-search-input" 
        type="text" 
        autocomplete="off" 
        spellcheck="false"
        placeholder="Search visas, countries, verified experts, AI tools, jobs..."
        class="w-full h-14 sm:h-16 bg-transparent text-[#1b1233] placeholder:text-[#8b82a3] font-bold text-base sm:text-[17px] focus:outline-none"
      />
      <div class="flex items-center gap-2 shrink-0">
        <button 
          id="global-search-clear" 
          type="button" 
          class="hidden text-[#8b82a3] hover:text-[#1b1233] p-1.5 rounded-lg text-xs font-bold hover:bg-slate-100 transition cursor-pointer"
          aria-label="Clear query"
        >
          ✕
        </button>
        <kbd id="global-search-close" class="cursor-pointer text-[11px] font-mono font-bold text-[#430f7a] hover:text-[#370c63] bg-white hover:bg-[#eee3fc] border border-[#dccaf7] px-2.5 py-1 rounded-lg transition shadow-2xs">ESC</kbd>
      </div>
    </div>

    <!-- Category Filter Tabs Styled Exact to Landing Page Tabs -->
    <div class="flex items-center gap-2 px-4 sm:px-6 py-3 bg-[#faf8fc] border-b border-[#ede9f6] overflow-x-auto no-scrollbar text-xs font-bold">
      <button type="button" data-filter="all" class="search-filter-tab px-3.5 py-1.5 rounded-full bg-[#370c63] text-white shadow-[0_4px_14px_-2px_rgba(55,12,99,0.45)] border border-[#370c63] cursor-pointer transition-all duration-150 flex items-center gap-1.5">
        <span>✨</span><span>All</span>
      </button>
      <button type="button" data-filter="visa" class="search-filter-tab px-3.5 py-1.5 rounded-full bg-white text-[#4b4268] hover:text-[#1e1338] hover:bg-[#ede8f5] border border-[#ede9f6] cursor-pointer transition-all duration-150 flex items-center gap-1.5">
        <span>🌍</span><span>Visas & Countries</span>
      </button>
      <button type="button" data-filter="expert" class="search-filter-tab px-3.5 py-1.5 rounded-full bg-white text-[#4b4268] hover:text-[#1e1338] hover:bg-[#ede8f5] border border-[#ede9f6] cursor-pointer transition-all duration-150 flex items-center gap-1.5">
        <span>👨‍⚖️</span><span>Verified Experts</span>
      </button>
      <button type="button" data-filter="ai-tool" class="search-filter-tab px-3.5 py-1.5 rounded-full bg-white text-[#4b4268] hover:text-[#1e1338] hover:bg-[#ede8f5] border border-[#ede9f6] cursor-pointer transition-all duration-150 flex items-center gap-1.5">
        <span>⚡</span><span>AI Tools</span>
      </button>
      <button type="button" data-filter="service" class="search-filter-tab px-3.5 py-1.5 rounded-full bg-white text-[#4b4268] hover:text-[#1e1338] hover:bg-[#ede8f5] border border-[#ede9f6] cursor-pointer transition-all duration-150 flex items-center gap-1.5">
        <span>💼</span><span>Jobs & Services</span>
      </button>
    </div>

    <!-- Results List Container with Card Spacing -->
    <div id="global-search-results" class="flex-1 overflow-y-auto p-3 sm:p-4 space-y-2 min-h-[260px] max-h-[520px]">
      <!-- Dynamically populated via script -->
    </div>

    <!-- Luxury Footer Bar -->
    <div class="px-4 sm:px-6 py-3 bg-gradient-to-r from-[#faf8fc] to-[#f4eff9] border-t border-[#ede9f6] flex items-center justify-between text-xs text-[#675f80] font-medium">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1">
          <kbd class="font-mono bg-white border border-[#dccaf7] text-[#430f7a] font-bold px-1.5 py-0.5 rounded text-[10px] shadow-2xs">↑</kbd> 
          <kbd class="font-mono bg-white border border-[#dccaf7] text-[#430f7a] font-bold px-1.5 py-0.5 rounded text-[10px] shadow-2xs">↓</kbd> 
          <span>navigate</span>
        </span>
        <span>·</span>
        <span class="flex items-center gap-1">
          <kbd class="font-mono bg-white border border-[#dccaf7] text-[#430f7a] font-bold px-2 py-0.5 rounded text-[10px] shadow-2xs">↵</kbd> 
          <span>select</span>
        </span>
      </div>
      <div id="global-search-count" class="font-bold text-[#008f5a] bg-[#e2f7ee] border border-[#00b070]/25 px-3 py-1 rounded-full text-[11px] shadow-2xs">
        18 quick destinations
      </div>
    </div>

  </div>
</div>

<script>
  // Search Database items covering the entire platform
  const SEARCH_ITEMS = [
    // --- 1. Top Visas & Destination Countries ---
    {
      type: 'visa',
      category: 'Visa & Immigration',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
      title: 'Canada Express Entry & Permanent Residency',
      description: 'CRS score calculator, Federal Skilled Worker, PNP, CEC eligibility & verified RCIC guidance.',
      href: '/find-experts?country=Canada',
      keywords: ['canada', 'express entry', 'pr', 'permanent residency', 'fsw', 'crs', 'rcic', 'ontario', 'bc']
    },
    {
      type: 'visa',
      category: 'Visa & Immigration',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
      title: 'Canada Study Permit & PGWP',
      description: 'Designated Learning Institutions (DLI), Student Direct Stream (SDS), GIC, and work permits.',
      href: '/find-experts?country=Canada',
      keywords: ['canada student', 'study permit', 'pgwp', 'post graduate work permit', 'sds', 'toronto', 'vancouver']
    },
    {
      type: 'visa',
      category: 'Visa & Immigration',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
      title: 'United Kingdom Skilled Worker Visa',
      description: 'Certificate of Sponsorship (CoS), salary thresholds, shortage occupation list & ILR route.',
      href: '/find-experts?country=United+Kingdom',
      keywords: ['uk', 'united kingdom', 'london', 'skilled worker', 'tier 2', 'cos', 'ilr', 'graduate route', 'work visa']
    },
    {
      type: 'visa',
      category: 'Visa & Immigration',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
      title: 'United States H-1B, L-1 & EB-2 NIW Visas',
      description: 'USCIS petitions, specialty occupations, intra-company transfers & National Interest Waivers.',
      href: '/find-experts?country=United+States',
      keywords: ['usa', 'united states', 'america', 'h1b', 'h-1b', 'l1', 'eb2', 'eb-2 niw', 'green card', 'uscis']
    },
    {
      type: 'visa',
      category: 'Visa & Immigration',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
      title: 'United States B1/B2 Visitor & Tourism Visa',
      description: 'DS-160 application review, visa interview preparation & document checklists.',
      href: '/find-experts?country=United+States',
      keywords: ['usa tourist', 'b1', 'b2', 'b1/b2', 'ds160', 'ds-160', 'us tourist visa', 'interview prep']
    },
    {
      type: 'visa',
      category: 'Visa & Immigration',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
      title: 'Australia Permanent Residency (Subclass 189 & 190)',
      description: 'SkillSelect points test, MARA accredited agent guidance & state nomination pathways.',
      href: '/find-experts?country=Australia',
      keywords: ['australia', 'pr', 'subclass 189', 'subclass 190', 'subclass 491', 'mara', 'sydney', 'melbourne']
    },
    {
      type: 'visa',
      category: 'Visa & Immigration',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
      title: 'Germany Opportunity Card (Chancenkarte) & EU Blue Card',
      description: 'New German points system for job seekers, recognized degrees & accelerated residence permits.',
      href: '/find-experts?country=Germany',
      keywords: ['germany', 'chancenkarte', 'opportunity card', 'blue card', 'eu blue card', 'job seeker', 'berlin', 'munich']
    },
    {
      type: 'visa',
      category: 'Visa & Immigration',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
      title: 'Dubai & UAE 10-Year Golden Visa',
      description: 'Investors, entrepreneurs, specialized talents, executive professionals & real estate buyers.',
      href: '/find-experts?country=UAE',
      keywords: ['dubai', 'uae', 'golden visa', 'emirates', 'abu dhabi', 'investor visa', 'freelance visa']
    },
    {
      type: 'visa',
      category: 'Visa & Immigration',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
      title: 'Schengen European Tourist & Business Visa',
      description: 'Standard 90/180-day visas for 29 European countries with cover letter & itinerary audit.',
      href: '/find-experts',
      keywords: ['schengen', 'europe', 'france', 'italy', 'spain', 'switzerland', 'tourist visa', 'visit visa']
    },

    // --- 2. Verified Immigration Consultants & Lawyers ---
    {
      type: 'expert',
      category: 'Verified Expert',
      badgeClass: 'bg-purple-50 text-purple-700 border-purple-200',
      title: 'Dr. Sneha Joshi — New Zealand & Australia Specialist',
      description: 'Expert in New Zealand Skilled Migrant, Essential Skills & Australian state-nominated PR pathways. 450+ approvals.',
      href: '/expert/d8',
      keywords: ['sneha joshi', 'sneha', 'd8', 'new zealand', 'australia', 'skilled migrant', 'nagpur', 'iaa']
    },
    {
      type: 'expert',
      category: 'Verified Expert',
      badgeClass: 'bg-purple-50 text-purple-700 border-purple-200',
      title: 'Arjun Mehta — Canada Immigration Consultant (RCIC)',
      description: '10+ years helping professionals get Canadian PR, Study Permits & PGWP. 850+ successful cases.',
      href: '/expert/d1',
      keywords: ['arjun mehta', 'arjun', 'd1', 'canada', 'express entry', 'rcic', 'hyderabad']
    },
    {
      type: 'expert',
      category: 'Verified Expert',
      badgeClass: 'bg-purple-50 text-purple-700 border-purple-200',
      title: 'Priya Sharma — UK & Australia Visa Solicitor',
      description: 'Specialist in UK Skilled Worker, Graduate Route & Australian 189 PR. Former UK Home Office consultant.',
      href: '/expert/d2',
      keywords: ['priya sharma', 'priya', 'd2', 'uk', 'australia', 'mumbai', 'oisc', 'skilled worker']
    },
    {
      type: 'expert',
      category: 'Verified Expert',
      badgeClass: 'bg-purple-50 text-purple-700 border-purple-200',
      title: 'Karthik Reddy — US Immigration Attorney',
