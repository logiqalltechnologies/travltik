---
// src/components/Logo.astro

interface Props {
  variant?: 'navbar-light' | 'navbar-dark' | 'footer' | 'icon';
  className?: string;
}

const { variant = 'navbar-light', className = '' } = Astro.props;
---

{variant === 'icon' && (
  <img
    src="/logo-mark.png"
    alt="AbroadZen Logo"
    class={`h-10 w-auto ${className}`}
  />
)}

{variant === 'navbar-light' && (
  <img
    src="/logo.png?v=20"
    alt="AbroadZen"
    class={`h-11 sm:h-12 lg:h-[46px] max-h-[48px] w-auto object-contain navbar-logo ${className}`}
  />
)}

{variant === 'navbar-dark' && (
  <img
    src="/logo-white.png?v=20"
    alt="AbroadZen"
    class={`h-11 sm:h-12 lg:h-[46px] max-h-[48px] w-auto object-contain navbar-logo navbar-logo-dark ${className}`}
  />
)}

{variant === 'footer' && (
  <img
    src="/logo.png?v=20"
    alt="AbroadZen"
    class={`h-14 sm:h-16 w-auto object-contain footer-logo ${className}`}
  />
)}

<style is:global>
  /* Invert logo to white for dark backgrounds if using dark variant */
  .navbar-logo-dark,
  .footer-logo,
  #main-header.header-transparent .navbar-logo {
    filter: brightness(0) invert(1);
  }
  
  /* Smooth transition for logo color changes */
  .navbar-logo {
    transition: filter 0.3s ease;
  }
</style>
