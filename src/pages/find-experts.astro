---
// src/pages/find-experts.astro
import Layout from '../layouts/Layout.astro';
import { FindExpertsPortal } from '../components/interactive/FindExpertsPortal';
import { ProfessionalServiceSchema } from '../components/seo/ProfessionalServiceSchema';
---

<Layout 
  title="Find Verified Immigration Experts & Attorneys" 
  description="Consult directly with top-tier registered immigration attorneys, Express Entry consultants, and legal counselors. Connect, compare, and secure payments with escrow."
>
  <ProfessionalServiceSchema
    name="TravlTik Verified Immigration Consultants & Attorneys"
    description="Directory of verified registered immigration lawyers, MARA agents, and licensed consultants."
    licenseNo="MARA-CICC-VERIFIED"
    country="Worldwide"
    rating={4.9}
    reviewCount={240}
  />
  <div class="bg-[#fff5f5] min-h-screen">

    <!-- INTERACTIVE FIND EXPERTS PORTAL -->
    <FindExpertsPortal client:only="react" />
  </div>
</Layout>
