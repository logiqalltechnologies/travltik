---
// src/pages/find-experts.astro
import Layout from '../layouts/Layout.astro';
import { FindExpertsPortal } from '../components/interactive/FindExpertsPortal';
import { ProfessionalServiceSchema } from '../components/seo/ProfessionalServiceSchema';
---

<Layout 
  title="Find Verified Immigration Experts & Attorneys" 
  description="Consult directly with top-tier registered immigration attorneys, Express Entry consultants, and legal counselors. Connect, compare, and secure payments with escrow."
>
  <ProfessionalServiceSchema
    name="TravlTik Verified Immigration Consultants & Attorneys"
    description="Directory of verified registered immigration lawyers, MARA agents, and licensed consultants."
    licenseNo="MARA-CICC-VERIFIED"
    country="Worldwide"
    rating={4.9}
    reviewCount={240}
  />
  <div class="bg-[#FBFBFE] min-h-screen font-sans selection:bg-purple-100 selection:text-purple-900">
    <!-- Hero Banner (Matching Marketplace Standard) -->
    <div class="bg-slate-900 text-white py-14 px-4 text-center border-b border-slate-800">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand/10 border border-brand/30 text-brand text-xs font-bold tracking-wider uppercase mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
          Verified Legal Network
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-[-0.03em] text-white mb-4">
          Find Licensed Experts
        </h1>
        <p class="text-slate-300 text-base max-w-2xl mx-auto leading-relaxed">
          Compare MARA &amp; RCIC verified consultants, check verified reviews, and book securely through milestone-based escrow protection.
        </p>
      </div>
    </div>

    <!-- INTERACTIVE FIND EXPERTS PORTAL -->
    <FindExpertsPortal client:only="react" />
  </div>
</Layout>

