---
// src/pages/jobs.astro
import Layout from '../layouts/Layout.astro';
import { JobsPortal } from '../components/interactive/JobsPortal';
import { JobSchema } from '../components/seo/JobSchema';
---

<Layout title="Overseas Jobs & Visa Sponsorships" description="Browse premium global career opportunities with verified employers who offer official visa sponsorships.">
    <JobSchema
        title="Overseas Jobs & Visa Sponsorships"
        description="Browse premium global career opportunities with verified employers who offer official visa sponsorships."
        datePosted="2026-01-01"
        validThrough="2026-12-31"
        hiringOrganization="TravlTik Global Career Network"
        country="Canada"
        currency="USD"
        minSalary={50000}
        maxSalary={120000}
    />
    <JobsPortal client:load />

    <!-- Trust & Compliance Disclaimer -->
    <div class="max-w-6xl mx-auto px-6 mb-12">
      <div class="mt-8 p-4 bg-slate-50 border border-slate-200 rounded-xl text-center">
        <p class="text-xs text-slate-500 font-medium">
          🛡️ All job postings are reviewed by our compliance team. We do not list unverified recruitment agencies or roles that require upfront payment.
        </p>
      </div>
    </div>
</Layout>
