---
import Layout from '../layouts/Layout.astro';
import { AddBusinessForm } from '../components/claim/AddBusinessForm';
import { verifySession } from '../backend/auth';

export const prerender = false;

// Check session
const token = Astro.cookies.get('travltik_sid')?.value;
let currentUser = null;
if (token) {
  const session = await verifySession(token);
  if (session && session.user) {
    currentUser = session.user;
  }
}

// Redirect to login if not authenticated
if (!currentUser) {
  return Astro.redirect('/login?redirect=/add-business');
}
---

<Layout title="Add Your Business — TravlTik">
  <div class="min-h-screen bg-[#F8FAFC]">
    <div class="max-w-3xl mx-auto px-4 py-12">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-slate-900 mb-2">Add Your Business</h1>
        <p class="text-sm text-slate-500">
          Help travelers discover your services on TravlTik.
        </p>
      </div>
      <AddBusinessForm client:load initialUser={currentUser} />
    </div>
  </div>
</Layout>
