---
// src/pages/ai-tools/index.astro
import Layout from '../../layouts/Layout.astro';
import { 
  Camera, 
  FileCheck2, 
  FileText, 
  Calculator, 
  Scale, 
  ArrowRight, 
  Sparkles, 
  ShieldCheck, 
  CheckCircle2, 
  Zap, 
  Eye, 
  Lock,
  Globe2,
  Users,
  MessageSquare
} from 'lucide-react';

const tools = [
  {
    id: "whatsapp-concierge",
    title: "WhatsApp AI Concierge",
    category: "concierge",
    categoryLabel: "Pro SaaS",
    description: "Pair your official WhatsApp number with an autonomous AI concierge that qualifies visa leads and books consultations 24/7.",
    href: "/biz/whatsapp",
    badge: "PRO EXCLUSIVE",
    badgeColor: "bg-emerald-50 text-emerald-700 border-emerald-300",
    icon: MessageSquare,
    iconColor: "text-emerald-600 bg-emerald-50 border-emerald-200",
    features: [
      "Instant 24/7 lead qualification & automated slot booking",
      "Pre-trained on Canada, UK, Australia, USA & Schengen policies",
      "Seamless human specialist handoff with zero client drop-off"
    ],
    pricing: "Pro B2B Suite"
  },
  {
    id: "photo-resizer",
    title: "Visa & Passport Photo Resizer",
    category: "biometrics",
    categoryLabel: "Biometrics",
    description: "Crop, resize, and center portrait photos to exact consular specifications for instant biometric compliance.",
    href: "/ai-tools/photo-resizer",
    badge: "Official Biometrics",
    badgeColor: "bg-brand-light text-brand border-brand/20",
    icon: Camera,
    iconColor: "text-brand bg-brand-light border-brand/20",
    features: [
      "Presets for US (2x2 in), Schengen (35x45mm), UK, Canada & India",
      "Instant face proportion & eye-level alignment check",
      "Compliant white / off-white background check"
    ],
    pricing: "Free Instant Tool"
  },
  {
    id: "pdf-audit",
    title: "AI Profile & Document Gap Audit",
    category: "audits",
    categoryLabel: "Legal Audit",
    description: "Upload your CV, transcripts, or application drafts for a comprehensive consular feasibility and risk pre-check.",
    href: "/ai-tools/pdf-audit",
    badge: "Sovereign Grounded",
    badgeColor: "bg-purple-50 text-purple-800 border-purple-200",
    icon: FileCheck2,
    iconColor: "text-purple-600 bg-purple-50 border-purple-100",
    features: [
      "Uncovers critical refusal risks before consular submission",
      "Cross-referenced with latest IRCC & Home Office policies",
      "Actionable document checklist tailored to your profile"
    ],
    pricing: "Free Pre-Check"
  },
  {
    id: "sop-generator",
    title: "SOP & Cover Letter Generator",
    category: "letters",
    categoryLabel: "Consular Drafting",
    description: "Generate embassy-compliant Statement of Purpose drafts that emphasize genuine temporary intent and home ties.",
    href: "/ai-tools/sop-generator",
    badge: "Consular Safeguard",
    badgeColor: "bg-teal-50 text-teal-800 border-teal-200",
    icon: FileText,
    iconColor: "text-teal-600 bg-teal-50 border-teal-100",
    features: [
      "Addresses critical 'Ties to Home Country' regulatory clauses",
      "Customized for Student, Tourist, and Work visa categories",
      "Clear funding clarity and career trajectory articulation"
    ],
    pricing: "Free Generator"
  },
  {
    id: "crs-calculator",
    title: "CRS Points Simulator",
    category: "points",
    categoryLabel: "Points Engine",
    description: "Calculate your Comprehensive Ranking System score for Canada Express Entry and Australia SkillSelect with live weights.",
    href: "/tools?tool=points",
    badge: "Points Simulation",
    badgeColor: "bg-blue-50 text-blue-800 border-blue-200",
    icon: Calculator,
    iconColor: "text-blue-600 bg-blue-50 border-blue-100",
    features: [
      "Live age, language test (IELTS/PTE), and education matrices",
      "Explore cutoff score targets for recent Express Entry draws",
      "Spousal factor and Canadian job offer point additions"
    ],
    pricing: "Free Simulator"
  },
  {
    id: "eligibility",
    title: "Immigration Eligibility Matrix",
    category: "points",
    categoryLabel: "Eligibility Check",
    description: "Benchmark your qualifications against minimum work experience, language test thresholds, and high-demand occupation classifications.",
    href: "/tools?tool=eligibility",
    badge: "Pre-Assessment",
    badgeColor: "bg-amber-50 text-amber-800 border-amber-200",
    icon: Scale,
    iconColor: "text-amber-600 bg-amber-50 border-amber-100",
    features: [
      "Multi-destination comparison (Canada, UK, Australia, Germany)",
      "High-demand NOC & ANZSCO occupation classification mapping",
      "Clear roadmap of required language & credential benchmarks"
    ],
    pricing: "Instant Assessment"
  },
  {
    id: "doc-checklist",
    title: "Consular Document Checklist & Fee Estimator",
    category: "biometrics",
    categoryLabel: "Inventory",
    description: "Consolidated consular document inventories and real-time government application fee estimates for top 20 destination countries.",
    href: "/tools?tool=docs",
    badge: "Government Inventories",
    badgeColor: "bg-indigo-50 text-indigo-800 border-indigo-200",
    icon: ShieldCheck,
    iconColor: "text-indigo-600 bg-indigo-50 border-indigo-100",
    features: [
      "Exhaustive checklists tailored to single, family, and student tracks",
      "Real-time government embassy fees + VFS biometrics estimates",
      "Printable & downloadable PDF compliance summaries"
    ],
    pricing: "Always Free"
  }
];
---

<Layout 
  title="AI Migration Tools Suite — TravlTik" 
  description="Explore TravlTik's suite of AI migration tools: Visa Photo Resizer, AI Profile Audit, SOP Generator, CRS Points Calculator, and Eligibility Matrix."
>
  <div class="relative min-h-screen bg-[#FBFBFE] font-plus-jakarta text-slate-900 overflow-hidden selection:bg-brand/20 selection:text-brand">
    <!-- Ambient Glow Blobs matching Landing Page -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[650px] pointer-events-none -z-10">
      <div class="absolute -top-32 -left-20 w-[550px] h-[550px] bg-gradient-to-br from-brand-light/60 to-brand-light/20 rounded-full blur-3xl opacity-70"></div>
      <div class="absolute top-10 right-0 w-[550px] h-[550px] bg-gradient-to-bl from-purple-100/70 via-indigo-50/30 to-transparent rounded-full blur-3xl opacity-75"></div>
      <div class="absolute top-96 left-1/3 w-[450px] h-[450px] bg-gradient-to-tr from-brand-light/40 to-brand-light/40 rounded-full blur-3xl opacity-60"></div>
    </div>

    <!-- HERO HEADER -->
    <section class="pt-16 pb-16 md:pt-20 md:pb-20 border-b border-slate-200/60 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-brand-light border border-brand/20 text-brand text-xs sm:text-sm font-semibold mb-6 shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand"></span>
          </span>
          <span>NEXT-GEN CONSULAR AUTOMATION · 100% REGULATORY GROUNDED</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-950 mb-4 sm:mb-6 font-sora">
          Sovereign AI Tools for <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-brand to-purple-700 bg-clip-text text-transparent">
            Precision Global Mobility.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed mb-8">
          Empowering applicants and legal teams with instant biometric photo formatting, regulatory document pre-audits, CRS points calculation, and embassy-compliant Statement of Purpose drafting.
        </p>

        <!-- Stats Chips Row -->
        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-left">
          <div class="flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-brand-light text-brand flex items-center justify-center font-bold text-lg">📸</div>
            <div>
              <div class="text-sm font-extrabold text-slate-900 font-sora">100+ Presets</div>
              <div class="text-xs text-slate-500 font-medium">US, Schengen, UK & Canada</div>
            </div>
          </div>

          <div class="flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-lg">⚖️</div>
            <div>
              <div class="text-sm font-extrabold text-slate-900 font-sora">Zero Hallucinations</div>
              <div class="text-xs text-slate-500 font-medium">Rule-Based Ministerial Logic</div>
            </div>
          </div>

          <div class="flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold text-lg">⚡</div>
            <div>
              <div class="text-sm font-extrabold text-slate-900 font-sora">Instant Browser Run</div>
              <div class="text-xs text-slate-500 font-medium">Fast Client-Side Performance</div>
            </div>
          </div>

          <div class="flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-lg">🔒</div>
            <div>
              <div class="text-sm font-extrabold text-slate-900 font-sora">100% Privacy</div>
              <div class="text-xs text-slate-500 font-medium">No Image or Document Storage</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MAIN TOOLS SUITE SECTION -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-10 lg:py-16">
      
      <!-- Filter Bar Tabs -->
      <div class="flex items-center justify-center gap-2 flex-wrap mb-10">
        <button type="button" class="tool-filter-btn px-4 py-2 rounded-full font-bold text-xs sm:text-sm transition-all bg-brand text-white shadow-sm" data-category="all" onclick="filterTools('all', this)">
          🌟 All AI Tools (6)
        </button>
        <button type="button" class="tool-filter-btn px-4 py-2 rounded-full font-semibold text-xs sm:text-sm transition-all bg-white text-slate-600 border border-slate-200 hover:border-brand" data-category="biometrics" onclick="filterTools('biometrics', this)">
          📸 Biometrics & Photos
        </button>
        <button type="button" class="tool-filter-btn px-4 py-2 rounded-full font-semibold text-xs sm:text-sm transition-all bg-white text-slate-600 border border-slate-200 hover:border-brand" data-category="audits" onclick="filterTools('audits', this)">
          📑 Profile & Document Audits
        </button>
        <button type="button" class="tool-filter-btn px-4 py-2 rounded-full font-semibold text-xs sm:text-sm transition-all bg-white text-slate-600 border border-slate-200 hover:border-brand" data-category="points" onclick="filterTools('points', this)">
          🧮 Points & Eligibility
        </button>
        <button type="button" class="tool-filter-btn px-4 py-2 rounded-full font-semibold text-xs sm:text-sm transition-all bg-white text-slate-600 border border-slate-200 hover:border-brand" data-category="letters" onclick="filterTools('letters', this)">
          ✍️ Consular Letters & SOP
        </button>
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="toolsGrid">
        {tools.map((tool) => {
          const Icon = tool.icon;
          return (
            <div 
              class="tool-card group bg-white/95 backdrop-blur-sm rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-2xl hover:shadow-emerald-500/10 hover:border-brand/70 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between relative"
              data-category={tool.category}
            >
              <div>
                <!-- Top Badge & Icon -->
                <div class="flex items-center justify-between gap-3 mb-5">
                  <div class={`w-14 h-14 rounded-2xl flex items-center justify-center border shadow-xs group-hover:scale-105 transition-transform ${tool.iconColor}`}>
                    <Icon className="w-7 h-7" />
                  </div>
                  <span class={`text-[11px] font-bold px-3 py-1 rounded-full border shadow-xs ${tool.badgeColor}`}>
                    {tool.badge}
                  </span>
                </div>

                <div class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 mb-1">
                  {tool.categoryLabel}
                </div>

                <!-- Title -->
                <h2 class="text-lg sm:text-xl font-bold text-slate-900 font-sora group-hover:text-brand transition-colors">
                  {tool.title}
                </h2>

                <!-- Description -->
                <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed font-normal">
                  {tool.description}
                </p>

                <!-- Bullet Capabilities List -->
                <ul class="mt-4 space-y-2 border-t border-slate-100 pt-4">
                  {tool.features.map(f => (
                    <li class="flex items-start gap-2 text-xs text-slate-700 font-medium">
                      <CheckCircle2 className="w-3.5 h-3.5 text-brand shrink-0 mt-0.5" />
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Bottom Action Footer -->
              <div class="pt-5 mt-6 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-extrabold text-brand bg-brand-light border border-brand/20 px-2.5 py-1 rounded-full">
                    {tool.pricing}
                  </span>
                </div>

                <a
                  href={tool.href}
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand hover:bg-brand-hover text-white text-xs font-bold shadow-sm transition-all duration-200"
                >
                  <span>Launch Tool</span>
                  <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- INTERACTIVE COMPARISON / ASSURANCE BANNER -->
      <section class="mt-14 sm:mt-20 p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900 to-slate-900 text-white border border-slate-800 shadow-2xl relative overflow-hidden">
        <!-- Ambient orb inside card -->
        <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-brand/20 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-purple-500/20 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-brand-mint text-xs font-bold mb-4">
              <ShieldCheck className="w-4 h-4 text-brand-mint" />
              <span>OFFICIAL EMBASSY COMPLIANCE GUARANTEE</span>
            </div>

            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-sora text-white tracking-tight">
              AI Powered Speed. Backed by <br class="hidden sm:inline" />
              <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-300 bg-clip-text text-transparent">
                Licensed Consular Attorneys.
              </span>
            </h3>

            <p class="text-sm sm:text-base text-slate-300 mt-3 max-w-2xl leading-relaxed">
              Our automated biometric resizers and eligibility engines eliminate 90% of paperwork errors. For high-stakes applications with prior refusals or complex immigration pathways, connect directly with our registered legal partners.
            </p>

            <div class="flex flex-wrap items-center gap-6 mt-6 pt-6 border-t border-white/10 text-xs sm:text-sm text-slate-300">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span>IRCC & MARA Qualified Partners</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span>Milestone Escrow Protection</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span>Zero Broker Commission</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center">
            <a
              href="/find-experts"
              class="w-full text-center px-6 py-3.5 bg-brand hover:bg-brand-hover text-white font-bold px-6 py-3 rounded-full transition-all shadow-sm active:scale-[0.98] flex items-center justify-center gap-2"
            >
              <span>Consult Licensed Counsel</span>
              <ArrowRight className="w-4 h-4" />
            </a>

            <a
              href="/self-apply"
              class="w-full text-center px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 border border-white/20 text-white font-bold text-sm transition-all flex items-center justify-center gap-2"
            >
              <span>Start Direct Self-Apply</span>
              <Globe2 className="w-4 h-4 text-brand-mint" />
            </a>
          </div>
        </div>
      </section>

    </main>
  </div>

  <script is:inline>
    // Client-side Category Filtering
    function filterTools(category, btn) {
      document.querySelectorAll('.tool-filter-btn').forEach(b => {
        b.className = "tool-filter-btn px-4 py-2 rounded-full font-semibold text-xs sm:text-sm transition-all bg-white text-slate-600 border border-slate-200 hover:border-brand";
      });
      btn.className = "tool-filter-btn px-4 py-2 rounded-full font-bold text-xs sm:text-sm transition-all bg-brand text-white shadow-sm";

      const cards = document.querySelectorAll('.tool-card');
      cards.forEach(card => {
        if (category === 'all' || card.dataset.category === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }
  </script>
</Layout>

