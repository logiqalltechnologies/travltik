---
// src/pages/settings/delete-account.astro
import Layout from '../../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Delete Account — DPDP & GDPR Right to be Forgotten">
  <div class="max-w-md mx-auto p-6 my-12 bg-white rounded-2xl border border-slate-200 shadow-sm">
    <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center font-bold text-xl mb-4">
      ⚠️
    </div>
    <h1 class="text-2xl font-black text-slate-900 mb-2">Delete Account</h1>
    <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
      In accordance with DPDP Act & GDPR Article 17, this action will permanently delete your biometric uploads, document vault, and active sessions. This cannot be undone.
    </p>

    <div class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Registered Email Address
        </label>
        <input 
          id="emailInput" 
          type="email" 
          placeholder="your.email@example.com" 
          class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500" 
        />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Type DELETE to confirm
        </label>
        <input 
          id="confirmInput" 
          placeholder="DELETE" 
          class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500" 
        />
      </div>

      <div id="statusMsg" class="hidden text-xs p-3 rounded-lg"></div>

      <button 
        id="deleteBtn" 
        class="w-full py-3.5 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl text-sm transition-colors shadow-sm"
      >
        Permanently Delete My Data
      </button>
    </div>
  </div>
</Layout>

<script>
  document.getElementById('deleteBtn')?.addEventListener('click', async () => {
    const confirmVal = (document.getElementById('confirmInput') as HTMLInputElement)?.value?.trim();
    const emailVal = (document.getElementById('emailInput') as HTMLInputElement)?.value?.trim();
    const statusMsg = document.getElementById('statusMsg');

    if (confirmVal !== 'DELETE') {
      if (statusMsg) {
        statusMsg.className = 'text-xs p-3 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 block';
        statusMsg.innerText = 'Please type DELETE exactly to confirm.';
      }
      return;
    }

    try {
      const res = await fetch('/api/user/delete-account', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ confirm: confirmVal, email: emailVal }),
      });
      const data = await res.json();
      if (data.success) {
        if (statusMsg) {
          statusMsg.className = 'text-xs p-3 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 block';
          statusMsg.innerText = 'Account successfully deleted. Redirecting...';
        }
        setTimeout(() => {
          window.location.href = '/';
        }, 1500);
      } else {
        if (statusMsg) {
          statusMsg.className = 'text-xs p-3 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 block';
          statusMsg.innerText = data.error || 'Failed to delete account.';
        }
      }
    } catch (err: any) {
      if (statusMsg) {
        statusMsg.className = 'text-xs p-3 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 block';
        statusMsg.innerText = err.message || 'Network error.';
      }
    }
  });
</script>
