function renderShowcase(tab, filterQuery = '') {
  const data = SHOWCASE_DATA[tab] || SHOWCASE_DATA.experts;
  const titleEl = $('#showcase-title');
  const subEl = $('#showcase-subtitle');
  const viewAllEl = $('#showcase-view-all');
  const viewAllText = $('#showcase-view-all-text');
  const gridEl = $('#showcase-grid');

  if (titleEl) titleEl.innerHTML = data.title;
  if (subEl) subEl.textContent = data.subtitle;
  if (viewAllEl) viewAllEl.href = data.viewAllHref;
  if (viewAllText) viewAllText.textContent = data.viewAllText;

  let items = data.items;
  if (filterQuery) {
    const q = filterQuery.toLowerCase();
    items = items.filter(it => 
      it.title.toLowerCase().includes(q) || 
      it.sub.toLowerCase().includes(q) || 
      (it.badge && it.badge.toLowerCase().includes(q)) ||
      (it.col1Val && it.col1Val.toLowerCase().includes(q)) ||
      (it.col2Val && it.col2Val.toLowerCase().includes(q)) ||
      (it.col3Val && it.col3Val.toLowerCase().includes(q))
    );
  }

  if (gridEl) {
    if (items.length === 0) {
      gridEl.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:48px 20px;color:#64748b;font-weight:600;font-size:15px;">No listings found matching "${filterQuery}". <button type="button" style="color:var(--p2);font-weight:700;background:none;border:none;cursor:pointer;text-decoration:underline;" onclick="if($('#q')){$('#q').value='';renderShowcase('${tab}');}">Clear search</button></div>`;
      return;
    }

    gridEl.innerHTML = items.map(it => `
      <a href="${it.href}" class="atlys-card" onclick="if(event.target.tagName !== 'BUTTON'){window.location.href='${it.href}';}">
