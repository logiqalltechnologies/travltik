function executeMobileSearchAction() {
  const query = mobSheetDestInput ? mobSheetDestInput.value.trim() : (mobSelectedDest || '');
  const cat = mobSelectedCategory || 'all';

  // 1. Jobs Category
  if (cat === 'jobs') {
    const jParams = new URLSearchParams();
    if (query) {
      jParams.set('search', query);
      jParams.set('q', query);
      jParams.set('country', query);
    }
    window.location.href = '/jobs' + (jParams.toString() ? '?' + jParams.toString() : '');
    return;
  }

  // 2. Universities Category
  if (cat === 'universities') {
    const uParams = new URLSearchParams();
    if (query) {
      uParams.set('search', query);
      uParams.set('q', query);
      uParams.set('country', query);
    }
    window.location.href = '/universities' + (uParams.toString() ? '?' + uParams.toString() : '');
    return;
  }

  // 3. Tours Category
  if (cat === 'tours') {
    const isCricketOrGreece = query.toLowerCase().includes('cricket') || query.toLowerCase().includes('greece');
    if (isCricketOrGreece) {
      sessionStorage.setItem("auto_open_greece_tour", "true");
      window.location.href = '/tours?category=sports&country=greece';
      return;
    }
    const tParams = new URLSearchParams();
    if (query) {
      tParams.set('search', query);
      tParams.set('destination', query);
    }
    window.location.href = '/tours' + (tParams.toString() ? '?' + tParams.toString() : '');
    return;
  }

  // 4. Experts Category
  if (cat === 'experts') {
    const eParams = new URLSearchParams();
    if (query) {
      eParams.set('q', query);
      eParams.set('search', query);
      eParams.set('country', query);
    }
    const fromVal = ($('#mob-sheet-from-val')?.firstElementChild?.textContent || '').trim();
    if (fromVal && !fromVal.includes('Other') && fromVal !== 'Citizenship') {
      const cleanFrom = fromVal.replace(/[^a-zA-Z\s]/g, '').trim();
      if (cleanFrom) eParams.set('from', cleanFrom);
    }
    window.location.href = '/find-experts' + (eParams.toString() ? '?' + eParams.toString() : '');
    return;
  }

  // 5. All Category
  // If user searched Greece or Cricket specifically
  if (query.toLowerCase().includes('cricket') || query.toLowerCase().includes('greece cricket')) {
    sessionStorage.setItem("auto_open_greece_tour", "true");
    window.location.href = '/tours?category=sports&country=greece';
    return;
  }

  // Sync category tab with main page
  activeAirbnbTab = 'all';
  $$('.airbnb-cat-tab').forEach(b => {
    b.classList.toggle('active', b.dataset.tab === 'all');
  });

  // Sync input values on page
  if (mobLiveQ) mobLiveQ.value = query;
  if (liveQ) liveQ.value = query;

  // Render showcase with query
  renderShowcase('all', query);

  // Close sheet
  closeMobileSearchSheet();

  // Smooth scroll down to showcase results
  const scEl = $('#airbnb-showcase');
  if (scEl) {
    setTimeout(() => {
      scEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 180);
  }
}

if (mobSheetSearchBtn) {
  mobSheetSearchBtn.addEventListener('click', executeMobileSearchAction);
}

// Search submit button
const goBtn = $('#go');
if (goBtn) {
  goBtn.onclick = () => {
    const qVal = ($('#q') ? $('#q').value.trim() : '');
    const destVal = ($('#dest-val') && $('#dest-val').value.trim()) || ($('#dest-val-input') ? $('#dest-val-input').value.trim() : '');
    const fromVal = ($('#from-val') && $('#from-val').value.trim()) || ($('#from-val-input') ? $('#from-val-input').value.trim() : 'India');

    if (activeAirbnbTab === 'jobs') {
      const jParams = new URLSearchParams();
      if (qVal) {
        jParams.set('search', qVal);
        jParams.set('q', qVal);
      }
      if (destVal && destVal !== 'Select Country') {
        jParams.set('country', destVal);
        jParams.set('destination', destVal);
      }
      window.location.href = '/jobs' + (jParams.toString() ? '?' + jParams.toString() : '');
      return;
    }

    if (activeAirbnbTab === 'universities') {
      const uParams = new URLSearchParams();
      if (qVal) {
        uParams.set('search', qVal);
        uParams.set('q', qVal);
      }
      if (destVal && destVal !== 'Select Country') {
        uParams.set('country', destVal);
        uParams.set('destination', destVal);
      }
      window.location.href = '/universities' + (uParams.toString() ? '?' + uParams.toString() : '');
      return;
    }

    if (activeAirbnbTab === 'tours') {
      window.location.href = '/tours' + (qVal ? '?search=' + encodeURIComponent(qVal) : '');
      return;
    }

    if (activeAirbnbTab === 'offers') {
      window.location.href = '/find-experts?filter=offers' + (qVal ? '&q=' + encodeURIComponent(qVal) : '');
      return;
    }

    // Default: Experts tab
    const params = new URLSearchParams();
    if (qVal) {
      params.set('q', qVal);
      params.set('search', qVal);
    }
    if (destVal && destVal !== 'Select Country') {
      params.set('country', destVal);
      params.set('destination', destVal);
    }
    if (fromVal) {
      params.set('from', fromVal);
    }
    window.location.href = '/find-experts' + (params.toString() ? '?' + params.toString() : '');
  };
}

