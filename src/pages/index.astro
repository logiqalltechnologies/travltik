// 1. Search submit logic
$('#go').onclick = () => {
  const qVal = ($('#q') ? $('#q').value.trim() : '');
  if (qVal) {
    window.location.href = '/find-experts?search=' + encodeURIComponent(qVal);
  } else {
    drawRes();
    const resEl = document.getElementById('res');
    if (resEl) resEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
};
const qInp = $('#q');
if (qInp) {
  qInp.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      $('#go').click();
    }
  });
}

// 2. Marquee chip click handler
document.addEventListener('click', (e) => {
  const mc = e.target.closest('.mc');
  if (mc && mc.dataset.visa) {
    e.preventDefault();
    const q = $('#q');
    if (q) q.value = mc.dataset.visa;
    const destSel = document.querySelector('.sfm select');
    if (destSel && mc.dataset.dest) {
      for (let i = 0; i < destSel.options.length; i++) {
        if (destSel.options[i].text.toLowerCase().includes(mc.dataset.dest.toLowerCase())) {
          destSel.selectedIndex = i;
          break;
        }
      }
    }
    const searchSection = document.getElementById('search');
    if (searchSection) searchSection.scrollIntoView({ behavior: 'smooth' });
    drawRes();
  }
});

// 3. Interactive community chat sending
const cinForm = $('#cin-form'), cinInput = $('#cin-input');
if (cinForm && cinInput) {
  cinForm.onsubmit = (e) => {
    e.preventDefault();
    const text = cinInput.value.trim();
    if (!text) return;
    cinInput.value = '';
    const userMsgHtml = `<div class="m me">${av(0,34)}<div class="b"><small>You</small>${text}</div></div>`;
    const ms = $('#ms');
    ms.insertAdjacentHTML('beforeend', userMsgHtml);
    ms.scrollTop = ms.scrollHeight;
    
    const ty = $('#ty');
    if (ty) ty.style.visibility = 'visible';
    setTimeout(() => {
      if (ty) ty.style.visibility = 'hidden';
      const replies = [
        "Great question! Make sure to verify your documents in the vault first.",
        "Yes! Many expats in this group have done this. Check the guide or ask a verified consultant.",
        "Thanks for sharing! You can also check our classifieds and community threads.",
        "Confirmed! We recommend booking a 15-min discovery call with a licensed consultant."
      ];
      const botReply = replies[Math.floor(Math.random() * replies.length)];
      const botMsgHtml = `<div class="m">${av(1,34)}<div class="b"><small>Consultant<span class="bdg">Verified</span></small>${botReply}</div></div>`;
      ms.insertAdjacentHTML('beforeend', botMsgHtml);
      ms.scrollTop = ms.scrollHeight;
    }, 1100);
  };
}

// 4. Topic clicks in community
$$('.app .sd .ch').forEach(ch => {
  ch.style.cursor = 'pointer';
  ch.addEventListener('click', () => {
    const topic = ch.textContent.trim().toLowerCase();
    if (topic.includes('jobs')) window.location.href = '/jobs';
    else if (topic.includes('visa')) window.location.href = '/find-experts';
  });
});

// 5. Newsletter form
const nlForm = $('#nl-form');
if (nlForm) {
  nlForm.onsubmit = (e) => {
    e.preventDefault();
    const btn = $('#nl-btn'), inp = $('#nl-email');
    if (inp && inp.value) {
      btn.textContent = 'Subscribed! ✓';
      btn.style.background = '#008f5a';
      inp.value = '';
      setTimeout(() => { btn.textContent = 'Subscribe'; btn.style.background = ''; }, 3500);
    }
  };
}

