function openMobileSearchSheet() {
  if (!mobSearchOverlay) return;
  mobSearchOverlay.classList.add('open');
  document.body.classList.add('mob-search-open');
  
  // Sync category tab with active page category
  mobSelectedCategory = activeAirbnbTab || 'all';
  mobSheetTabs.forEach(t => {
