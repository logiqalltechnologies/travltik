    if (cur === 'Jobs') {
      const jParams = new URLSearchParams();
      if (qVal) {
        jParams.set('search', qVal);
        jParams.set('q', qVal);
      }
      if (destVal && destVal !== 'All Countries') {
        jParams.set('country', destVal);
        jParams.set('destination', destVal);
      }
      window.location.href = '/jobs' + (jParams.toString() ? '?' + jParams.toString() : '');
      return;
    }

    if (cur === 'Tours') {
      window.location.href = '/tours' + (qVal ? '?search=' + encodeURIComponent(qVal) : '');
      return;
    }

    if (cur === 'Stays') {
      window.location.href = '/find-experts?category=Housing' + (destVal ? '&destination=' + encodeURIComponent(destVal) : '');
      return;
    }

    // Experts tab
    const params = new URLSearchParams();
    if (qVal) {
      params.set('q', qVal);
