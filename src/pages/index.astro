<!-- Airbnb Unified Header -->
<header class="airbnb-header-wrap" id="hd">
  <div class="airbnb-header-inner">
    <!-- Row 1: Logo | Category Tabs | User Pill -->
    <div class="airbnb-top-row">
      <div class="airbnb-logo">
        <a href="/"><img src="/logo.png?v=16" alt="TravlTik" /></a>
      </div>

      <!-- Center Category Navigation (Airbnb Desktop Style) -->
      <nav class="airbnb-desktop-cat-nav" aria-label="Categories">
        <ul class="airbnb-cat-tabs">
          <li>
            <button type="button" class="airbnb-cat-tab active" data-tab="all">
              <span class="tab-icon">🌎</span>
              <span>All</span>
            </button>
          </li>
          <li>
            <button type="button" class="airbnb-cat-tab" data-tab="experts">
              <span class="tab-icon">⚖️</span>
              <span>Experts</span>
            </button>
          </li>
          <li>
            <button type="button" class="airbnb-cat-tab" data-tab="jobs">
              <span class="tab-icon">💼</span>
              <span>Jobs</span>
            </button>
          </li>
          <li>
            <button type="button" class="airbnb-cat-tab" data-tab="universities">
              <span class="tab-icon">🎓</span>
              <span>Universities</span>
            </button>
          </li>
          <li>
            <button type="button" class="airbnb-cat-tab" data-tab="tours">
              <span class="tab-icon">✈️</span>
              <span>Tours</span>
            </button>
          </li>
          <li>
            <button type="button" class="airbnb-cat-tab" data-tab="offers">
              <span class="tab-icon">🏷️</span>
              <span>Offers</span>
            </button>
          </li>
        </ul>
      </nav>

      <!-- Right Side Actions -->
      <div class="airbnb-right-box">
        <a href="/support" class="airbnb-host-link" title="Contact Us & 24/7 Support">Contact</a>
        <button type="button" class="airbnb-user-pill-btn" id="airbnb-user-pill-btn" aria-label="User Menu" aria-haspopup="true">
          <svg class="i" style="width:16px;height:16px;"><use href="#menu"/></svg>
          <div class="airbnb-user-avatar" id="home-user-avatar-circle">
            <svg id="home-user-default-icon" class="i" style="width:16px;height:16px;color:#fff"><use href="#user-check"/></svg>
            <span id="home-user-avatar-letters" style="display:none;color:#fff;font-weight:700;font-size:12px;"></span>
          </div>
        </button>

        <!-- Dropdown Menu -->
        <div class="airbnb-dropdown-menu" id="airbnb-dropdown-menu">
          <!-- 1. Logged Out View -->
          <div id="home-menu-logged-out" style="display:flex;flex-direction:column;">
            <div style="padding:4px 6px;">
              <a href="/signup" class="bold-link" style="color:#00b070;font-weight:800;">Sign up</a>
              <a href="/login" style="color:#1b1233;font-weight:600;">Log in</a>
            </div>
            <div class="airbnb-dropdown-divider"></div>
            <div style="padding:2px 6px;">
              <a href="/find-experts"><span>👨‍⚖️</span><span>Find Verified Experts</span></a>
              <a href="/ai-tools"><span>⚡</span><span>AI Immigration Tools</span></a>
              <a href="/jobs"><span>💼</span><span>International Jobs</span></a>
              <a href="/universities"><span>🎓</span><span>Global Universities</span></a>
              <a href="/escrow"><span>🔒</span><span>Milestone Escrow Protection</span></a>
            </div>
            <div class="airbnb-dropdown-divider"></div>
            <div style="padding:2px 6px 4px;">
              <a href="/support"><span>💬</span><span>Help &amp; Support</span></a>
            </div>
          </div>

          <!-- 2. Logged In View -->
          <div id="home-menu-logged-in" style="display:none;flex-direction:column;">
            <div style="padding:10px 14px;border-bottom:1px solid #ede9f6;background:#faf8fc;border-radius:14px 14px 0 0;">
              <div style="font-size:10px;color:#8b82a3;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;">Signed in as</div>
              <div id="home-menu-username" style="font-size:13px;font-weight:800;color:#1b1233;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">User</div>
            </div>
            <div style="padding:4px 6px;">
              <a id="home-menu-dashboard-link" href="/traveller/dashboard"><span>📊</span><span>My Dashboard</span></a>
              <a href="/find-experts"><span>👨‍⚖️</span><span>Find Verified Experts</span></a>
              <a href="/ai-tools"><span>⚡</span><span>AI Immigration Tools</span></a>
              <a href="/support"><span>💬</span><span>Help &amp; Support</span></a>
            </div>
            <div class="airbnb-dropdown-divider"></div>
            <div style="padding:2px 6px 4px;">
              <button id="home-menu-logout-btn" type="button" style="display:flex;align-items:center;gap:10px;width:calc(100% - 12px);margin:2px 6px;padding:8px 14px;font-size:13px;color:#e11d48;font-weight:700;border-radius:12px;background:none;border:none;cursor:pointer;text-align:left;">
                <span>🚪</span><span>Log out</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Row 2: Centered Floating Search Pill Bar -->
    <div class="airbnb-search-bar-row">
      <div class="airbnb-pill-search">
        <!-- Field 1: Service -->
        <div class="airbnb-pill-segment">
          <div class="pill-label-row">
            <svg class="i pill-segment-icon"><use href="#search"/></svg>
            <label for="q">Service</label>
          </div>
          <input type="text" id="q" placeholder="e.g. Canada Student Visa" autocomplete="off" />
        </div>

        <div class="airbnb-pill-divider"></div>

        <!-- Field 2: Destination -->
        <div class="airbnb-pill-segment c-drop" id="pill-dest-drop">
