// 3. Interactive community chat sending
const cinForm = $('#cin-form'), cinInput = $('#cin-input');
if (cinForm && cinInput) {
  cinForm.onsubmit = (e) => {
    e.preventDefault();
    const text = cinInput.value.trim();
    if (!text) return;
    cinInput.value = '';
    const userMsgHtml = `<div class="m me">${av(0,34)}<div class="b"><small>You</small>${text}</div></div>`;
    const ms = $('#ms');
    ms.insertAdjacentHTML('beforeend', userMsgHtml);
    ms.scrollTop = ms.scrollHeight;
    
    const ty = $('#ty');
    if (ty) ty.style.visibility = 'visible';
    setTimeout(() => {
      if (ty) ty.style.visibility = 'hidden';
      const replies = [
        "Great question! Make sure to verify your documents in the vault first.",
        "Yes! Many expats in this group have done this. Check the guide or ask a verified consultant.",
        "Thanks for sharing! You can also check our classifieds and community threads.",
        "Confirmed! We recommend booking a 15-min discovery call with a licensed consultant."
      ];
      const botReply = replies[Math.floor(Math.random() * replies.length)];
      const botMsgHtml = `<div class="m">${av(1,34)}<div class="b"><small>Consultant<span class="bdg">Verified</span></small>${botReply}</div></div>`;
      ms.insertAdjacentHTML('beforeend', botMsgHtml);
      ms.scrollTop = ms.scrollHeight;
    }, 1100);
  };
}

