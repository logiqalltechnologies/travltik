// Quick Search Submit Logic
const executeQsSearch = () => {
  const query = ($('#qs-query') ? $('#qs-query').value.trim() : '');
  const destination = ($('#qs-dest-val') ? $('#qs-dest-val').value : 'All Countries');
  const locationVal = ($('#qs-location') ? $('#qs-location').value.trim() : '');
  const category = ($('#qs-cat-val') ? $('#qs-cat-val').value : 'All Categories');

  // 1. JOBS: Redirect to /jobs
  if (activeQsTab === 'jobs' || category === 'Work Visa' || category === 'Work Permit') {
    const params = new URLSearchParams();
    if (query) {
      params.set('q', query);
      params.set('search', query);
    }
    if (destination && destination !== 'All Countries') {
      params.set('country', destination);
      params.set('destination', destination);
    }
    if (locationVal) {
      params.set('location', locationVal);
    }
    window.location.href = '/jobs' + (params.toString() ? '?' + params.toString() : '');
    return;
  }

  // 2. UNIVERSITIES: Redirect to /universities
  if (activeQsTab === 'universities' || category === 'Student Visa') {
    const params = new URLSearchParams();
    if (query) {
      params.set('q', query);
      params.set('search', query);
    }
    if (destination && destination !== 'All Countries') {
      params.set('country', destination);
      params.set('destination', destination);
    }
    if (locationVal) {
      params.set('location', locationVal);
    }
    window.location.href = '/universities' + (params.toString() ? '?' + params.toString() : '');
    return;
  }

  // 3. INSURANCE: Redirect to insurance experts & services
  if (activeQsTab === 'insurance') {
    window.location.href = '/find-experts?q=Insurance';
    return;
  }

  // 4. CONSULTANT / ALL SERVICES / LAWYERS: Redirect to /find-experts
  const params = new URLSearchParams();
  if (query) {
    params.set('q', query);
    params.set('search', query);
  }
  if (destination && destination !== 'All Countries') {
    params.set('destination', destination);
    params.set('country', destination);
  }
  if (locationVal) {
    params.set('location', locationVal);
    params.set('city', locationVal);
  }
  if (activeQsTab === 'lawyers') {
    params.set('category', 'Visa Appeals');
    params.set('service', 'Immigration Lawyer');
  } else if (category && category !== 'All Categories') {
    params.set('category', category);
  }

  window.location.href = '/find-experts' + (params.toString() ? '?' + params.toString() : '');
};

const qsBtn = $('#qs-search-btn');
