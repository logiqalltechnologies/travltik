// Airbnb User Dropdown Menu Toggle & Auth Sync
const userPillBtn = document.getElementById('airbnb-user-pill-btn');
const userMenu = document.getElementById('airbnb-dropdown-menu');
if (userPillBtn && userMenu) {
  userPillBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    userMenu.classList.toggle('open');
  });
  document.addEventListener('click', (e) => {
    if (!userMenu.contains(e.target) && !userPillBtn.contains(e.target)) {
      userMenu.classList.remove('open');
    }
  });

  // Sync Auth State
  function syncHomeAuth() {
    const seekerFirst = localStorage.getItem('seeker_firstName');
    const expertBusiness = localStorage.getItem('expert_businessName');
    const userStr = localStorage.getItem('travltik_user');
    const isLoggedIn = Boolean(seekerFirst || expertBusiness || (userStr && userStr !== 'null' && userStr !== 'undefined'));

    const loggedOutView = document.getElementById('home-menu-logged-out');
    const loggedInView = document.getElementById('home-menu-logged-in');
    const usernameEl = document.getElementById('home-menu-username');
    const dashLink = document.getElementById('home-menu-dashboard-link');
    const avatarLetters = document.getElementById('home-user-avatar-letters');
    const defaultIcon = document.getElementById('home-user-default-icon');

    if (isLoggedIn) {
      let displayName = 'User';
      let displayLetters = 'U';
      let dashboardHref = '/traveller/dashboard';

      if (expertBusiness) {
        displayName = expertBusiness;
        displayLetters = expertBusiness.charAt(0).toUpperCase();
        dashboardHref = '/service-provider/dashboard';
      } else if (seekerFirst) {
        displayName = seekerFirst + ' ' + (localStorage.getItem('seeker_lastName') || '');
        displayLetters = seekerFirst.charAt(0).toUpperCase();
        dashboardHref = '/traveller/dashboard';
      } else if (userStr) {
        try {
          const u = JSON.parse(userStr);
          if (u?.displayName) {
            displayName = u.displayName;
            displayLetters = u.displayName.charAt(0).toUpperCase();
          } else if (u?.email) {
            displayName = u.email;
            displayLetters = u.email.charAt(0).toUpperCase();
          }
          if (u?.type === 'expert') dashboardHref = '/service-provider/dashboard';
        } catch(e) {}
      }

      if (loggedOutView) loggedOutView.style.display = 'none';
      if (loggedInView) loggedInView.style.display = 'flex';
      if (usernameEl) usernameEl.textContent = displayName;
      if (dashLink) dashLink.setAttribute('href', dashboardHref);
      if (defaultIcon) defaultIcon.style.display = 'none';
      if (avatarLetters) {
        avatarLetters.style.display = 'block';
        avatarLetters.textContent = displayLetters;
      }
      const mobAccLink = document.getElementById('mobile-bar-account-link');
      const mobAccSpan = document.getElementById('mobile-bar-account-label');
      if (mobAccLink) mobAccLink.setAttribute('href', dashboardHref);
      if (mobAccSpan) mobAccSpan.textContent = 'Account';
    } else {
      if (loggedOutView) loggedOutView.style.display = 'flex';
      if (loggedInView) loggedInView.style.display = 'none';
      if (defaultIcon) defaultIcon.style.display = 'block';
      if (avatarLetters) avatarLetters.style.display = 'none';
      const mobAccLink = document.getElementById('mobile-bar-account-link');
      const mobAccSpan = document.getElementById('mobile-bar-account-label');
      if (mobAccLink) mobAccLink.setAttribute('href', '/login');
      if (mobAccSpan) mobAccSpan.textContent = 'Log in';
    }
  }

  const logoutBtn = document.getElementById('home-menu-logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      localStorage.removeItem('travltik_user');
      localStorage.removeItem('seeker_firstName');
      localStorage.removeItem('seeker_lastName');
      localStorage.removeItem('seeker_profilePhoto');
      localStorage.removeItem('expert_businessName');
      localStorage.removeItem('expert_profilePhoto');
      window.location.href = '/login';
    });
  }

  syncHomeAuth();
  document.addEventListener('astro:page-load', syncHomeAuth);
}

