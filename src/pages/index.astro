    const qVal = ($('#q') ? $('#q').value.trim() : '');
    const destVal = ($('#dest-val') ? $('#dest-val').value : 'Canada');
    const fromVal = ($('#from-val') ? $('#from-val').value : 'India');

    if (cur === 'Visas') {
      const destSlugMap = {
        'Canada': 'canada',
        'United Kingdom': 'uk',
        'Australia': 'australia',
        'UAE': 'uae',
        'Germany': 'germany',
        'Japan': 'japan'
      };
      const countrySlug = destSlugMap[destVal] || (destVal ? destVal.toLowerCase().replace(/\s+/g, '-') : 'canada');
      const purpose = qVal || 'Express Entry PR';
      window.location.href = `/visa/${encodeURIComponent(countrySlug)}?passport=${encodeURIComponent(fromVal)}&from=${encodeURIComponent(fromVal)}&purpose=${encodeURIComponent(purpose)}`;
      return;
