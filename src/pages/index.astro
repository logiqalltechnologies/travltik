// Custom search dropdowns logic
function initCustomDropdown(dropId, valInputId, textSpanId) {
  const drop = $(dropId);
  if (!drop) return;
  const btn = drop.querySelector('.c-drop-trigger, .qs-drop-trigger');
  const valInput = $(valInputId);
  const textSpan = $(textSpanId);

  if (btn) {
    btn.onclick = (e) => {
      e.stopPropagation();
      const isOpen = drop.classList.contains('open');
      $$('.c-drop').forEach(d => d.classList.remove('open'));
      if (!isOpen) drop.classList.add('open');
    };
  }

  drop.querySelectorAll('.c-drop-opt').forEach(opt => {
    opt.onclick = (e) => {
      e.stopPropagation();
      const val = opt.dataset.v;
      const flag = opt.dataset.f;
      const icon = opt.dataset.icon;
      if (valInput) valInput.value = val;
      if (textSpan) {
        if (flag) {
          textSpan.innerHTML = `<img src="https://flagcdn.com/w40/${flag}.png" class="flag-icon" alt="${val}"> <span>${val}</span>`;
        } else if (icon) {
          textSpan.innerHTML = `<span class="flag-icon" style="font-size:16px">${icon}</span> <span>${val}</span>`;
        } else if (val === 'All Countries') {
          textSpan.innerHTML = `<svg class="i qs-fld-icon"><use href="#globe"/></svg> <span>All Countries</span>`;
        } else if (val === 'All Categories') {
          textSpan.innerHTML = `<svg class="i qs-fld-icon"><use href="#file"/></svg> <span>All Categories</span>`;
        } else {
          textSpan.innerHTML = `<span>${val}</span>`;
        }
      }
      drop.querySelectorAll('.c-drop-opt').forEach(o => o.classList.remove('on'));
      opt.classList.add('on');
      drop.classList.remove('open');
    };
  });
}

