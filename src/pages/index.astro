---
// src/pages/index.astro
---
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>TravlTik — Move abroad. Pay safely. Land confident.</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,500;1,9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
<style is:global>
:root{--g:#00b070;--g2:#008f5a;--g3:#00c985;--gl:#e2f7ee;--gl2:#f1fbf6;--p:#430f7a;--p2:#6b34b3;--p3:#9a6bdc;--l1:#f7f2fe;--l2:#eee3fc;--l3:#dccaf7;--l4:#c4a6f0;--ink:#1b1233;--mut:#675f80;--line:rgba(67,15,122,.1);--sh:0 24px 50px -28px rgba(67,15,122,.35);--r:24px}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--ink);background:#fff;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{text-decoration:none;color:inherit}button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}input,select{font:inherit}
svg.i{width:1em;height:1em;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
svg.i.f{fill:currentColor;stroke:none}
.wrap{max-width:1280px;margin:0 auto;padding:0 40px}
h1,h2,h3,h4,.sora{font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;letter-spacing:-.03em}
.grad{background:linear-gradient(95deg,var(--g) 0%,#2fa9a0 38%,var(--p2) 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.ser{font-family:'Fraunces',serif;font-style:italic;font-weight:600;letter-spacing:-.01em}
section{padding:96px 0;position:relative}
.eyebrow{display:inline-flex;align-items:center;gap:9px;font-size:12.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--p);background:var(--l2);padding:8px 16px;border-radius:99px;margin-bottom:20px}
.eyebrow:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--g);box-shadow:0 0 0 4px rgba(0,176,112,.2)}
.sh{max-width:700px;margin-bottom:56px}.sh.c{margin-inline:auto;text-align:center}
.sh h2{text-wrap:balance;font-size:46px;line-height:1.1;font-weight:800;margin-bottom:16px}.sh p{color:var(--mut);font-size:18px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:16px 30px;border-radius:99px;font-weight:700;font-size:15px;transition:.3s;white-space:nowrap;border:1.5px solid transparent}
.btn svg{font-size:18px;transition:.3s}.btn:hover svg.ar{transform:translateX(4px)}
.btn.g{background:linear-gradient(135deg,var(--g3),var(--g));color:#fff;box-shadow:0 14px 30px -12px rgba(0,176,112,.65)}.btn.g:hover{transform:translateY(-2px);box-shadow:0 20px 36px -12px rgba(0,176,112,.75)}
.btn.p{background:var(--p);color:#fff;box-shadow:0 14px 30px -14px rgba(67,15,122,.6)}.btn.p:hover{transform:translateY(-2px);background:#340c5f}
.btn.o{background:#fff;border-color:var(--l3);color:var(--p)}.btn.o:hover{border-color:var(--p);transform:translateY(-2px)}
.btn.w{background:#fff;color:var(--p)}.btn.w:hover{transform:translateY(-2px)}
.btn.s{padding:11px 22px;font-size:14px}
.gc{background:linear-gradient(#fff,#fff) padding-box,linear-gradient(140deg,rgba(0,176,112,.38),rgba(154,107,220,.38) 60%,rgba(67,15,122,.2)) border-box;border:1.5px solid transparent;border-radius:var(--r);box-shadow:var(--sh);transition:.35s cubic-bezier(.2,.7,.2,1)}
.lift:hover{transform:translateY(-8px);box-shadow:0 36px 60px -26px rgba(67,15,122,.45)}
.rv{opacity:0;transform:translateY(26px);transition:opacity .8s,transform .8s cubic-bezier(.2,.7,.2,1)}.rv.on{opacity:1;transform:none}
.pulse{width:9px;height:9px;border-radius:50%;background:var(--g);position:relative;flex:none}
.pulse:after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--g);animation:pl 1.8s infinite}
@keyframes pl{0%{transform:scale(1);opacity:.7}100%{transform:scale(3.2);opacity:0}}
@keyframes fl{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
@keyframes in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes mq{to{transform:translateX(-50%)}}@keyframes mq2{from{transform:translateX(-50%)}to{transform:none}}
@keyframes dash{to{stroke-dashoffset:-40}}
@keyframes spin{to{transform:rotate(360deg)}}
.bdg{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:700;padding:4px 10px;border-radius:99px;background:var(--gl);color:var(--g2);white-space:nowrap}
.bdg.p{background:var(--l2);color:var(--p)}.bdg svg{font-size:13px}
.av{border-radius:50%;flex:none;display:block}
/* Nav menu with dropdowns - 3-column flex layout (flex-1 justify-center) */
.nav-menu{display:flex;align-items:center;justify-content:center;flex:1;gap:6px;list-style:none;margin:0;padding:0;z-index:10}
.nav-item{position:relative;padding:10px 0}
.nav-link{display:inline-flex;align-items:center;gap:4px;font-weight:600;font-size:14px;color:#352c50;padding:7px 12px;border-radius:99px;transition:.2s;text-decoration:none;white-space:nowrap}
.nav-link:hover, .nav-item:hover .nav-link{color:var(--g2);background:var(--l1)}
.nav-link.planner-link{color:var(--g2);font-weight:800}
.nav-link svg.chv{width:12px;height:12px;transition:transform .2s;color:#7e749a}
.nav-item:hover .nav-link svg.chv{transform:rotate(180deg);color:var(--g2)}
.nav-drop{position:absolute;top:100%;left:50%;transform:translateX(-50%) translateY(8px);min-width:240px;background:#fff;border-radius:18px;border:1px solid var(--line);box-shadow:0 18px 40px -12px rgba(67,15,122,.22);padding:8px;opacity:0;visibility:hidden;transition:.2s cubic-bezier(.2,.7,.2,1);z-index:100;pointer-events:none}
.nav-item:hover .nav-drop{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0);pointer-events:auto}
.nav-drop a{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:10px;font-size:13.5px;font-weight:600;color:#352c50;text-decoration:none;transition:.15s;white-space:nowrap}
.nav-drop a:hover{background:var(--l1);color:var(--g2);transform:translateX(3px)}
@media(max-width:1120px){.nav-menu{display:none}.burger{display:flex}}
/* top bar + header */
.tb{background:linear-gradient(90deg,var(--l2),var(--l1) 50%,var(--gl));font-size:13px;font-weight:600;color:var(--p);overflow:hidden}
.tb .wrap{display:flex;justify-content:space-between;align-items:center;height:42px;gap:14px;white-space:nowrap}
.tb a, .tb span{display:inline-flex;gap:8px;align-items:center;color:inherit;text-decoration:none;white-space:nowrap}
.tb .r{display:flex;gap:24px;align-items:center}
.tb svg{color:var(--g2);flex-shrink:0}
.tb .mid{background:#fff;padding:4px 14px;border-radius:99px;box-shadow:0 4px 14px -8px rgba(67,15,122,.4);display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
@media(max-width:900px){
  .tb .hide, .tb .mid{display:none !important}
  .tb .wrap{justify-content:space-between;padding:0 20px}
  .tb .r{gap:16px}
}
@media(max-width:600px){
  .tb{font-size:12px;height:38px}
  .tb .wrap{height:38px;padding:0 16px;justify-content:space-between}
  .tb .hide, .tb .mid{display:none !important}
  .tb .r{gap:12px}
}
@media(max-width:380px){
  .tb .r-lang{display:none !important}
  .tb .wrap{justify-content:center}
}
header{position:sticky;top:0;z-index:60;background:rgba(255,255,255,.82);backdrop-filter:blur(18px) saturate(1.4);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;height:82px;position:relative}.nav>a{flex-shrink:0;position:relative;z-index:2;display:flex;align-items:center}.nav img{height:44px;display:block}
.links{display:flex;gap:6px;background:var(--l1);padding:6px;border-radius:99px;border:1px solid var(--line)}
.links a{font-weight:600;font-size:14px;color:#4b4268;padding:9px 16px;white-space:nowrap;border-radius:99px;transition:.25s}.links a:hover,.links a.on{background:#fff;color:var(--p);box-shadow:0 6px 16px -8px rgba(67,15,122,.5)}
.nr{flex-shrink:0;display:flex;gap:12px;align-items:center;position:relative;z-index:2}.nr .lg{white-space:nowrap;font-weight:700;font-size:14.5px;color:var(--p);padding:10px 14px}
.burger{display:none;width:46px;height:46px;border-radius:50%;background:var(--l2);font-size:21px;align-items:center;justify-content:center;color:var(--p)}
.mm{display:none;padding:6px 0 20px}.mm.o{display:block}.mm a{display:block;padding:14px 2px;font-weight:700;border-bottom:1px solid var(--line)}
/* hero */
.hero{padding:34px 0 140px;background:radial-gradient(900px 500px at 85% 0%,var(--l2),transparent 70%),radial-gradient(700px 500px at 0% 30%,var(--gl2),transparent 70%),#fff;overflow:hidden}
.blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.55;pointer-events:none}
.blob.a{width:420px;height:420px;background:var(--g);opacity:.25;right:-80px;top:80px}.blob.b{width:460px;height:460px;background:var(--p3);opacity:.32;right:240px;bottom:-60px}.blob.c{width:300px;height:300px;background:#6fe0b4;opacity:.3;left:-100px;top:340px}
.hg{display:grid;grid-template-columns:1fr 1.04fr;gap:20px;align-items:center;position:relative;z-index:2}
.live{display:inline-flex;align-items:center;gap:12px;background:rgba(255,255,255,.85);backdrop-filter:blur(10px);border:1px solid var(--line);padding:7px 18px 7px 8px;border-radius:99px;font-size:13.5px;font-weight:700;color:var(--p);box-shadow:0 10px 26px -14px rgba(67,15,122,.45);margin-bottom:26px}
.avs{display:flex}.avs .av{border:2.5px solid #fff;margin-left:-9px}.avs .av:first-child{margin-left:0}
.hero h1{font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;font-size:64px;line-height:1.03;font-weight:800;margin-bottom:20px}
.hero h1 .hi{position:relative;display:inline-block}.hero h1 .hi svg{position:absolute;left:0;bottom:-10px;width:100%;height:16px}
.hero .lead{font-size:18.5px;color:var(--mut);max-width:540px;margin-bottom:32px}
.hb{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:28px}
.chips{display:grid;grid-template-columns:1fr 1fr;gap:12px 14px;max-width:560px}
.tc{display:flex;gap:12px;align-items:center;font-size:13.5px;font-weight:700;line-height:1.3}.tc i{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:#fff;color:var(--g2);font-size:19px;box-shadow:0 8px 18px -10px rgba(67,15,122,.5);border:1px solid var(--line);flex:none}.tc small{display:block;font-weight:500;color:var(--mut);font-size:12px}
.hv{position:relative;height:580px}
.map{position:absolute;left:-60px;top:122px;width:800px}
.glass{position:absolute;background:rgba(255,255,255,.74);backdrop-filter:blur(16px) saturate(1.5);border:1px solid rgba(255,255,255,.9);border-radius:22px;box-shadow:0 30px 60px -28px rgba(67,15,122,.5),0 0 0 1px rgba(67,15,122,.06)}
.f1{animation:fl 6s ease-in-out infinite}.f2{animation:fl 7s ease-in-out -2s infinite}.f3{animation:fl 8s ease-in-out -4s infinite}
.cA{right:0;top:-16px;width:280px;padding:18px}
.cA .t{display:flex;gap:13px;align-items:center}.cA b{display:block;font-size:15px;line-height:1.25}.cA small{font-size:12px;color:var(--mut)}
.cA .mt{display:flex;justify-content:space-between;align-items:center;margin-top:14px;padding-top:13px;border-top:1px dashed var(--l3);font-size:12.5px;font-weight:700}
.stars{color:#00b070;display:inline-flex;gap:1px;font-size:13px}.stars svg{width:1em;height:1em}
.cB{left:0;bottom:0;width:296px;padding:18px 20px}
.cB h4{font-size:15px;font-weight:700;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}.cB .sub{font-size:12.5px;color:var(--mut);margin-bottom:14px}
.mbar{display:flex;gap:5px;height:12px;margin-bottom:14px}.mbar i{border-radius:99px;background:var(--l2);position:relative;overflow:hidden}.mbar i.d{background:linear-gradient(90deg,var(--g),var(--g3))}.mbar i.h:after{content:"";position:absolute;inset:0;width:55%;background:linear-gradient(90deg,var(--p3),var(--p2));border-radius:99px}
.ml{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:600;padding:7px 0}.ml em{font-style:normal;margin-left:auto;font-size:12px;font-weight:700;color:var(--mut)}
.ml i{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-size:12px;font-style:normal;font-weight:800;background:var(--gl);color:var(--g2)}.ml.h i{background:var(--l2);color:var(--p)}.ml.l i{background:#f1eef6;color:#a39db7}
.cC{right:0;bottom:22px;width:286px;padding:0;display:flex;overflow:hidden;border-radius:20px}
.cC .a{flex:1;padding:16px 16px 16px 18px}.cC .k{width:86px;padding:16px 10px;border-left:2px dashed var(--l3);text-align:center;display:flex;flex-direction:column;justify-content:center;gap:6px;position:relative;background:linear-gradient(180deg,var(--gl),rgba(255,255,255,.4))}
.cC .k:before,.cC .k:after{content:"";position:absolute;left:-10px;width:18px;height:18px;border-radius:50%;background:#f4effb}.cC .k:before{top:-10px}.cC .k:after{bottom:-10px}
.cC small{font-size:10px;font-weight:800;letter-spacing:.12em;color:var(--mut);text-transform:uppercase;display:block}.cC .rt{display:flex;align-items:center;gap:8px;font-family:Sora;font-weight:800;font-size:22px;margin:3px 0 8px}.cC .rt svg{color:var(--g);font-size:20px}
.stamp{position:absolute;left:40px;top:6px;width:128px;height:128px;transform:rotate(-14deg);opacity:.95}
.pin{position:absolute;display:flex;align-items:center;gap:7px;background:#fff;border-radius:99px;padding:5px 12px 5px 6px;font-size:12px;font-weight:700;box-shadow:0 10px 22px -10px rgba(67,15,122,.55);white-space:nowrap}.pin i{width:20px;height:20px;border-radius:50%;background:var(--g);display:block;position:relative}.pin i:after{content:"";position:absolute;inset:6px;border-radius:50%;background:#fff}
/* stats */
.stats{margin-top:-80px;position:relative;z-index:5}
.sg{display:grid;grid-template-columns:repeat(5,1fr);padding:34px 18px;background:linear-gradient(#fff,#fff) padding-box,linear-gradient(120deg,rgba(0,176,112,.5),rgba(154,107,220,.5)) border-box;border:1.5px solid transparent;border-radius:30px;box-shadow:0 40px 80px -40px rgba(67,15,122,.5)}
.sg div{text-align:center;padding:4px 10px;border-right:1px dashed var(--l3)}.sg div:last-child{border:0}
.sg b{display:block;font-family:Sora;font-size:40px;font-weight:800;letter-spacing:-.04em;line-height:1.1}.sg div>span{font-size:13.5px;color:var(--mut);font-weight:600}
/* marquee */
.mqs{padding:70px 0 20px;overflow:hidden}
.mq{display:flex;gap:14px;width:max-content;animation:mq 60s linear infinite;margin-bottom:14px}.mq.r{animation:mq2 70s linear infinite}
.mc{display:inline-flex;align-items:center;gap:10px;padding:11px 20px 11px 12px;border-radius:99px;background:#fff;border:1px solid var(--line);font-weight:700;font-size:14px;box-shadow:0 8px 20px -14px rgba(67,15,122,.4);white-space:nowrap}
.mc i{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-style:normal;font-size:10.5px;font-weight:800;color:#fff;background:linear-gradient(135deg,var(--g),var(--p3))}.mc small{color:var(--mut);font-weight:600;font-size:12.5px}
.mc.alt{background:var(--l1)}.mc.alt i{background:linear-gradient(135deg,var(--p3),var(--p))}
/* search */
.srch{background:linear-gradient(180deg,#fff,var(--l1) 20%,var(--l1) 85%,#fff);padding-bottom:10px}
/* Easy Search (Top) */
.sbox{padding:30px 32px;border-radius:32px;background:#fff;border:1px solid var(--line);box-shadow:0 40px 80px -40px rgba(67,15,122,.28);margin-bottom:28px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
.tab{display:inline-flex;align-items:center;gap:9px;padding:10px 20px;border-radius:99px;font-weight:700;font-size:14px;color:#5a5174;background:var(--l1);border:1px solid transparent;transition:.25s;cursor:pointer}
.tab:hover{background:var(--l2)}
.tab.on{background:linear-gradient(135deg,var(--p2),var(--p));color:#fff;box-shadow:0 12px 22px -12px rgba(67,15,122,.8)}
.tab svg{font-size:16px;width:16px;height:16px}
.sfm{display:grid;grid-template-columns:1.5fr 1fr 1fr auto;gap:12px;align-items:stretch;padding:10px;border-radius:24px;background:var(--l1);border:1px solid var(--l2)}
@media(max-width:980px){.sfm{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.sfm{grid-template-columns:1fr}}
.fld{display:flex;align-items:center;gap:12px;background:#fff;border-radius:16px;padding:10px 18px;border:1.5px solid transparent;transition:.2s;position:relative}
.fld:hover{border-color:var(--p3)}
.fld:focus-within{border-color:var(--g)}
.fld>svg{color:var(--g2);font-size:20px;width:20px;height:20px;flex-shrink:0}
.fld label{display:block;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);line-height:1.2}
.fld input{border:0;outline:0;width:100%;font-weight:600;font-size:14.5px;background:transparent;color:var(--ink);padding:2px 0}
.sfm .btn{border-radius:16px;padding:0 34px}

/* Quick Search (Bottom) */
.qs-card{background:#fff;border-radius:32px;padding:32px 34px 28px;border:1px solid var(--line);box-shadow:0 30px 70px -30px rgba(67,15,122,.18),0 0 1px rgba(0,0,0,.06);font-family:'Plus Jakarta Sans',sans-serif;margin-top:6px}
.qs-header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;margin-bottom:22px}
.qs-title-wrap{display:flex;align-items:center;gap:14px}
.qs-icon-box{width:46px;height:46px;border-radius:16px;background:var(--gl);border:1px solid rgba(0,176,112,.2);display:flex;align-items:center;justify-content:center;color:var(--g2);flex-shrink:0}
.qs-icon-box svg{width:22px;height:22px;stroke-width:2.3}
.qs-heading-row{display:flex;align-items:center;gap:10px}
.qs-heading-row h3{font-size:22px;font-weight:800;color:var(--ink);letter-spacing:-0.02em;margin:0;line-height:1}
.qs-badge-live{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:99px;font-size:10px;font-weight:800;background:var(--gl);color:var(--g2);border:1px solid rgba(0,176,112,.25);letter-spacing:.06em}
.qs-badge-live .pulse-dot{width:6px;height:6px;border-radius:50%;background:var(--g);animation:pulse 1.8s infinite}
.qs-sub{font-size:13.5px;color:var(--mut);font-weight:500;margin:4px 0 0}
.qs-trust{display:flex;align-items:center;gap:16px;font-size:12.5px;font-weight:700;color:var(--mut)}
.qs-trust span{display:flex;align-items:center;gap:6px}
.qs-trust .dot{width:6px;height:6px;border-radius:50%;background:var(--g);display:inline-block}
@media(max-width:860px){.qs-trust{display:none}}

/* Category Tabs */
.qs-tabs{display:flex;align-items:center;gap:9px;border-bottom:1px solid var(--l2);padding-bottom:16px;margin-bottom:22px;overflow-x:auto;scrollbar-width:none}
.qs-tabs::-webkit-scrollbar{display:none}
.qs-tab{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:99px;font-size:13.5px;font-weight:700;color:#5a5174;background:var(--l1);border:1.5px solid transparent;cursor:pointer;white-space:nowrap;transition:all .2s ease;position:relative}
.qs-tab:hover{color:var(--ink);background:var(--l2);transform:translateY(-1px)}
.qs-tab.on{color:#fff;background:linear-gradient(135deg,var(--p2),var(--p));box-shadow:0 10px 22px -10px rgba(67,15,122,.75);border-color:transparent}
.qs-tab svg{width:16px;height:16px;transition:color .2s}
.qs-tab.on svg{color:#fff}

/* 4 Search Inputs Grid */
.qs-grid{display:grid;grid-template-columns:1.35fr 1fr 1fr 1fr;gap:14px;margin-bottom:24px}
@media(max-width:1020px){.qs-grid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.qs-grid{grid-template-columns:1fr}}
.qs-col{position:relative}
.qs-lbl{display:block;font-size:11.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);margin-bottom:8px}
.qs-lbl span{font-weight:600;text-transform:none;letter-spacing:0}
.qs-input-box, .qs-drop-box{background:#fff;border:1.5px solid var(--l3);border-radius:18px;height:54px;padding:0 16px;display:flex;align-items:center;gap:11px;transition:all .2s ease;position:relative}
