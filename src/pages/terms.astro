---
// src/pages/terms.astro
import Layout from '../layouts/Layout.astro';
import { Shield, Scale, AlertCircle, FileText, CheckCircle } from 'lucide-react';
---

<Layout 
  title="Terms & Conditions" 
  description="Terms of Service and Marketplace Rules for TravlTik - Global Immigration Marketplace."
>
  <div class="bg-gradient-to-b from-[#f8fafc] to-[#f1f5f9] min-h-screen py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      
      <!-- Premium Hero Section -->
      <div class="text-center mb-16 animate-fade-in">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-light border border-brand/20 text-xs font-bold text-brand mb-4">
          <Shield class="w-3.5 h-3.5" />
          <span>Legal Center</span>
        </div>
        <h1 class="font-sans text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-[-0.03em] mb-4 leading-tight">
          Terms &amp; Conditions
        </h1>
        <p class="font-sans text-sm sm:text-base text-slate-500 max-w-xl mx-auto font-medium">
          Please read these terms carefully. By using our platform, you agree to these commitments and liability limitations.
        </p>
      </div>

      <!-- Legal Document Layout -->
      <div class="bg-white rounded-3xl border border-slate-100 shadow-xl overflow-hidden p-6 sm:p-10 md:p-12 space-y-10">
        
        <!-- Important Alert Callout -->
        <div class="bg-amber-50/60 border border-amber-200 rounded-2xl p-5 sm:p-6 flex gap-4 items-start">
          <AlertCircle class="w-6 h-6 text-amber-600 shrink-0 mt-0.5" />
          <div>
            <h4 class="font-sans text-sm font-bold text-amber-900 mb-1">Important Disclaimer</h4>
            <p class="font-sans text-xs sm:text-sm text-amber-800 font-medium leading-relaxed">
              TravlTik acts as a directory and software marketplace connecting visa seekers with immigration consultants. We are not a legal firm, we do not guarantee visa approvals, and we do not represent either seekers or consultants in legal agreements.
            </p>
          </div>
        </div>

        <!-- Section 1: Escrow Protection Guarantee (Step 36) -->
        <div class="space-y-4">
          <h2 class="font-sans text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg bg-brand-light text-brand flex items-center justify-center text-xs font-bold shrink-0">1</span>
            Escrow Protection Guarantee
          </h2>
          <div class="pl-0 sm:pl-10 space-y-3 font-sans text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
            <p>
              When an applicant contracts a Verified Consultant through TravlTik with Escrow Protection, <strong>funds are processed through our secure, RBI-compliant payment partners (such as Razorpay)</strong>. TravlTik tracks milestones and authorises the release of funds only upon your approval of agreed documentation milestones:
            </p>
            <ul class="list-disc pl-5 space-y-1 text-slate-700">
              <li><strong>1st installment of payment:</strong> Verification of primary documents and applicant eligibility.</li>
              <li><strong>02nd installment of payment:</strong> Complete application filing, appointment booking, and submission preparation.</li>
              <li><strong>Final payment:</strong> Official consular acknowledgment receipt or embassy submission proof / decision.</li>
            </ul>
            <p class="text-xs italic text-slate-500 mt-2">
              (All milestone and payment percentages shall be decided and mutually agreed upon between the consultant and applicant before starting the process)
            </p>
            <p>
              If a consultant fails to deliver the promised milestones or verified submission receipts, remaining protected funds are eligible for prompt return in accordance with our milestone policy. TravlTik does not hold client funds directly in its own accounts; all payment processing is conducted via licensed third-party payment gateways.
            </p>
          </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Section 2: Third-Party Offers -->
        <div class="space-y-4">
          <h2 class="font-sans text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg bg-[#00b070]/10 text-[#00b070] flex items-center justify-center text-xs font-bold shrink-0">2</span>
            Discretion of Special Offers &amp; Packages
          </h2>
          <div class="pl-0 sm:pl-10 space-y-3 font-sans text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
            <p>
              Any special offers, package deals, marketing discounts, or promotions offered by third parties (including visa consultants or companies) featured on this website are offered <strong>strictly at that party's sole discretion and authority</strong>.
            </p>
            <p>
              The provider reserves the right to modify, restrict eligibility for, or withdraw any offer at any time. TravlTik does not guarantee the validity or availability of third-party promotions.
            </p>
          </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Section 3: Traveller Verification Responsibility -->
        <div class="space-y-4">
          <h2 class="font-sans text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg bg-[#00b070]/10 text-[#00b070] flex items-center justify-center text-xs font-bold shrink-0">3</span>
            Consultant Verification &amp; Traveller Due Diligence
          </h2>
          <div class="pl-0 sm:pl-10 space-y-3 font-sans text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
            <p>
              TravlTik conducts <strong>initial identity and licence verification</strong> for consultants listed on our platform, cross-referencing public registries including RCIC (Immigration Consultants of Canada Regulatory Council), MARA (Migration Agents Registration Authority), OISC (Office of the Immigration Services Commissioner), and equivalent licensing bodies. Only consultants who pass this initial check receive a "Licence verified" badge.
            </p>
            <p>
              However, users are strongly encouraged to <strong>independently verify credentials</strong> on official government registries before entering into any binding agreement or transferring funds, as licence statuses can change after our initial verification.
            </p>
            <p>
              TravlTik is not liable for any misrepresentation by consultants discovered after our initial verification process. Users retain the right to request a formal verification audit of any listed consultant through our Verification Request service (Section 4).
            </p>
          </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Section 4: Chargeable Verification Service -->
        <div class="space-y-4">
          <h2 class="font-sans text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg bg-[#00b070]/10 text-[#00b070] flex items-center justify-center text-xs font-bold shrink-0">4</span>
            TravlTik Verification Requests
          </h2>
          <div class="pl-0 sm:pl-10 space-y-3 font-sans text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
            <p>
              TravlTik will only verify a service, credential, or promotion offered by a third party <strong>when and if explicitly requested by a traveller</strong>.
            </p>
            <p>
              Please note that this is a <strong>separate chargeable service</strong>. When ordered, TravlTik will conduct a verification audit of the consultant's credentials, active registrations, or business standing and issue a report to the requesting seeker.
            </p>
          </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Section 5: Refunds & Payment Terms -->
        <div class="space-y-4">
          <h2 class="font-sans text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg bg-brand-light text-brand flex items-center justify-center text-xs font-bold shrink-0">5</span>
            Refund Policies &amp; Escrow Payments
          </h2>
          <div class="pl-0 sm:pl-10 space-y-3 font-sans text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
            <p>
              All payments made under our <strong>Escrow Protected Tiers</strong> are managed under strict fiduciary holding. Unreleased milestone balances remain secure in escrow until verified delivery. In the event of unfulfilled milestone deliverables, users are entitled to refund processing of unreleased balances.
            </p>
            <p>
              Direct external transactions arranged outside of TravlTik's official payment infrastructure are not protected by our escrow mechanism.
            </p>
          </div>
        </div>

      </div>

      <!-- Quick Action Back Link -->
      <div class="text-center mt-12">
        <a href="/" class="inline-flex items-center gap-2 bg-[#0c1a2e] hover:bg-[#0f2a40] text-white text-xs font-bold px-5 py-2.5 rounded-full shadow-lg transition-all" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
          Back to Home
        </a>
      </div>

    </div>
  </div>
</Layout>

