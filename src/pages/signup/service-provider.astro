---
// src/pages/signup/service-provider.astro
import Layout from '../../layouts/Layout.astro';
import { ExpertSignupPortal } from '../../components/interactive/ExpertSignupPortal';
---

<Layout 
  title="Sign Up as Service Provider — TravlTik" 
  description="Register as a service provider on TravlTik to consult clients and grow your global practice."
  hideHeader={true}
  hideFooter={true}
  hideWidgets={true}
>
  <!-- Executive Landing Page Background Canvas -->
  <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none select-none bg-[#fdfcff]" aria-hidden="true">
    <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-[#eee3fc]/80 blur-[90px]"></div>
    <div class="absolute top-1/4 -left-40 w-[550px] h-[550px] rounded-full bg-[#e2f7ee]/80 blur-[85px]"></div>
    <div class="absolute -bottom-24 right-1/4 w-[500px] h-[500px] rounded-full bg-[#dccaf7]/50 blur-[90px]"></div>
  </div>

  <!-- Transparent Soft Backdrop -->
  <div class="fixed inset-0 z-10 bg-slate-950/30 backdrop-blur-md pointer-events-none" aria-hidden="true"></div>

  <!-- Service Provider Registration Wizard -->
  <div class="relative z-30 min-h-screen overflow-y-auto">
    <div class="flex min-h-full items-center justify-center px-4 py-8 sm:py-12">
      <div class="w-full max-w-4xl">
        <ExpertSignupPortal client:load />
      </div>
    </div>
  </div>
</Layout>
