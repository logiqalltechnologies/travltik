---
// src/pages/job-drives.astro
import Layout from '../layouts/Layout.astro';
import { InternationalJobDrivesPage } from '../components/interactive/InternationalJobDrivesPage';
import { JobSchema } from '../components/seo/JobSchema';
---

<Layout 
  title="Official 2026 International Recruitment Drives | Canada LMIA & Luxembourg EU Work Permits" 
  description="100% verified employer recruitment drives with direct work permits, Canadian LMIA approvals, and Luxembourg EU work permit quotas. Apply with TravlTik Escrow."
>
  <JobSchema
    title="Official 2026 International Job Drives"
    description="Official 2026 overseas employer drives offering direct LMIA and EU work permit sponsorships."
    datePosted="2026-01-01"
    validThrough="2026-12-31"
    hiringOrganization="TravlTik Verified Global Recruitment Drives"
    country="Canada"
    currency="USD"
    minSalary={3220}
    maxSalary={5480}
  />
  
  <InternationalJobDrivesPage client:load />
</Layout>
