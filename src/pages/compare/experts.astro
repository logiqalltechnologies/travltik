---
// src/pages/compare/experts.astro
import Layout from '../../layouts/Layout.astro';
import { ExpertComparisonContainer } from '../../components/compare/ExpertComparisonContainer';

export const prerender = false;
---

<Layout 
  title="Side-by-Side Expert Comparison — TravlTik"
  description="Compare verified visa consultants, immigration lawyers, and agencies side-by-side. Compare licenses, success rates, hourly fees, and escrow protections."
>
  <div className="min-h-screen bg-slate-50/60 py-8 sm:py-12 flex flex-col items-center">
    <div className="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center">
      {/* Interactive Container */}
      <div className="w-full">
        <ExpertComparisonContainer client:load />
      </div>
    </div>
  </div>
</Layout>
