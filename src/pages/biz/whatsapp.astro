      <!-- Modal Body -->
      <div class="p-6 sm:p-8">
        
        <!-- STEP 1: Crawling Animation -->
        <div id="stage-crawling" class="flex flex-col items-center text-center py-6">
          <div class="relative w-20 h-20 mb-6 flex items-center justify-center">
            <div class="absolute inset-0 rounded-full border-4 border-slate-100"></div>
            <div class="absolute inset-0 rounded-full border-4 border-[#E34A32] border-t-transparent animate-spin"></div>
            <Globe class="w-8 h-8 text-[#E34A32]" />
          </div>
          <h4 class="text-xl font-bold text-slate-900" id="crawl-status-heading">Indexing your website...</h4>
          <p class="text-sm text-slate-500 mt-2 max-w-md" id="crawl-status-sub">
            Scanning pages, extracting services, pricing FAQs, and preparing vector embeddings.
          </p>

          <!-- Crawl Console logs simulation -->
          <div class="w-full max-w-md bg-slate-900 text-slate-200 rounded-2xl p-4 font-mono text-xs text-left mt-6 space-y-1.5 shadow-inner">
            <div id="log-1" class="text-emerald-400 flex items-center gap-1.5">
              <span>✓</span> <span id="log-url-text">Connecting to target website...</span>
            </div>
            <div id="log-2" class="text-slate-400 flex items-center gap-1.5">
              <span class="animate-pulse">⟳</span> <span>Parsing HTML content and sitemap...</span>
            </div>
            <div id="log-3" class="text-slate-500 hidden flex items-center gap-1.5">
              <span>✓</span> <span>Indexed 6 pages: Services, Contact, FAQs, Policies</span>
            </div>
            <div id="log-4" class="text-slate-500 hidden flex items-center gap-1.5">
              <span class="text-emerald-400 font-bold">✓</span> <span>Vector Embeddings generated successfully!</span>
            </div>
          </div>
        </div>

        <!-- STEP 2: Bot Ready & Summary -->
        <div id="stage-ready" class="hidden flex-col py-2 space-y-6">
          <div class="flex items-center gap-3 p-4 rounded-2xl bg-emerald-50 border border-emerald-200">
            <div class="w-10 h-10 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0 font-bold">✓</div>
            <div>
              <h4 class="text-sm font-bold text-emerald-950">Bot Knowledge Primed!</h4>
              <p class="text-xs text-emerald-700" id="ready-summary-text">Your website knowledge has been parsed and indexed into TravlTik Cloud.</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 text-left">
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs text-slate-500 font-medium">Assigned Bot Name</span>
              <p class="text-sm font-bold text-slate-900 mt-1" id="bot-display-name">AI Concierge</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs text-slate-500 font-medium">Pages Indexed</span>
              <p class="text-sm font-bold text-slate-900 mt-1">6 Core Pages</p>
            </div>
          </div>

          <button id="btn-proceed-to-qr" class="w-full py-3.5 rounded-full bg-[#171719] hover:bg-black text-white font-bold text-sm transition-all shadow-md cursor-pointer flex items-center justify-center gap-2">
            <span>Proceed to Connect WhatsApp</span>
            <ArrowRight class="w-4 h-4" />
          </button>
        </div>

        <!-- STEP 3: QR Code Connection -->
        <div id="stage-qr" class="hidden flex-col items-center text-center py-2 space-y-6">
          <div>
            <h4 class="text-xl font-bold text-slate-900">Pair Your WhatsApp Device</h4>
            <p class="text-xs text-slate-500 mt-1">Open WhatsApp on your phone &gt; Linked Devices &gt; Link a Device &gt; Scan this code</p>
          </div>

          <div class="relative p-4 bg-white border-2 border-dashed border-emerald-500/50 rounded-3xl shadow-sm flex flex-col items-center">
            <img id="modal-qr-img" src="https://api.qrserver.com/v1/create-qr-code/?size=190x190&data=TravlTikProWhatsAppBotSync" alt="WhatsApp QR Code" class="w-48 h-48 object-contain" />
            <div id="qr-live-badge" class="mt-3 flex items-center gap-1.5 text-xs text-emerald-600 font-bold">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Awaiting phone scan...</span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <button id="btn-modal-sim" class="px-5 py-2.5 rounded-full border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-xs transition-colors cursor-pointer">
              Simulate Instant Connection
            </button>
          </div>
        </div>

        <!-- STEP 4: Live & Active -->
        <div id="stage-live" class="hidden flex-col items-center text-center py-6 space-y-4">
          <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl font-extrabold shadow-sm">
            ✓
          </div>
          <h4 class="text-2xl font-bold text-slate-900">Your WhatsApp AI Bot is Live!</h4>
          <p class="text-sm text-slate-600 max-w-md">
            Any messages sent to your linked WhatsApp number will now be automatically answered with instant, accurate answers based on your website.
          </p>
          <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
            <button id="btn-done" class="px-8 py-3 rounded-full bg-[#171719] hover:bg-black text-white font-bold text-sm transition-all shadow-md cursor-pointer">
              Done &amp; Close
            </button>
          </div>
        </div>

      </div>

    </div>
