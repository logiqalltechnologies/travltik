      </div>

      <!-- Stepper Indicator -->
      <div class="bg-slate-50 border-b border-slate-200 px-6 py-3 flex items-center justify-between text-xs font-semibold">
        <div id="step-ind-1" class="flex items-center gap-1.5 text-[#E34A32]">
          <span class="w-5 h-5 rounded-full bg-[#E34A32] text-white flex items-center justify-center text-[10px] font-bold">1</span>
          <span>Crawl Website</span>
        </div>
        <span class="text-slate-300">→</span>
        <div id="step-ind-2" class="flex items-center gap-1.5 text-slate-400">
          <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px] font-bold">2</span>
          <span>Knowledge Index</span>
        </div>
        <span class="text-slate-300">→</span>
        <div id="step-ind-3" class="flex items-center gap-1.5 text-slate-400">
          <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px] font-bold">3</span>
          <span>Pair WhatsApp</span>
        </div>
