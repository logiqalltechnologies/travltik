---
// src/pages/biz/whatsapp.astro
import Layout from '../../layouts/Layout.astro';
import { 
  Zap, 
  MessageCircle, 
  Bot, 
  Sparkles, 
  Check, 
  ArrowRight, 
  Globe, 
  Clock, 
  BookOpen, 
  ShieldCheck, 
  UserCheck, 
  UserPlus, 
  MessageSquare, 
  Lock, 
  Headphones, 
  Cpu, 
  Sliders, 
  QrCode, 
  ArrowUpRight, 
  LayoutGrid,
  X,
  CreditCard,
  CheckCircle2,
  PhoneCall
} from 'lucide-react';

export const prerender = false;
---

<Layout title="Turn your website into a WhatsApp bot — TravlTik Pro">
  <!-- External Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,500;1,9..144,600&family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <!-- Razorpay Checkout Script -->
  <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <style is:global>
    :root {
      --brand-green: #00b070;
      --brand-green-dark: #008f5a;
      --brand-green-light: #e2f7ee;
      --brand-purple: #430f7a;
      --brand-ink: #1b1233;
    }
    .font-serif-accent {
      font-family: "Instrument Serif", "Fraunces", Georgia, serif;
      font-weight: 400;
      font-style: italic;
      letter-spacing: -0.01em;
    }
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(5deg); }
      50% { transform: translateY(-9px) rotate(8deg); }
    }
    @keyframes floatRev {
      0%, 100% { transform: translateY(0px) rotate(-5deg); }
      50% { transform: translateY(9px) rotate(-3deg); }
    }
    @keyframes floatSubtle {
      0%, 100% { transform: translateY(0px) rotate(2deg); }
      50% { transform: translateY(-7px) rotate(0deg); }
    }
    .animate-float-1 {
      animation: floatSlow 4.5s ease-in-out infinite;
    }
    .animate-float-2 {
      animation: floatRev 5s ease-in-out infinite;
    }
    .animate-float-3 {
      animation: floatSubtle 4s ease-in-out infinite;
    }
    .travltik-card-glow {
      background: linear-gradient(#fff, #fff) padding-box,
                  linear-gradient(135deg, rgba(0, 176, 112, 0.4), rgba(67, 15, 122, 0.25)) border-box;
      border: 1.5px solid transparent;
    }
  </style>

  <div class="bg-[#F8FAF9] text-[#1b1233] antialiased min-h-screen font-['Plus_Jakarta_Sans',sans-serif]">
    <div class="max-w-[1360px] mx-auto px-3 sm:px-6 pt-4 sm:pt-8 pb-24">
      
      <!-- ================= HERO ================= -->
      <section class="relative overflow-hidden rounded-[32px] sm:rounded-[44px] bg-white border border-slate-200/90 shadow-[0_20px_50px_-25px_rgba(0,176,112,0.18)] min-h-[88vh] flex flex-col justify-between p-6 sm:p-12 lg:p-16">
        
        <!-- Ambient Radial Gradient Blooms (TravlTik Green & Purple) -->
        <div
          class="pointer-events-none absolute -right-32 -top-20 h-[680px] w-[680px] rounded-full opacity-60 blur-3xl"
          style="background: radial-gradient(circle at 55% 45%, rgba(0,176,112,0.35), rgba(0,143,90,0.15) 45%, rgba(255,255,255,0) 70%);"
        ></div>
        <div
          class="pointer-events-none absolute -left-52 top-24 h-[640px] w-[640px] rounded-full opacity-50 blur-3xl"
          style="background: radial-gradient(circle at 50% 50%, rgba(67,15,122,0.2), rgba(107,52,179,0.08) 45%, rgba(255,255,255,0) 72%);"
        ></div>

        <!-- Geometric Angular Accent Facet (TravlTik Brand Green Facet) -->
        <div class="pointer-events-none absolute right-4 lg:right-16 top-10 lg:top-16 w-72 sm:w-96 lg:w-[480px] h-72 sm:h-96 lg:h-[480px] opacity-90 z-0">
          <svg viewBox="0 0 400 400" class="w-full h-full drop-shadow-[0_25px_45px_rgba(0,176,112,0.18)]">
            <polygon points="120,20 360,60 390,260 280,380 90,320 20,160" fill="url(#greenGrad)" opacity="0.85" />
            <polygon points="120,20 240,160 90,320 20,160" fill="#00b070" opacity="0.2" />
            <polygon points="360,60 390,260 240,160" fill="#008f5a" opacity="0.3" />
            <defs>
              <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#00c985" />
                <stop offset="60%" stop-color="#00b070" />
                <stop offset="100%" stop-color="#008f5a" />
              </linearGradient>
            </defs>
          </svg>
        </div>

        <!-- Top Eyebrow / Badges -->
        <div class="relative z-10 flex items-center justify-between mb-8 sm:mb-12">
          <div class="inline-flex items-center gap-2.5 rounded-full border border-emerald-500/20 bg-emerald-50 px-4 py-1.5 text-xs sm:text-sm font-extrabold text-[#008f5a] shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#00b070] animate-pulse"></span>
            <span>EXCLUSIVELY FOR TRAVLTIK SERVICE PROVIDERS &amp; CONSULTANTS</span>
          </div>

          <div class="hidden sm:flex items-center gap-4 text-xs sm:text-sm font-bold text-slate-600">
            <a href="#features" class="hover:text-[#00b070] transition-colors">Features</a>
            <span class="text-slate-300">•</span>
            <a href="#how" class="hover:text-[#00b070] transition-colors">How It Works</a>
            <span class="text-slate-300">•</span>
            <a href="#pricing" class="hover:text-[#00b070] transition-colors">Plans &amp; Pricing</a>
          </div>
        </div>

        <!-- HERO MAIN CONTENT -->
        <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center my-auto py-8 lg:py-16">
          
          <!-- Exact Headline with Floating Tiles -->
          <div class="relative w-full">
            <h1 class="text-5xl sm:text-7xl lg:text-8xl font-black leading-[1.02] tracking-[-0.035em] text-[#1b1233]">
              Turn your website<br />
              into a <span class="font-serif-accent text-[#00b070]">WhatsApp bot</span>
            </h1>

            <!-- Floating Tile 1: WhatsApp Icon -->
            <div class="animate-float-1 absolute -right-2 sm:right-6 lg:-right-12 -top-8 sm:-top-10 flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-white border border-slate-200/80 shadow-[0_18px_35px_-14px_rgba(0,176,112,0.3)]">
              <span class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-[#00b070] text-white shadow-sm">
                <MessageCircle class="h-5 w-5" />
              </span>
            </div>

            <!-- Floating Tile 2: Bot Icon -->
            <div class="animate-float-2 absolute -right-6 sm:right-0 lg:-right-24 top-24 sm:top-28 flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-white border border-slate-200/80 shadow-[0_18px_35px_-14px_rgba(67,15,122,0.3)]">
              <span class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-[#430f7a] text-white shadow-sm">
                <Bot class="h-5 w-5" />
              </span>
            </div>

            <!-- Floating Tile 3: Sparkles -->
            <div class="animate-float-3 absolute right-8 sm:right-16 lg:right-4 -bottom-10 sm:-bottom-12 flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-white border border-slate-200/80 shadow-[0_18px_35px_-14px_rgba(245,158,11,0.25)]">
              <span class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-amber-50 border border-amber-200 text-amber-600">
                <Sparkles class="h-5 w-5" />
              </span>
            </div>
          </div>

          <!-- Subtitle -->
          <p class="mt-8 sm:mt-10 max-w-xl text-base sm:text-lg leading-relaxed text-[#675f80] font-normal">
            Paste your consultancy website, choose your plan, connect WhatsApp, and let AI qualify visa leads, answer applicant queries, and schedule consultations 24/7.
          </p>

          <!-- Input Bar Form -->
          <div class="mt-8 sm:mt-10 w-full max-w-xl">
            <form id="hero-url-form" class="flex flex-col sm:flex-row gap-2.5 bg-white p-2.5 rounded-3xl sm:rounded-full border border-slate-300 shadow-[0_14px_35px_-12px_rgba(0,176,112,0.22)]">
              <input
                id="hero-url-input"
                type="text"
                required
                placeholder="Enter your consultancy website (e.g. visaexpert.com)"
                class="flex-1 bg-transparent px-5 py-3 text-sm sm:text-base outline-none text-[#1b1233] placeholder:text-slate-400 font-medium"
              />
              <button
                type="submit"
                id="hero-submit-btn"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#00c985] to-[#00b070] hover:from-[#00b070] hover:to-[#008f5a] px-8 py-3.5 text-sm sm:text-base font-bold text-white transition-all duration-200 hover:-translate-y-0.5 shadow-md shadow-emerald-500/25 active:scale-95 cursor-pointer shrink-0"
              >
                <span>Build My Bot</span>
                <ArrowRight class="h-4 w-4" />
              </button>
            </form>

            <div class="flex items-center justify-center gap-5 mt-3 text-xs text-[#675f80]">
              <span class="flex items-center gap-1.5 font-semibold">
                <Check class="h-3.5 w-3.5 text-[#00b070] stroke-[2.5]" />
                Instant Razorpay Setup
              </span>
              <span class="flex items-center gap-1.5 font-semibold">
                <Check class="h-3.5 w-3.5 text-[#00b070] stroke-[2.5]" />
                14-Day Money Back Guarantee
              </span>
            </div>
          </div>

          <!-- Social Proof Badges -->
          <div class="mt-12 sm:mt-16">
            <p class="text-xs font-extrabold uppercase tracking-widest text-slate-400">
              Designed for Verified TravlTik Service Providers across
            </p>
            <div class="mt-4 flex flex-wrap items-center justify-center gap-x-6 sm:gap-x-8 gap-y-2.5 text-slate-600 font-semibold text-sm sm:text-base">
              <span>Visa &amp; Immigration Firms</span>
              <span class="text-slate-300">•</span>
              <span>Study Abroad Consultants</span>
              <span class="text-slate-300">•</span>
              <span>Work Permit Advisors</span>
              <span class="text-slate-300">•</span>
              <span>Travel &amp; Tour Agencies</span>
              <span class="text-slate-300">•</span>
              <span>Legal &amp; Relocation Services</span>
            </div>
          </div>

        </div>

        <!-- Bottom Preview Bar -->
        <div class="relative z-10 flex items-center justify-between pt-6 border-t border-slate-100 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#00b070]"></span>
            <span class="font-bold text-slate-800">Official WhatsApp Cloud &amp; Baileys Powered</span>
          </div>
          <div class="hidden sm:flex items-center gap-1 font-semibold text-slate-600">
            <span>Average Setup:</span>
            <strong class="text-[#008f5a] font-bold">&lt; 3 minutes</strong>
          </div>
        </div>

      </section>

      <!-- ================= FEATURES ================= -->
      <section id="features" class="px-2 py-20 sm:py-28">
        <div class="max-w-2xl mb-12">
          <p class="text-xs font-extrabold text-[#008f5a] uppercase tracking-wider bg-emerald-50 px-3.5 py-1 rounded-full inline-block border border-emerald-200/60 mb-2">
            Features &amp; Capabilities
          </p>
          <h2 class="mt-2 text-3xl sm:text-5xl font-extrabold text-[#1b1233] tracking-[-0.03em] leading-tight">
            What your WhatsApp AI Agent does.
          </h2>
          <p class="mt-4 text-base sm:text-lg text-[#675f80]">
            Six powerful capabilities engineered to convert curious WhatsApp leads into paying customers while resolving support 24/7.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Card 1 -->
          <div class="travltik-card-glow rounded-3xl p-7 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-[#00b070]">
              <Globe class="h-6 w-6" />
            </span>
            <h3 class="mt-5 text-xl font-bold text-[#1b1233]">3-Minute Setup</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#675f80]">
              Paste your consultancy website URL. Our crawler indexes your visa services, packages, eligibility requirements, and guides to train your bot instantly.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">
              <Clock class="h-3.5 w-3.5 text-[#00b070]" />
              Live in 3 minutes
            </p>
          </div>

          <!-- Card 2 -->
          <div class="travltik-card-glow rounded-3xl p-7 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-purple-50 text-[#430f7a]">
              <BookOpen class="h-6 w-6" />
            </span>
            <h3 class="mt-5 text-xl font-bold text-[#1b1233]">Trained on Your Practice</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#675f80]">
              Trained on your visa fee schedules, eligibility criteria, required document checklists, and consultant FAQs with zero guesswork.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">
              <Check class="h-3.5 w-3.5 text-[#430f7a]" />
              Accurate visa answers
            </p>
          </div>

          <!-- Card 3 -->
          <div class="travltik-card-glow rounded-3xl p-7 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 text-teal-600">
              <ShieldCheck class="h-6 w-6" />
            </span>
            <h3 class="mt-5 text-xl font-bold text-[#1b1233]">Smart Guardrails</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#675f80]">
              Multi-layered scope defense strictly forbids math, coding, politics, and off-topic chat. Stays 100% on immigration & travel guidance.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">
              <Lock class="h-3.5 w-3.5 text-teal-600" />
              Zero hallucination guard
            </p>
          </div>

          <!-- Card 4 -->
          <div class="travltik-card-glow rounded-3xl p-7 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
              <UserCheck class="h-6 w-6" />
            </span>
            <h3 class="mt-5 text-xl font-bold text-[#1b1233]">Live Consultant Escalation</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#675f80]">
              Automatically flags urgent case assessments, rejection reviews, or premium clients and routes them directly to your phone.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">
              <Headphones class="h-3.5 w-3.5 text-blue-600" />
              Direct phone handoff
            </p>
          </div>

          <!-- Card 5 -->
          <div class="travltik-card-glow rounded-3xl p-7 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">
              <UserPlus class="h-6 w-6" />
            </span>
            <h3 class="mt-5 text-xl font-bold text-[#1b1233]">Lead &amp; Appointment Capture</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#675f80]">
              Collects applicant names, target countries, visa category, passport status, and appointment dates politely during conversation.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">
              <Zap class="h-3.5 w-3.5 text-amber-600" />
              Direct lead synchronization
            </p>
          </div>

          <!-- Card 6 -->
          <div class="travltik-card-glow rounded-3xl p-7 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-50 text-rose-600">
              <MessageSquare class="h-6 w-6" />
            </span>
            <h3 class="mt-5 text-xl font-bold text-[#1b1233]">24/7 Multilingual Support</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#675f80]">
              Responds day and night in English, Hindi, and natural Hinglish. Never miss an inquiry even when your team is asleep.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">
              <Clock class="h-3.5 w-3.5 text-rose-600" />
              99.9% uptime guaranteed
            </p>
          </div>
        </div>
      </section>

      <!-- ================= PRICING WITH RAZORPAY ================= -->
      <section id="pricing" class="px-2 pb-20 sm:pb-28">
        <div class="rounded-[36px] bg-white border border-slate-200 p-8 sm:p-14 shadow-sm">
          <div class="max-w-2xl mx-auto text-center mb-14">
            <p class="text-xs font-extrabold text-[#008f5a] uppercase tracking-wider bg-emerald-50 px-3.5 py-1 rounded-full inline-block border border-emerald-200/60 mb-2">
              Subscription Plans
            </p>
            <h2 class="text-3xl sm:text-5xl font-black text-[#1b1233] tracking-[-0.03em]">
              Pick the plan that fits.
            </h2>
            <p class="mt-3 text-base text-[#675f80]">
              Transparent pricing. Secured by Razorpay. 14-day money back guarantee. Cancel anytime.
            </p>
          </div>

          <div class="grid gap-6 lg:grid-cols-3 items-stretch">
            
            <!-- Starter Plan -->
            <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-xs flex flex-col justify-between hover:shadow-md transition-all">
              <div>
                <h3 class="text-2xl font-black text-[#1b1233]">Starter</h3>
                <p class="mt-1 text-xs text-slate-500 font-medium">For solo consultants &amp; independent visa advisors</p>
                <p class="mt-5 text-4xl font-black text-[#1b1233]">
                  $9 <span class="text-sm font-semibold text-slate-400">/ month</span>
                </p>
                <ul class="mt-6 space-y-3 text-sm text-[#675f80]">
                  <li class="flex items-center gap-2.5">
                    <Check class="h-4 w-4 text-[#00b070] shrink-0 stroke-[2.5]" />
                    <span>1 Connected WhatsApp number</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <Check class="h-4 w-4 text-[#00b070] shrink-0 stroke-[2.5]" />
                    <span>1,000 AI Conversations / month</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <Check class="h-4 w-4 text-[#00b070] shrink-0 stroke-[2.5]" />
                    <span>Website Crawl &amp; Visa Text Knowledge</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <Check class="h-4 w-4 text-[#00b070] shrink-0 stroke-[2.5]" />
                    <span>Standard Email &amp; Chat Support</span>
                  </li>
                </ul>
              </div>
              <button 
                class="btn-trigger-razorpay mt-8 w-full py-3.5 rounded-full border border-slate-300 hover:border-slate-800 font-bold text-sm text-slate-800 hover:bg-slate-50 transition-all flex items-center justify-center gap-2 cursor-pointer"
                data-plan="Starter Plan"
                data-amount="9"
              >
                <CreditCard class="w-4 h-4 text-[#00b070]" />
                <span>Activate Starter ($9)</span>
              </button>
            </div>

            <!-- Growth Plan (Featured Dark with Bright White Text) -->
            <div class="rounded-3xl bg-[#171719] p-8 text-white shadow-2xl flex flex-col justify-between border-2 border-[#00b070] relative scale-[1.02]">
              <div>
                <div class="flex items-center justify-between">
                  <h3 class="text-2xl font-black text-white">Growth</h3>
                  <span class="rounded-full bg-[#00b070] px-3 py-1 text-xs font-black uppercase tracking-wider text-white shadow-sm">
                    MOST POPULAR
                  </span>
                </div>
                <p class="mt-1 text-xs text-slate-300">For active immigration consultancies &amp; agencies</p>
                <p class="mt-5 text-4xl font-black text-white">
                  $19 <span class="text-sm font-semibold text-slate-400">/ month</span>
                </p>
                <ul class="mt-6 space-y-3 text-sm text-slate-200">
                  <li class="flex items-center gap-2.5">
                    <Check class="h-4 w-4 text-[#00b070] shrink-0 stroke-[2.5]" />
                    <span>3 Connected WhatsApp numbers</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <Check class="h-4 w-4 text-[#00b070] shrink-0 stroke-[2.5]" />
                    <span>10,000 AI Conversations / month</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <Check class="h-4 w-4 text-[#00b070] shrink-0 stroke-[2.5]" />
                    <span>Smart Guardrails &amp; Scope Shield</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <Check class="h-4 w-4 text-[#00b070] shrink-0 stroke-[2.5]" />
                    <span>Human Handoff &amp; Urgent Phone Alerts</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <Check class="h-4 w-4 text-[#00b070] shrink-0 stroke-[2.5]" />
                    <span>Priority WhatsApp VIP Support</span>
                  </li>
                </ul>
              </div>
              <button 
                class="btn-trigger-razorpay mt-8 w-full py-3.5 rounded-full bg-gradient-to-r from-[#00c985] to-[#00b070] hover:from-[#00b070] hover:to-[#008f5a] font-bold text-sm text-white transition-all shadow-lg shadow-emerald-500/30 flex items-center justify-center gap-2 cursor-pointer active:scale-95"
                data-plan="Growth Plan (Recommended)"
                data-amount="19"
              >
                <CreditCard class="w-4 h-4 text-white" />
                <span>Activate Growth Plan ($19) →</span>
              </button>
            </div>

            <!-- Pro / Scale Plan -->
            <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-xs flex flex-col justify-between hover:shadow-md transition-all">
              <div>
                <div class="flex items-center justify-between">
                  <h3 class="text-2xl font-black text-[#1b1233]">Pro Scale</h3>
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-700">
                    AGENCY &amp; MULTI-BRANCH
                  </span>
                </div>
                <p class="mt-1 text-xs text-slate-500 font-medium">For established immigration firms &amp; multi-branch agencies</p>
