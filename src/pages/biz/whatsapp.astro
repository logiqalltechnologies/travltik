      <!-- Modal Header -->
      <div class="bg-gradient-to-r from-[#171719] to-[#2E3034] text-white p-6 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#E34A32] flex items-center justify-center font-bold text-white shadow-sm">
            <Bot class="w-5 h-5" />
          </div>
          <div>
            <h3 class="text-lg font-bold text-white leading-tight" id="modal-title">WhatsApp Bot Creator</h3>
            <p class="text-xs text-slate-300" id="modal-subtitle">AI Website Crawler &amp; WhatsApp Sync</p>
          </div>
        </div>
        <button id="modal-close-btn" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors cursor-pointer" aria-label="Close modal">
