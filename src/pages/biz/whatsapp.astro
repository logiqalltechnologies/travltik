</Layout>

<script>
  // Dynamic Bot Builder & QR Controller
  const heroForm = document.getElementById('hero-url-form');
  const heroInput = document.getElementById('hero-url-input') as HTMLInputElement;
  const footerForm = document.getElementById('footer-url-form');
  const footerInput = document.getElementById('footer-url-input') as HTMLInputElement;

  const modal = document.getElementById('builder-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const btnDone = document.getElementById('btn-done');
  const openBuilderBtns = document.querySelectorAll('.open-builder-btn');

  // Stages
  const stageCrawling = document.getElementById('stage-crawling');
  const stageReady = document.getElementById('stage-ready');
  const stageQr = document.getElementById('stage-qr');
  const stageLive = document.getElementById('stage-live');

  // Stepper indicators
  const stepInd1 = document.getElementById('step-ind-1');
  const stepInd2 = document.getElementById('step-ind-2');
  const stepInd3 = document.getElementById('step-ind-3');

  const logUrlText = document.getElementById('log-url-text');
  const log2 = document.getElementById('log-2');
  const log3 = document.getElementById('log-3');
  const log4 = document.getElementById('log-4');

  const btnProceedQr = document.getElementById('btn-proceed-to-qr');
  const btnModalSim = document.getElementById('btn-modal-sim');
  const modalQrImg = document.getElementById('modal-qr-img') as HTMLImageElement;
  const botDisplayName = document.getElementById('bot-display-name');

  let currentCompanyId = 'pro_demo_consultant';

  function openBuilder(urlValue: string) {
    let clean = (urlValue || 'yourstore.com').trim();
    if (!clean.startsWith('http')) clean = 'https://' + clean;

    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    // Reset stages
    showStage('crawling');
    if (logUrlText) logUrlText.textContent = `Connecting to ${clean}...`;
    if (botDisplayName) {
      try {
        const domain = new URL(clean).hostname.replace(/^www\./, '');
        botDisplayName.textContent = `${domain.charAt(0).toUpperCase() + domain.slice(1)} AI Concierge`;
      } catch {
        botDisplayName.textContent = 'Store AI Concierge';
      }
    }

    // Simulate crawl progression
    setTimeout(() => {
      if (log3) log3.classList.remove('hidden');
    }, 1200);

    setTimeout(() => {
      if (log4) log4.classList.remove('hidden');
    }, 2400);

    setTimeout(() => {
      showStage('ready');
    }, 3200);
  }

  function showStage(stage: 'crawling' | 'ready' | 'qr' | 'live') {
    [stageCrawling, stageReady, stageQr, stageLive].forEach((s) => {
      if (s) {
        s.classList.add('hidden');
        s.classList.remove('flex');
      }
    });

    if (stage === 'crawling' && stageCrawling) {
      stageCrawling.classList.remove('hidden');
      stageCrawling.classList.add('flex');
      setStepActive(1);
    } else if (stage === 'ready' && stageReady) {
      stageReady.classList.remove('hidden');
      stageReady.classList.add('flex');
      setStepActive(2);
    } else if (stage === 'qr' && stageQr) {
      stageQr.classList.remove('hidden');
      stageQr.classList.add('flex');
      setStepActive(3);
      fetchLiveQr();
    } else if (stage === 'live' && stageLive) {
      stageLive.classList.remove('hidden');
      stageLive.classList.add('flex');
      setStepActive(3);
    }
  }

  function setStepActive(step: number) {
    if (stepInd1 && stepInd2 && stepInd3) {
      stepInd1.className = step >= 1 ? 'flex items-center gap-1.5 text-[#E34A32]' : 'flex items-center gap-1.5 text-slate-400';
      stepInd2.className = step >= 2 ? 'flex items-center gap-1.5 text-[#E34A32]' : 'flex items-center gap-1.5 text-slate-400';
      stepInd3.className = step >= 3 ? 'flex items-center gap-1.5 text-[#E34A32]' : 'flex items-center gap-1.5 text-slate-400';
    }
  }

  async function fetchLiveQr() {
    try {
      const res = await fetch('/api/whatsapp/connect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ company_id: currentCompanyId })
      });
      const data = await res.json();
      if (data.qrcode?.base64 && modalQrImg) {
        modalQrImg.src = data.qrcode.base64.startsWith('data:')
          ? data.qrcode.base64
          : `data:image/png;base64,${data.qrcode.base64}`;
      }
    } catch (e) {}
  }

  heroForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    openBuilder(heroInput?.value || 'store.com');
  });

  footerForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    openBuilder(footerInput?.value || 'store.com');
  });

  openBuilderBtns.forEach((btn) => {
    btn.addEventListener('click', () => openBuilder('yourwebsite.com'));
  });

  btnProceedQr?.addEventListener('click', () => {
    showStage('qr');
  });

  btnModalSim?.addEventListener('click', () => {
    showStage('live');
  });

  modalCloseBtn?.addEventListener('click', () => {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });

  btnDone?.addEventListener('click', () => {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });
</script>
