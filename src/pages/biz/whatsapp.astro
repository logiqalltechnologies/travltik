---
// src/pages/biz/whatsapp.astro
import Layout from '../../layouts/Layout.astro';
import { 
  Zap, 
  MessageCircle, 
  Bot, 
  Sparkles, 
  Check, 
  ArrowRight, 
  Globe, 
  Clock, 
  BookOpen, 
  ShieldCheck, 
  UserCheck, 
  UserPlus, 
  MessageSquare, 
  Lock, 
  Headphones, 
  Cpu, 
  Sliders, 
  QrCode, 
  ArrowUpRight, 
  LayoutGrid,
  X,
  Loader2,
  CheckCircle2
} from 'lucide-react';

export const prerender = false;
---

<Layout title="Turn any website into a WhatsApp bot — TravlTik AI Concierge">
  <!-- External Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style is:global>
    .font-serif-accent {
      font-family: "Instrument Serif", Georgia, serif;
      font-weight: 400;
      font-style: italic;
      letter-spacing: -0.01em;
    }
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(6deg); }
      50% { transform: translateY(-8px) rotate(8deg); }
    }
    @keyframes floatRev {
      0%, 100% { transform: translateY(0px) rotate(-6deg); }
      50% { transform: translateY(8px) rotate(-4deg); }
    }
    @keyframes floatSubtle {
      0%, 100% { transform: translateY(0px) rotate(3deg); }
      50% { transform: translateY(-6px) rotate(1deg); }
    }
    .animate-float-1 {
      animation: floatSlow 4.5s ease-in-out infinite;
    }
    .animate-float-2 {
      animation: floatRev 5s ease-in-out infinite;
    }
    .animate-float-3 {
      animation: floatSubtle 4s ease-in-out infinite;
    }
  </style>

  <div class="bg-[#ECEDEE] text-[#232427] antialiased min-h-screen font-['Inter',sans-serif]">
    <div class="max-w-[1440px] mx-auto px-2 sm:px-4 pt-3 sm:pt-6 pb-20">
      
      <!-- ================= HERO ================= -->
      <section class="relative overflow-hidden rounded-[28px] sm:rounded-[40px] bg-[#F4F5F5] shadow-[0_1px_0_rgba(255,255,255,0.9)_inset,0_20px_60px_-30px_rgba(35,36,39,0.25)] min-h-[90vh] flex flex-col justify-between p-6 sm:p-12 lg:p-16">
        
        <!-- Atmosphere radial blooms -->
        <div
          class="pointer-events-none absolute -right-32 -top-20 h-[680px] w-[680px] rounded-full opacity-70 blur-3xl"
          style="background: radial-gradient(circle at 55% 45%, rgba(227,74,50,0.55), rgba(240,120,70,0.28) 40%, rgba(244,245,245,0) 70%);"
        ></div>
        <div
          class="pointer-events-none absolute -left-52 top-24 h-[640px] w-[640px] rounded-full opacity-60 blur-3xl"
          style="background: radial-gradient(circle at 50% 50%, rgba(46,48,52,0.35), rgba(120,124,130,0.15) 45%, rgba(244,245,245,0) 72%);"
        ></div>

        <!-- Geometric Angular Accent Facet -->
        <div class="pointer-events-none absolute right-4 lg:right-16 top-12 lg:top-20 w-72 sm:w-96 lg:w-[480px] h-72 sm:h-96 lg:h-[480px] opacity-90 z-0">
          <svg viewBox="0 0 400 400" class="w-full h-full drop-shadow-[0_25px_50px_rgba(227,74,50,0.25)]">
            <polygon points="120,20 360,60 390,260 280,380 90,320 20,160" fill="url(#coralGrad)" opacity="0.85" />
            <polygon points="120,20 240,160 90,320 20,160" fill="#E34A32" opacity="0.25" />
            <polygon points="360,60 390,260 240,160" fill="#C93A24" opacity="0.3" />
            <defs>
              <linearGradient id="coralGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#F26A4F" />
                <stop offset="60%" stop-color="#E34A32" />
                <stop offset="100%" stop-color="#C2331D" />
              </linearGradient>
            </defs>
          </svg>
        </div>

        <!-- Top Mini Navigation / Announcement -->
        <div class="relative z-10 flex items-center justify-between mb-8 sm:mb-12">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/80 bg-white/85 px-4 py-1.5 text-xs sm:text-sm font-semibold text-[#E34A32] shadow-xs backdrop-blur-md">
            <Zap class="h-4 w-4" />
            <span>AI-Powered WhatsApp Support</span>
          </div>

          <div class="hidden sm:flex items-center gap-3 text-xs sm:text-sm font-semibold text-slate-600">
            <a href="#features" class="hover:text-slate-900 transition-colors">Features</a>
            <span class="text-slate-300">•</span>
            <a href="#how" class="hover:text-slate-900 transition-colors">How It Works</a>
            <span class="text-slate-300">•</span>
            <a href="#use-cases" class="hover:text-slate-900 transition-colors">Use Cases</a>
            <span class="text-slate-300">•</span>
            <a href="#pricing" class="hover:text-slate-900 transition-colors">Pricing</a>
          </div>
        </div>

        <!-- HERO CONTENT -->
        <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center my-auto py-8 lg:py-16">
          
          <!-- Headline with Floating Tiles -->
          <div class="relative w-full">
            <h1 class="text-5xl sm:text-7xl lg:text-8xl font-bold leading-[1.02] tracking-[-0.035em] text-[#2E3034]">
              Turn any website<br />
              into a <span class="font-serif-accent text-[#2E3034]">WhatsApp bot</span>
            </h1>

            <!-- Floating Tile 1: WhatsApp Icon -->
            <div class="animate-float-1 absolute -right-2 sm:right-6 lg:-right-12 -top-8 sm:-top-10 flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-white border border-black/5 shadow-[0_18px_35px_-14px_rgba(35,36,39,0.35)]">
              <span class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-emerald-500 text-white shadow-sm">
                <MessageCircle class="h-5 w-5" />
              </span>
            </div>

            <!-- Floating Tile 2: Bot Icon -->
            <div class="animate-float-2 absolute -right-6 sm:right-0 lg:-right-24 top-24 sm:top-28 flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-white border border-black/5 shadow-[0_18px_35px_-14px_rgba(35,36,39,0.35)]">
              <span class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm">
                <Bot class="h-5 w-5" />
              </span>
            </div>

            <!-- Floating Tile 3: Sparkles -->
            <div class="animate-float-3 absolute right-8 sm:right-16 lg:right-4 -bottom-10 sm:-bottom-12 flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-white border border-black/5 shadow-[0_18px_35px_-14px_rgba(35,36,39,0.35)]">
              <span class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-[#F7F7F5] border border-black/10 text-[#E34A32]">
                <Sparkles class="h-5 w-5" />
              </span>
            </div>
          </div>

          <!-- Subtitle -->
          <p class="mt-8 sm:mt-10 max-w-xl text-base sm:text-lg leading-relaxed text-[#55575c] font-normal">
            Paste your URL, connect WhatsApp, and let AI handle customer support 24/7. No coding required. Live in 3 minutes.
          </p>

          <!-- Input Bar Form -->
          <div class="mt-8 sm:mt-10 w-full max-w-xl">
            <form id="hero-url-form" class="flex flex-col sm:flex-row gap-2.5 bg-white/95 p-2 sm:p-2.5 rounded-3xl sm:rounded-full border border-black/10 shadow-[0_1px_0_rgba(255,255,255,0.9)_inset,0_10px_26px_-10px_rgba(35,36,39,0.25)] backdrop-blur">
              <input
                id="hero-url-input"
                type="text"
                required
                placeholder="Enter your website (e.g. yourstore.com)"
                class="flex-1 bg-transparent px-5 py-3 text-sm sm:text-base outline-none text-[#232427] placeholder:text-[#8a8c91]"
              />
              <button
                type="submit"
                id="hero-submit-btn"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-[#171719] hover:bg-black px-7 py-3.5 text-sm sm:text-base font-medium text-white transition-all duration-200 hover:-translate-y-0.5 shadow-[0_1px_0_rgba(255,255,255,0.25)_inset,0_12px_24px_-10px_rgba(23,23,25,0.75)] cursor-pointer shrink-0"
              >
                <span>Build My Bot</span>
                <ArrowRight class="h-4 w-4" />
              </button>
            </form>

            <div class="flex items-center justify-center gap-5 mt-3 text-xs text-[#8a8c91]">
              <span class="flex items-center gap-1.5 font-medium">
                <Check class="h-3.5 w-3.5 text-emerald-600 stroke-[2.5]" />
                No credit card required
              </span>
              <span class="flex items-center gap-1.5 font-medium">
                <Check class="h-3.5 w-3.5 text-emerald-600 stroke-[2.5]" />
                14-day free trial
              </span>
            </div>
          </div>

          <!-- Social Proof Badges -->
          <div class="mt-12 sm:mt-16">
            <p class="text-xs font-bold uppercase tracking-widest text-[#8a8c91]">
              Trusted by 500+ businesses across
            </p>
            <div class="mt-4 flex flex-wrap items-center justify-center gap-x-6 sm:gap-x-8 gap-y-2.5 text-[#55575c]">
              <span class="text-sm sm:text-base font-semibold opacity-75">Dental Clinics</span>
              <span class="text-slate-300">•</span>
              <span class="text-sm sm:text-base font-semibold opacity-75">E-Commerce Stores</span>
              <span class="text-slate-300">•</span>
              <span class="text-sm sm:text-base font-semibold opacity-75">Immigration & Travel</span>
              <span class="text-slate-300">•</span>
              <span class="text-sm sm:text-base font-semibold opacity-75">Real Estate</span>
              <span class="text-slate-300">•</span>
              <span class="text-sm sm:text-base font-semibold opacity-75">Local Services</span>
            </div>
          </div>

        </div>

        <!-- Bottom Preview Badge -->
        <div class="relative z-10 flex items-center justify-between pt-6 border-t border-black/5 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="font-semibold text-slate-700">Official WhatsApp Cloud & Baileys Compatible</span>
          </div>
          <div class="hidden sm:flex items-center gap-1 font-medium">
            <span>Setup time:</span>
            <strong class="text-slate-800 font-bold">&lt; 3 minutes</strong>
          </div>
        </div>

      </section>

      <!-- ================= FEATURES (6 CARDS) ================= -->
      <section id="features" class="px-4 py-20 sm:py-28">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold text-[#E34A32] uppercase tracking-wider">Features</p>
          <h2 class="mt-3 text-3xl sm:text-5xl font-bold leading-tight text-[#2E3034] tracking-[-0.03em]">
            What your WhatsApp AI Agent does.
          </h2>
          <p class="mt-4 text-base sm:text-lg leading-relaxed text-[#55575c]">
            Six powerful capabilities engineered to convert curious WhatsApp leads into paying customers while resolving support 24/7.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Card 1 -->
          <div class="group rounded-3xl border border-black/5 bg-white p-7 shadow-[0_1px_0_rgba(255,255,255,0.9)_inset,0_14px_30px_-18px_rgba(35,36,39,0.25)] hover:-translate-y-1 hover:shadow-[0_24px_44px_-18px_rgba(35,36,39,0.3)] transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#F4F5F5] border border-black/5 text-[#E34A32]">
              <Globe class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-slate-900">3-Minute Setup</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#55575c]">
              Paste your website URL. Our crawler indexes your catalog, services, and policies and trains your bot instantly.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-[#F4F5F5] px-3 py-1.5 text-xs font-semibold text-[#55575c]">
              <Clock class="h-3.5 w-3.5" />
              Live in 3 minutes
            </p>
          </div>

          <!-- Card 2 -->
          <div class="group rounded-3xl border border-black/5 bg-white p-7 shadow-[0_1px_0_rgba(255,255,255,0.9)_inset,0_14px_30px_-18px_rgba(35,36,39,0.25)] hover:-translate-y-1 hover:shadow-[0_24px_44px_-18px_rgba(35,36,39,0.3)] transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#F4F5F5] border border-black/5 text-[#E34A32]">
              <BookOpen class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-slate-900">Trained on Your Business</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#55575c]">
              Paste custom pricing, warranties, returns, and FAQs. The bot answers with exact accuracy without guessing.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-[#F4F5F5] px-3 py-1.5 text-xs font-semibold text-[#55575c]">
              <Check class="h-3.5 w-3.5" />
              No PDF bugs · Pure text
            </p>
          </div>

          <!-- Card 3 -->
          <div class="group rounded-3xl border border-black/5 bg-white p-7 shadow-[0_1px_0_rgba(255,255,255,0.9)_inset,0_14px_30px_-18px_rgba(35,36,39,0.25)] hover:-translate-y-1 hover:shadow-[0_24px_44px_-18px_rgba(35,36,39,0.3)] transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#F4F5F5] border border-black/5 text-[#E34A32]">
              <ShieldCheck class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-slate-900">Smart Guardrails</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#55575c]">
              Multi-layered scope defense strictly forbids math, coding, politics, and off-topic chat. Stays 100% on business.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-[#F4F5F5] px-3 py-1.5 text-xs font-semibold text-[#55575c]">
              <Lock class="h-3.5 w-3.5" />
              Zero hallucination guard
            </p>
          </div>

          <!-- Card 4 -->
          <div class="group rounded-3xl border border-black/5 bg-white p-7 shadow-[0_1px_0_rgba(255,255,255,0.9)_inset,0_14px_30px_-18px_rgba(35,36,39,0.25)] hover:-translate-y-1 hover:shadow-[0_24px_44px_-18px_rgba(35,36,39,0.3)] transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#F4F5F5] border border-black/5 text-[#E34A32]">
              <UserCheck class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-slate-900">Human Handoff</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#55575c]">
              Automatically flags urgent issues or refund requests and routes the customer directly to your phone number.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-[#F4F5F5] px-3 py-1.5 text-xs font-semibold text-[#55575c]">
              <Headphones class="h-3.5 w-3.5" />
              Live agent escalation
            </p>
          </div>

          <!-- Card 5 -->
          <div class="group rounded-3xl border border-black/5 bg-white p-7 shadow-[0_1px_0_rgba(255,255,255,0.9)_inset,0_14px_30px_-18px_rgba(35,36,39,0.25)] hover:-translate-y-1 hover:shadow-[0_24px_44px_-18px_rgba(35,36,39,0.3)] transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#F4F5F5] border border-black/5 text-[#E34A32]">
              <UserPlus class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-slate-900">Lead &amp; Appointment Capture</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#55575c]">
              Gathers customer names, booking dates, and specific requirements politely during natural conversation.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-[#F4F5F5] px-3 py-1.5 text-xs font-semibold text-[#55575c]">
              <Zap class="h-3.5 w-3.5" />
              Automatic CRM capture
            </p>
          </div>

          <!-- Card 6 -->
          <div class="group rounded-3xl border border-black/5 bg-white p-7 shadow-[0_1px_0_rgba(255,255,255,0.9)_inset,0_14px_30px_-18px_rgba(35,36,39,0.25)] hover:-translate-y-1 hover:shadow-[0_24px_44px_-18px_rgba(35,36,39,0.3)] transition-all duration-300">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#F4F5F5] border border-black/5 text-[#E34A32]">
              <MessageSquare class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-slate-900">24/7 Multilingual Support</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#55575c]">
              Responds day and night in English, Hindi, and natural Hinglish. Never miss an inquiry even when your team is asleep.
            </p>
            <p class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-[#F4F5F5] px-3 py-1.5 text-xs font-semibold text-[#55575c]">
              <Clock class="h-3.5 w-3.5" />
              99.9% uptime guaranteed
            </p>
          </div>
        </div>
      </section>

      <!-- ================= PROOF STATS ================= -->
      <section class="px-4 pb-20 sm:pb-28">
        <div class="rounded-[32px] bg-[#F7F7F5] border border-white p-8 sm:p-12 shadow-[0_1px_0_rgba(255,255,255,0.9)_inset,0_20px_50px_-30px_rgba(35,36,39,0.3)]">
          <div class="flex flex-col lg:flex-row items-center gap-6">
            <div class="flex-1 rounded-full border border-black/5 bg-white px-8 py-7 text-center shadow-sm w-full">
              <p class="text-4xl font-bold text-[#2E3034] sm:text-5xl">
                3 <span class="text-[#E34A32]">min</span>
              </p>
              <p class="mt-1.5 text-sm sm:text-base text-[#55575c]">
                average time to launch your bot
              </p>
            </div>

            <div class="flex-1 rounded-full border border-black/5 bg-white px-8 py-7 text-center shadow-md w-full lg:scale-105">
              <p class="text-4xl font-bold text-[#2E3034] sm:text-5xl">
                90<span class="text-[#E34A32]">%</span>
              </p>
              <p class="mt-1.5 text-sm sm:text-base text-[#55575c]">
                customer queries resolved automatically
              </p>
            </div>

            <div class="flex-1 rounded-full border border-black/5 bg-white px-8 py-7 text-center shadow-sm w-full">
              <p class="text-4xl font-bold text-[#2E3034] sm:text-5xl">
                24<span class="text-[#E34A32]">/7</span>
              </p>
              <p class="mt-1.5 text-sm sm:text-base text-[#55575c]">
                always-on customer support without extra staff
              </p>
            </div>
          </div>
          <p class="mt-8 text-center text-xs text-[#8a8c91]">
            Real-world metrics observed across 500+ active business deployments on WhatsApp.
          </p>
        </div>
      </section>

      <!-- ================= HOW IT WORKS ================= -->
      <section id="how" class="px-4 pb-20 sm:pb-28">
        <div class="max-w-2xl mb-12">
          <p class="text-sm font-semibold text-[#E34A32] uppercase tracking-wider">How It Works</p>
          <h2 class="mt-3 text-3xl sm:text-5xl font-bold leading-tight text-[#2E3034] tracking-[-0.03em]">
            From website to WhatsApp in 3 simple steps.
          </h2>
        </div>

        <div class="rounded-[36px] bg-[#171719] p-6 sm:p-10 text-white shadow-2xl">
          <div class="grid gap-6 lg:grid-cols-3">
            
            <div class="rounded-[28px] border border-white/10 bg-[#202024] p-8 lg:col-span-2">
              <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1 text-xs font-semibold text-emerald-400 mb-4">
                Step 1
              </span>
              <h3 class="text-2xl font-bold text-white">Automatic Website Crawl</h3>
              <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed max-w-lg">
                Just drop your website URL. Our crawler scans your product pages, catalog, and service details, converting them into instant vector knowledge.
              </p>
            </div>

            <div class="rounded-[28px] border border-white/10 bg-[#202024] p-8 flex flex-col justify-center items-center text-center">
              <span class="rounded-full bg-[#E34A32] px-3.5 py-1.5 text-xs font-bold text-white shadow-lg">
                10x Faster
              </span>
              <p class="mt-4 text-3xl font-extrabold text-white">&lt; 0.8s</p>
              <p class="mt-2 text-xs text-slate-400">Instant sub-second response on customer queries</p>
            </div>

            <div class="rounded-[28px] border border-white/10 bg-[#202024] p-8 lg:col-span-2">
              <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1 text-xs font-semibold text-amber-400 mb-4">
                Step 2
              </span>
              <h3 class="text-2xl font-bold text-white">Custom Identity, Pricing &amp; FAQs</h3>
              <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed max-w-lg">
                Give your bot a human name, set your tone, paste rate cards, and configure human escalation numbers in seconds.
              </p>
            </div>

            <div class="rounded-[28px] border border-white/10 bg-[#202024] p-8 flex flex-col justify-between">
              <div>
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1 text-xs font-semibold text-blue-400 mb-4">
                  Step 3
                </span>
                <h3 class="text-2xl font-bold text-white">Scan QR &amp; Go Live</h3>
                <p class="mt-2 text-sm text-slate-300 leading-relaxed">
                  Pair your official WhatsApp Business number via QR code and your AI assistant begins answering immediately.
                </p>
              </div>
              <div class="mt-6 flex items-center gap-2 text-xs text-emerald-400 font-semibold">
                <CheckCircle2 class="w-4 h-4" />
                <span>Zero technical setup required</span>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- ================= PRICING ================= -->
      <section id="pricing" class="px-4 pb-20 sm:pb-28">
        <div class="rounded-[36px] bg-[#F7F7F5] border border-white p-8 sm:p-14 shadow-sm">
