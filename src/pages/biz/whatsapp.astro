<script>
  // Controller: Website submission -> Plan Selection -> Razorpay Checkout -> QR Link
  let enteredWebsiteUrl = 'yourconsultancy.com';

  const heroUrlForm = document.getElementById('hero-url-form');
  const heroUrlInput = document.getElementById('hero-url-input') as HTMLInputElement;
  const footerUrlForm = document.getElementById('footer-url-form');
  const footerUrlInput = document.getElementById('footer-url-input') as HTMLInputElement;

  const planModal = document.getElementById('plan-modal');
  const planModalCloseBtn = document.getElementById('plan-modal-close-btn');
  const planModalUrlSubtitle = document.getElementById('plan-modal-url-subtitle');

  const btnModalPayGrowth = document.getElementById('btn-modal-pay-growth');
  const btnModalPayStarter = document.getElementById('btn-modal-pay-starter');
  const btnModalPayPro = document.getElementById('btn-modal-pay-pro');
  const directPricingPayBtns = document.querySelectorAll('.btn-trigger-razorpay');

  const postPayModal = document.getElementById('post-pay-modal');
  const postPayModalClose = document.getElementById('post-pay-modal-close');
  const activeQrImg = document.getElementById('active-qr-img') as HTMLImageElement;
  const btnSimulatePaired = document.getElementById('btn-simulate-paired');
  const btnPostPayDone = document.getElementById('btn-post-pay-done');
  const postPayStatusPill = document.getElementById('post-pay-status-pill');

  function openPlanModal(url: string) {
    enteredWebsiteUrl = (url || 'yourconsultancy.com').trim();
    if (planModalUrlSubtitle) {
      planModalUrlSubtitle.textContent = `Website: ${enteredWebsiteUrl}`;
    }
    if (planModal) {
      planModal.classList.remove('hidden');
      planModal.classList.add('flex');
    }
  }

  function closePlanModal() {
    if (planModal) {
      planModal.classList.add('hidden');
      planModal.classList.remove('flex');
    }
  }

  // Open Razorpay Checkout Modal
  async function launchRazorpay(planName: string, amountInDollars: number) {
    try {
      closePlanModal();

      const res = await fetch('/api/payment/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount: amountInDollars,
          currency: 'USD',
          plan: `WhatsApp Bot ${planName} ($${amountInDollars})`,
          selectedPurpose: enteredWebsiteUrl
        })
      });

      const orderData = await res.json();
      if (!orderData.success || !orderData.orderId) {
        alert('Payment initialization failed: ' + (orderData.error || 'Please try again.'));
        return;
      }
      const rzpKey = orderData.keyId || 'rzp_live_SXMX6RIgR8HDyH';

      const options = {
        key: rzpKey,
        amount: orderData.amount || amountInDollars * 100,
        currency: orderData.currency || 'USD',
        name: 'TravlTik Pro',
        description: `${planName} - WhatsApp AI Concierge ($${amountInDollars})`,
        image: '/logo.png?v=8',
        order_id: orderData.orderId,
        prefill: {
          name: 'Consultant',
          email: 'consultant@travltik.com',
          contact: '9876543210'
        },
        theme: {
          color: '#00b070'
        },
        handler: function (response: any) {
          console.log('[Razorpay Payment Success]', response);
          openPostPayModal();
        },
        modal: {
          ondismiss: function () {
            console.log('[Razorpay Modal Closed]');
          }
        }
      };

      if ((window as any).Razorpay) {
        const rzp = new (window as any).Razorpay(options);
        rzp.on('payment.failed', function (resp: any) {
          alert('Payment Notice: ' + (resp.error?.description || 'Could not complete payment'));
          // In test demo mode, still allow user to view QR scanner
          openPostPayModal();
        });
        rzp.open();
      } else {
        // Fallback if Razorpay CDN script was blocked by browser extension
        openPostPayModal();
      }
    } catch (e: any) {
      console.warn('[Launch Razorpay Exception]:', e);
      openPostPayModal();
    }
  }

  function openPostPayModal() {
    if (postPayModal) {
      postPayModal.classList.remove('hidden');
      postPayModal.classList.add('flex');
    }
    fetchLiveQr();
  }

  async function fetchLiveQr() {
    try {
      const res = await fetch('/api/whatsapp/connect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ company_id: `co_${enteredWebsiteUrl.replace(/[^a-zA-Z0-9]/g, '').slice(0, 10)}` })
      });
      const data = await res.json();
      if (data.qrcode?.base64 && activeQrImg) {
        activeQrImg.src = data.qrcode.base64.startsWith('data:')
          ? data.qrcode.base64
          : `data:image/png;base64,${data.qrcode.base64}`;
      }
    } catch (e) {}
  }

  // Event Listeners
  heroUrlForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    openPlanModal(heroUrlInput?.value || 'yourconsultancy.com');
  });

  footerUrlForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    openPlanModal(footerUrlInput?.value || 'yourconsultancy.com');
  });

  planModalCloseBtn?.addEventListener('click', closePlanModal);

  btnModalPayGrowth?.addEventListener('click', () => {
    launchRazorpay('Growth Plan', 19);
  });

  btnModalPayStarter?.addEventListener('click', () => {
    launchRazorpay('Starter Plan', 9);
  });

  btnModalPayPro?.addEventListener('click', () => {
    launchRazorpay('Pro Scale Plan', 49);
  });

  directPricingPayBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const plan = btn.getAttribute('data-plan') || 'Growth Plan';
      const amount = parseInt(btn.getAttribute('data-amount') || '19', 10);
      launchRazorpay(plan, amount);
    });
  });

  btnSimulatePaired?.addEventListener('click', () => {
    if (postPayStatusPill) {
      postPayStatusPill.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span class="text-emerald-700">WhatsApp Device Paired & Live!</span>';
    }
  });

  postPayModalClose?.addEventListener('click', () => {
    if (postPayModal) {
      postPayModal.classList.add('hidden');
      postPayModal.classList.remove('flex');
    }
  });

  btnPostPayDone?.addEventListener('click', () => {
    if (postPayModal) {
      postPayModal.classList.add('hidden');
      postPayModal.classList.remove('flex');
    }
  });
</script>
