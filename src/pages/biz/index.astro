---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="TravlTik for Business — Claim & Manage Your Business">
  <div class="min-h-screen bg-[#F8FAFC]">
    <!-- Hero -->
    <section class="bg-slate-900 text-white py-24 px-4">
      <div class="max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-bold tracking-wider uppercase mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          TravlTik for Business
        </div>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
          Claim your business.<br />Reach millions of travelers.
        </h1>
        <p class="text-lg text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed">
          Join thousands of verified consultants, universities, and agencies on TravlTik. Manage your profile, respond to reviews, and grow your business.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/biz/claim" class="px-8 py-4 bg-emerald-500 text-white rounded-xl font-bold hover:bg-emerald-600 transition-colors shadow-lg">
            Claim Your Business →
          </a>
          <a href="/biz/login" class="px-8 py-4 border border-white/20 text-white rounded-xl font-semibold hover:bg-white/10 transition-colors">
            Business Login
          </a>
        </div>
        <p class="text-xs text-slate-500 mt-6">
          Already have an account? <a href="/biz/login" class="text-emerald-400 hover:underline">Sign in</a>
        </p>
      </div>
    </section>

    <!-- Stats Strip -->
    <section class="bg-white border-b border-slate-200 py-8">
      <div class="max-w-5xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-black text-slate-900">193+</div>
          <div class="text-xs text-slate-500 mt-1 uppercase font-semibold">Countries</div>
        </div>
        <div>
          <div class="text-3xl font-black text-slate-900">50K+</div>
          <div class="text-xs text-slate-500 mt-1 uppercase font-semibold">Travelers</div>
        </div>
        <div>
          <div class="text-3xl font-black text-slate-900">100%</div>
          <div class="text-xs text-slate-500 mt-1 uppercase font-semibold">Escrow Protected</div>
        </div>
        <div>
          <div class="text-3xl font-black text-slate-900">24/7</div>
          <div class="text-xs text-slate-500 mt-1 uppercase font-semibold">Support</div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-20 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 text-center mb-4">
          Everything you need to grow
        </h2>
        <p class="text-sm text-slate-500 text-center mb-12 max-w-2xl mx-auto">
          Powerful tools to manage your business profile, engage with customers, and track performance.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl mb-4">🎯</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Reach Global Travelers</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              Connect with millions of travelers searching for visa and immigration services worldwide.
            </p>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl mb-4">🛡️</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Escrow Protection</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              Get paid securely through milestone-based escrow releases. Zero payment risk.
            </p>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl mb-4">📊</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Analytics & Insights</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              Track profile views, leads, and conversions in real-time with detailed dashboards.
            </p>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center text-2xl mb-4">⭐</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Respond to Reviews</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              Engage with your customers by responding to reviews publicly.
            </p>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-2xl mb-4">🔒</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Verified Badge</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              Get your profile verified to build trust with potential customers.
            </p>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center text-2xl mb-4">💬</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Lead Management</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              Receive and manage inquiries from potential clients in one place.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-20 px-4 bg-white border-y border-slate-200">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 text-center mb-12">
          How it works
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-blue-600 text-white flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
            <h3 class="font-bold text-slate-900 mb-2">Find Your Business</h3>
            <p class="text-xs text-slate-500">Search for your business or add it if it's not listed.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-blue-600 text-white flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
            <h3 class="font-bold text-slate-900 mb-2">Verify Ownership</h3>
            <p class="text-xs text-slate-500">Receive a verification email and confirm your identity.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-blue-600 text-white flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
            <h3 class="font-bold text-slate-900 mb-2">Manage Profile</h3>
            <p class="text-xs text-slate-500">Update your details, add services, and engage with customers.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-blue-600 text-white flex items-center justify-center text-2xl font-bold mx-auto mb-4">4</div>
            <h3 class="font-bold text-slate-900 mb-2">Grow Business</h3>
            <p class="text-xs text-slate-500">Track analytics, respond to reviews, and win more clients.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          Ready to get started?
        </h2>
        <p class="text-sm text-slate-500 mb-8">
          Claim your business in minutes and join thousands of verified providers.
        </p>
        <a href="/biz/claim" class="inline-block px-8 py-4 bg-emerald-500 text-white rounded-xl font-bold hover:bg-emerald-600 transition-colors shadow-lg">
          Claim Your Business →
        </a>
      </div>
    </section>
  </div>
</Layout>
