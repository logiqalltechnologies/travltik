---
import Layout from '../../layouts/Layout.astro';
import { BizSettings } from '../../components/biz/BizSettings';

export const prerender = false;
---

<Layout title="Business Settings — TravlTik for Business">
  <div class="min-h-screen bg-[#F8FAFC]">
    <div class="max-w-3xl mx-auto px-4 py-12">
      <a href="/biz/dashboard" class="text-xs text-slate-500 hover:text-slate-700 mb-4 inline-block font-semibold">
        ← Back to Dashboard
      </a>
      <h1 class="text-3xl font-bold text-slate-900 mb-2">Business Settings</h1>
      <p class="text-sm text-slate-500 mb-8">Manage your business profile.</p>
      <BizSettings client:load />
    </div>
  </div>
</Layout>
