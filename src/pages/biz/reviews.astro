---
import Layout from '../../layouts/Layout.astro';
import { BizReviews } from '../../components/biz/BizReviews';

export const prerender = false;
---

<Layout title="Reviews — TravlTik for Business">
  <div class="min-h-screen bg-[#F8FAFC]">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <a href="/biz/dashboard" class="text-xs text-slate-500 hover:text-slate-700 mb-4 inline-block font-semibold">
        ← Back to Dashboard
      </a>
      <h1 class="text-3xl font-bold text-slate-900 mb-2">Reviews</h1>
      <p class="text-sm text-slate-500 mb-8">Respond to customer reviews.</p>
      <BizReviews client:load />
    </div>
  </div>
</Layout>
