---
// src/pages/visa-guide/[country]/[type].astro
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Globe, FileText, Clock, DollarSign, CheckCircle, ArrowRight, Users, Sparkles, Shield, AlertCircle, ExternalLink } from 'lucide-react';

// Static fallback data
const staticVisas = [
  {
    country: "canada",
    type: "express-entry",
    title: "Canada Express Entry",
    flag: "🇨🇦",
    visaType: "Permanent Residence",
    processing: "6-8 months",
    cost: "CAD 1,365",
    requirements: ["Valid passport", "Language test (IELTS/CELPIP)", "Educational Credential Assessment (ECA)", "Police clearance certificate", "Medical examination", "Proof of funds (CAD 13,757+ for single)"],
    documents: ["Passport copies", "IELTS/CELPIP score report", "ECA certificate", "Employment reference letters", "Bank statements (6 months)", "Police clearance"],
    timeline: [{ step: "Create Express Entry profile", time: "1-2 weeks" }, { step: "Receive ITA (Invitation to Apply)", time: "Varies (CRS-dependent)" }, { step: "Submit full application", time: "60 days after ITA" }, { step: "Biometrics", time: "30 days after request" }, { step: "Decision", time: "6-8 months from submission" }]
  },
  {
    country: "usa",
    type: "f1",
    title: "USA F-1 Student Visa",
    flag: "🇺🇸",
    visaType: "Student Visa",
    processing: "3-5 weeks",
    cost: "USD 185 + SEVIS $350",
    requirements: ["I-20 from SEVP-certified school", "Valid passport", "Proof of financial support", "Ties to home country", "English proficiency", "Academic records"],
    documents: ["I-20 form", "DS-160 confirmation", "Passport", "Financial documents", "Academic transcripts", "TOEFL/IELTS scores"],
    timeline: [{ step: "Get I-20 from university", time: "2-4 weeks" }, { step: "Pay SEVIS fee", time: "1 day" }, { step: "Complete DS-160", time: "1 day" }, { step: "Schedule visa interview", time: "1-3 weeks" }, { step: "Attend interview", time: "1 day" }]
  }
];

const { country: rawCountry = 'canada', type: rawType = 'tourist' } = Astro.params;
const countryParam = (rawCountry || 'canada').toLowerCase();
const typeParam = (rawType || 'tourist').toLowerCase();

let visa = Astro.props?.visa;
let entry = Astro.props?.entry;

if (!visa) {
  // 1. Try staticVisas
  const found = staticVisas.find(v => v.country.toLowerCase() === countryParam && v.type.toLowerCase() === typeParam);
  if (found) {
    visa = found;
  } else {
    // 2. Try content collection
    try {
      const guides = await getCollection('visa-guides');
      const gEntry = guides?.find(g => g.data.country.toLowerCase() === countryParam && g.data.visaType.toLowerCase() === typeParam);
      if (gEntry) {
        entry = gEntry;
        visa = {
          country: countryParam,
          type: typeParam,
          title: gEntry.data.title,
          flag: countryParam === "canada" ? "🇨🇦" : countryParam === "usa" ? "🇺🇸" : "🌎",
          visaType: gEntry.data.visaType,
          processing: gEntry.data.processingTime,
          cost: gEntry.data.fee,
          requirements: gEntry.data.requirements,
          documents: [
            "Passport bio-data scan",
            "Digital passport size photo",
            "Completed visa application forms",
            ...(gEntry.data.requirements?.slice(0, 3) || [])
          ],
          timeline: [
            { step: "Submit Online Application Form", time: "1-2 days" },
            { step: "Document Verification & Filing", time: "3-5 days" },
            { step: "Embassy Processing Window", time: gEntry.data.processingTime }
          ]
        };
      }
    } catch (e) {
      // ignore collection lookup errors
    }
  }

  // 3. Dynamic consular fallback for any country & type
  if (!visa) {
    const formattedCountry = countryParam.charAt(0).toUpperCase() + countryParam.slice(1);
    const formattedType = typeParam.charAt(0).toUpperCase() + typeParam.slice(1);
    const countryFlags: Record<string, string> = {
      china: '🇨🇳',
      greece: '🇬🇷',
      france: '🇫🇷',
      germany: '🇩🇪',
      italy: '🇮🇹',
      spain: '🇪🇸',
      uk: '🇬🇧',
      'united kingdom': '🇬🇧',
      usa: '🇺🇸',
      'united states': '🇺🇸',
      canada: '🇨🇦',
      australia: '🇦🇺',
      japan: '🇯🇵',
      uae: '🇦🇪',
      dubai: '🇦🇪',
      singapore: '🇸🇬',
      thailand: '🇹🇭'
    };

    visa = {
      country: countryParam,
      type: typeParam,
      title: `${formattedCountry} ${formattedType} Visa`,
      flag: countryFlags[countryParam] || '✈️',
      visaType: `${formattedType} Visa`,
      processing: countryParam === 'china' ? '4–7 Days' : ['greece', 'france', 'germany', 'italy', 'spain'].includes(countryParam) ? '15–20 Days' : '10–15 Days',
      cost: countryParam === 'china' ? '₹7,930 Total' : ['greece', 'france', 'germany', 'italy', 'spain'].includes(countryParam) ? '€120 (~₹10,800)' : 'Official Consular Fee',
      requirements: [
        "Original Passport with at least 6 months validity beyond intended stay",
        "Recent compliant biometric passport-sized photographs",
        "Proof of financial solvency (bank statements / proof of income)",
        "Confirmed round-trip flight reservation and accommodation proof",
        "Clear travel itinerary with purpose-specific supporting documentation"
      ],
      documents: [
        "Original Passport & bio-data photocopies",
        "Official signed Visa Application Form",
        "Bank statements for last 3 to 6 months",
        "Confirmed flight itinerary & hotel accommodation vouchers",
        "Employment leave clearance letter (NOC) or business proof"
      ],
      timeline: [
        { step: "Check Eligibility & Gather Mandatory Documents", time: "1-2 days" },
        { step: "Complete Official Visa Application Form", time: "1 day" },
        { step: "Schedule & Attend Appointment for Biometrics", time: "3-5 days" },
        { step: "Consular Adjudication & Stamped Passport Dispatch", time: countryParam === 'china' ? '4-7 days' : '15-20 days' }
      ]
    };
  }
}

// Compile Content Collection entry if present
const Content = entry ? (await entry.render()).Content : null;

// JSON-LD structured schema for search engines
const schema = {
  "@context": "https://schema.org",
  "@type": "Guide",
  "name": visa.title,
  "description": visa.title + " requirements, documents checklist, processing time and fee guide.",
  "publisher": {
    "@type": "Organization",
    "name": "TravlTik"
  },
  "about": {
    "@type": "Thing",
    "name": visa.visaType + " for " + visa.country.toUpperCase()
  }
};
---

<Layout 
  title={`${visa.title} Official Guide`} 
  description={`${visa.title} complete requirements, required documents scan list, application processing fee (${visa.cost}) and step-by-step timeline details.`}
>
  <!-- SEO Structured Data Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="bg-white min-h-screen pb-24">
      {/* ── DYNAMIC LUXURY HERO BANNER (MATCHES THE 1ST PHOTO STRUCTURE) ── */}
      <div class="max-w-6xl mx-auto px-4 pt-8 pb-6">
          <div 
              className="relative w-full rounded-[40px] overflow-hidden flex flex-col items-center justify-center text-center px-6 py-20 min-h-[440px] shadow-2xl border border-white/10"
              style={{ background: '#0C1A2E' }}
          >
              {/* Background Image with Dark Purple/Violet Gradient Overlay */}
              <div className="absolute inset-0 z-0">
                  <img 
                      src="https://images.unsplash.com/photo-1506461883276-594a12b11cf3?w=1600&auto=format&fit=crop&q=80" 
                      alt="Twilight Petronas Towers" 
                      className="w-full h-full object-cover brightness-[0.7] contrast-[1.05]"
                  />
                  <div 
                      className="absolute inset-0 bg-gradient-to-b from-[#2E1A33]/70 via-[#0C1A2E]/80 to-[#0C1A2E]/90" 
                  />
              </div>

              {/* Banner Content */}
              <div className="relative z-10 max-w-2xl mx-auto flex flex-col items-center">
                  
                  {/* Flag Circular Badge */}
                  <div className="w-12 h-12 bg-white/10 backdrop-blur-md rounded-full border border-white/25 flex items-center justify-center text-2xl shadow-xl mb-4">
                      {visa.flag}
                  </div>

                  {/* Main Serif Header */}
                  <h1 className="font-serif text-3xl md:text-4xl lg:text-5xl font-normal text-white leading-tight tracking-wide mb-2 drop-shadow-md">
                      {visa.title} Guide
                  </h1>

                  {/* Bright Green Accent Highlight */}
                  <p className="text-[#00FF66] font-serif text-2xl md:text-3xl font-bold mb-8 tracking-wide drop-shadow-md">
                      in exactly 10 minutes
                  </p>

                  {/* 3-Column Metadata Row */}
                  <div className="grid grid-cols-3 gap-8 md:gap-16 text-center mb-10 w-full max-w-lg">
                      <div>
                          <span className="text-[9px] text-gray-400 font-bold uppercase tracking-wider block mb-1">VALID</span>
                          <span className="text-[11px] text-white font-extrabold tracking-wide uppercase block">{visa.processing}</span>
                      </div>
                      <div>
                          <span className="text-[9px] text-gray-400 font-bold uppercase tracking-wider block mb-1">PURPOSE</span>
                          <span className="text-[11px] text-white font-extrabold tracking-wide uppercase block">{visa.visaType}</span>
                      </div>
                      <div>
                          <span className="text-[9px] text-gray-400 font-bold uppercase tracking-wider block mb-1">MAX STAY</span>
                          <span className="text-[11px] text-white font-extrabold tracking-wide uppercase block">{visa.cost}</span>
                      </div>
                  </div>

                  {/* Pill CTA Button */}
                  <a href={`/visa/${visa.country.toLowerCase()}?passport=India&purpose=${visa.type.toLowerCase()}`} class="inline-block">
                      <button className="bg-white hover:bg-slate-100 text-slate-900 font-bold text-sm px-8 py-3.5 rounded-full transition-all duration-300 transform hover:scale-[1.02] shadow-xl tracking-wider active:scale-[0.98] select-none">
                          Check Requirements &amp; Apply Online
                      </button>
                  </a>
              </div>
          </div>
      </div>

      {/* ── TAB NAVIGATION MENU ── */}
      <div class="border-b border-gray-150 sticky top-16 bg-white z-40 shadow-sm mb-8">
          <div class="max-w-4xl mx-auto px-4 flex justify-between sm:justify-start gap-4 md:gap-8 overflow-x-auto py-1">
              {[
                  { id: "visa-info", label: "Visa Info" },
                  { id: "documents", label: "Documents" },
                  { id: "visa-process", label: "Visa Process" },
                  { id: "reviews", label: "Reviews" },
                  { id: "faqs", label: "FAQs" }
              ].map((tab, idx) => (
                  <button
                      id={`tab-btn-${tab.id}`}
                      class={`tab-link py-4 px-2 text-xs sm:text-sm font-bold tracking-wide transition-all border-b-2 outline-none whitespace-nowrap ${
                          idx === 0 ? "border-slate-900 text-slate-900 font-black" : "border-transparent text-gray-400 hover:text-slate-800"
                      }`}
                      onclick={`switchTab('${tab.id}')`}
                  >
                      {tab.label}
                  </button>
              ))}
          </div>
      </div>

      {/* ── DYNAMIC SECTIONS CONTENT CONTAINER ── */}
      <div class="max-w-4xl mx-auto px-4">
          
          {/* TAB 1: Visa Info */}
          <div id="sec-visa-info" class="tab-section space-y-6">
              {Content && (
                  <article class="prose max-w-none bg-white rounded-3xl border border-gray-150 p-8 shadow-sm prose-slate prose-headings:font-sans prose-headings:text-navy prose-h1:text-2xl prose-h2:text-xl prose-p:text-sm prose-p:leading-relaxed">
                      <Content />
                  </article>
              )}

              {/* Requirements Grid */}
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5 flex items-center gap-2">
                      <CheckCircle class="w-5 h-5 text-slate-800" /> Requirements Checklist
                  </h2>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                      {visa.requirements.map((r: string, i: number) => (
                          <div key={i} class="flex items-start gap-2.5 p-3.5 bg-gray-50/50 border border-gray-100 rounded-2xl">
                              <CheckCircle class="w-4 h-4 text-slate-800 mt-0.5 shrink-0" />
                              <span class="text-xs text-gray-700 font-semibold leading-relaxed">{r}</span>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* TAB 2: Documents */}
          <div id="sec-documents" class="tab-section hidden space-y-6">
              
              {/* LIVE REQUIREMENTS ENGINE (GEMINI) */}
              <section class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl border border-indigo-900/50">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                      <div class="space-y-1">
                          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] font-bold tracking-wider uppercase">
                              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                              Live Verification Engine
                          </div>
                          <h2 class="text-lg sm:text-xl font-bold tracking-tight text-white flex items-center gap-2">
                              <Sparkles class="w-5 h-5 text-indigo-400" />
                              Official Live Requirements Check
                          </h2>
                          <p class="text-xs text-slate-300 max-w-xl">
                              Query official embassy authorities, immigration gazettes, and official application portals in real-time via Gemini AI.
                          </p>
                      </div>

                      <button
                          id="btn-check-live"
                          onclick="checkLiveRequirements()"
                          class="shrink-0 bg-white hover:bg-slate-100 text-slate-900 font-extrabold text-xs sm:text-sm px-6 py-3.5 rounded-2xl transition-all shadow-lg hover:shadow-indigo-500/20 active:scale-95 flex items-center justify-center gap-2 cursor-pointer"
                      >
                          <Sparkles class="w-4 h-4 text-indigo-600" />
                          <span>Check Live Requirements</span>
                      </button>
                  </div>

                  {/* LOADING STATE */}
                  <div id="live-loading" class="hidden py-8 text-center space-y-3 bg-white/5 rounded-2xl border border-white/10">
                      <div class="inline-block w-8 h-8 border-2 border-indigo-400 border-t-transparent rounded-full animate-spin"></div>
                      <p class="text-xs font-semibold text-indigo-200">
                          Contacting official immigration authorities & verifying current regulations...
                      </p>
                      <p class="text-[10px] text-slate-400">Verifying documents, mandatory fees, and working day processing windows.</p>
                  </div>

                  {/* ERROR STATE */}
                  <div id="live-error" class="hidden p-4 bg-rose-500/10 border border-rose-500/30 rounded-2xl text-rose-300 text-xs">
                      <div class="flex items-center gap-2 font-bold mb-1 text-rose-200">
                          <AlertCircle class="w-4 h-4 text-rose-400 shrink-0" />
                          <span>Verification Error</span>
                      </div>
                      <p id="live-error-msg" class="text-slate-300"></p>
                  </div>

                  {/* RESULTS CONTAINER */}
                  <div id="live-results" class="hidden space-y-6 pt-4 border-t border-white/10">
                      {/* Live Meta Badges */}
                      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                          <div class="p-3 bg-white/5 rounded-xl border border-white/10">
                              <span class="text-[9px] text-slate-400 uppercase font-bold block mb-0.5">VISA CATEGORY</span>
                              <span id="live-meta-type" class="text-xs font-bold text-white block truncate">-</span>
                          </div>
                          <div class="p-3 bg-white/5 rounded-xl border border-white/10">
                              <span class="text-[9px] text-slate-400 uppercase font-bold block mb-0.5">PROCESSING TIME</span>
                              <span id="live-meta-processing" class="text-xs font-bold text-emerald-400 block truncate">-</span>
                          </div>
                          <div class="p-3 bg-white/5 rounded-xl border border-white/10">
                              <span class="text-[9px] text-slate-400 uppercase font-bold block mb-0.5">CONFIDENCE</span>
                              <span id="live-meta-confidence" class="text-xs font-bold text-indigo-300 uppercase block truncate">-</span>
                          </div>
                          <div class="p-3 bg-white/5 rounded-xl border border-white/10">
                              <span class="text-[9px] text-slate-400 uppercase font-bold block mb-0.5">LAST VERIFIED</span>
                              <span id="live-meta-date" class="text-xs font-bold text-slate-300 block truncate">-</span>
                          </div>
                      </div>

                      {/* CATEGORIES SECTION */}
                      <div class="space-y-4">
                          {/* Mandatory Docs */}
                          <div id="section-mandatory" class="space-y-2">
                              <div class="flex items-center gap-2">
                                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-500/30">
                                      MANDATORY DOCUMENTS
                                  </span>
                                  <span id="count-mandatory" class="text-[10px] text-slate-400 font-bold"></span>
                              </div>
                              <div id="list-mandatory" class="grid grid-cols-1 gap-2.5"></div>
                          </div>

                          {/* Conditional Docs */}
                          <div id="section-conditional" class="space-y-2 hidden">
                              <div class="flex items-center gap-2">
                                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
                                      CONDITIONAL REQUIREMENTS
                                  </span>
                                  <span id="count-conditional" class="text-[10px] text-slate-400 font-bold"></span>
                              </div>
                              <div id="list-conditional" class="grid grid-cols-1 gap-2.5"></div>
                          </div>

                          {/* Recommended Docs */}
                          <div id="section-recommended" class="space-y-2 hidden">
                              <div class="flex items-center gap-2">
                                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-sky-500/20 text-sky-300 border border-sky-500/30">
                                      RECOMMENDED DOCUMENTS
                                  </span>
                                  <span id="count-recommended" class="text-[10px] text-slate-400 font-bold"></span>
                              </div>
                              <div id="list-recommended" class="grid grid-cols-1 gap-2.5"></div>
                          </div>
                      </div>

                      {/* Official Sources Citation */}
                      <div id="live-sources-box" class="p-3.5 bg-white/5 rounded-xl border border-white/10 space-y-1.5 hidden">
                          <span class="text-[10px] text-slate-400 uppercase font-bold tracking-wider block">OFFICIAL CITATIONS & SOURCES</span>
                          <div id="live-sources-list" class="flex flex-wrap gap-2 text-xs"></div>
                      </div>
                  </div>
              </section>

              {/* Standard Document Checklist */}
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5 flex items-center gap-2">
                      <FileText class="w-5 h-5 text-slate-850" /> Standard Document Checklist
                  </h2>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                      {visa.documents.map((d: string, i: number) => (
                          <div key={i} class="flex items-center gap-3 p-3.5 bg-gray-50/50 border border-gray-100 rounded-2xl">
                              <FileText class="w-4 h-4 text-slate-800 shrink-0" />
                              <span class="text-xs text-gray-700 font-bold leading-normal">{d}</span>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* TAB 3: Visa Process */}
          <div id="sec-visa-process" class="tab-section hidden space-y-6">
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5 flex items-center gap-2">
                      <Clock class="w-5 h-5 text-slate-850" /> Step-by-Step Application Timeline
                  </h2>
                  <div class="space-y-4">
                      {visa.timeline.map((t: any, i: number) => (
                          <div key={i} class="flex items-start gap-4">
                              <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-black shadow-md shrink-0">
                                  {i + 1}
                              </div>
                              <div class="flex-1 pb-4 border-b border-gray-100 last:border-0">
                                  <h4 class="font-sans font-bold text-navy text-xs sm:text-sm">{t.step}</h4>
                                  <p class="text-[10px] text-gray-400 mt-1 font-bold">{t.time}</p>
                              </div>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* TAB 4: Reviews */}
          <div id="sec-reviews" class="tab-section hidden space-y-6">
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5">User Experiences & Reviews</h2>
                  <div class="space-y-4">
                      {[
                          { name: "Aarav Mehta", rating: 5, quote: "Extremely fast guide, application took less than 10 minutes as advertised. Highly professional support!" },
                          { name: "Priya Sharma", rating: 5, quote: "Clear checklist, helped me filter out unnecessary documentation files. Recommending to my circles." }
                      ].map((rev, i) => (
                          <div key={i} class="p-4 bg-gray-55/40 border border-gray-100 rounded-2xl">
                              <div class="flex items-center justify-between mb-2">
                                  <span class="text-xs font-bold text-slate-800">{rev.name}</span>
                                  <span class="text-amber-500 text-xs">{"★".repeat(rev.rating)}</span>
                              </div>
                              <p class="text-xs text-gray-500 italic">"{rev.quote}"</p>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* TAB 5: FAQs */}
          <div id="sec-faqs" class="tab-section hidden space-y-6">
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5">Frequently Asked Questions</h2>
                  <div class="space-y-4">
                      {[
                          { q: "Is the processing time guaranteed?", a: "Processing windows are average estimations based on real-time historical applications." },
                          { q: "Do I need to visit the embassy physically?", a: "No, this guide details a 100% online process with digital slot booking support." }
                      ].map((faq, i) => (
                          <div key={i} class="pb-3 border-b border-gray-100 last:border-0">
                              <h4 class="font-bold text-xs sm:text-sm text-navy mb-1">{faq.q}</h4>
                              <p class="text-xs text-gray-500">{faq.a}</p>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* Expert Call CTA */}
          <div class="text-center mt-10 bg-gradient-to-b from-gray-50 to-transparent p-8 rounded-3xl border border-gray-150">
              <span class="bg-slate-900/10 text-slate-800 text-[9px] font-black tracking-widest px-3 py-1 rounded-full mb-3 inline-block">Professional Assistance</span>
              <h3 class="font-sans text-xl font-bold text-navy mb-2">Need Help Filing Your Application?</h3>
              <p class="text-xs text-gray-500 max-w-md mx-auto mb-6">Connect with vetted visa experts, verified migration lawyers, and dedicated case officers.</p>
              <a href={`/find-experts?country=${visa.country}`} class="inline-block">
                  <button class="bg-black hover:bg-slate-900 text-white px-8 py-3.5 rounded-2xl font-bold text-xs tracking-wider flex items-center gap-2 transition-all">
                      <Users class="w-4 h-4" /> Connect with {visa.title} Experts <ArrowRight class="w-4 h-4" />
                  </button>
              </a>
          </div>

      </div>
  </div>

  <div id="live-requirements-meta" data-country={visa.country} data-purpose={visa.type} class="hidden"></div>

  <script is:inline>
      function switchTab(tabId) {
          // Hide all sections
          document.querySelectorAll('.tab-section').forEach(sec => {
              sec.classList.add('hidden');
          });
          // Show active section
          const target = document.getElementById('sec-' + tabId);
          if (target) target.classList.remove('hidden');

          // Reset tab button states
          document.querySelectorAll('.tab-link').forEach(btn => {
              btn.className = "tab-link py-4 px-2 text-xs sm:text-sm font-bold tracking-wide transition-all border-b-2 outline-none whitespace-nowrap border-transparent text-gray-400 hover:text-slate-800";
          });
          // Set active tab button state
          const btn = document.getElementById('tab-btn-' + tabId);
          if (btn) {
              btn.className = "tab-link py-4 px-2 text-xs sm:text-sm font-bold tracking-wide transition-all border-b-2 outline-none whitespace-nowrap border-slate-900 text-slate-900 font-black";
          }
      }

      async function checkLiveRequirements() {
          const meta = document.getElementById('live-requirements-meta');
          const destinationCountry = meta?.dataset?.country || 'France';
          const purpose = meta?.dataset?.purpose || 'tourism';

          const btn = document.getElementById('btn-check-live');
          const loading = document.getElementById('live-loading');
          const errorBox = document.getElementById('live-error');
          const errorMsg = document.getElementById('live-error-msg');
          const results = document.getElementById('live-results');

          if (btn) {
              btn.setAttribute('disabled', 'true');
              btn.classList.add('opacity-50', 'pointer-events-none');
          }
          if (loading) loading.classList.remove('hidden');
          if (errorBox) errorBox.classList.add('hidden');
          if (results) results.classList.add('hidden');

          try {
              const response = await fetch('/api/visa/live-requirements', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                      passportCountry: 'India',
                      destinationCountry,
                      purpose,
                  }),
              });

              const data = await response.json();

              if (!data.success) {
                  throw new Error(data.error || (data.details || 'Failed to fetch live requirements'));
              }

              renderLiveResults(data);
              if (results) results.classList.remove('hidden');
          } catch (err) {
              if (errorBox && errorMsg) {
                  errorMsg.textContent = err.message || 'Unable to retrieve live requirements at this moment.';
                  errorBox.classList.remove('hidden');
              }
          } finally {
              if (loading) loading.classList.add('hidden');
              if (btn) {
                  btn.removeAttribute('disabled');
                  btn.classList.remove('opacity-50', 'pointer-events-none');
              }
          }
      }

      function renderLiveResults(data) {
          const metaType = document.getElementById('live-meta-type');
          const metaProc = document.getElementById('live-meta-processing');
          const metaConf = document.getElementById('live-meta-confidence');
          const metaDate = document.getElementById('live-meta-date');

          if (metaType) metaType.textContent = data.visaType || 'Official Visa';
          if (metaProc) metaProc.textContent = data.processing?.estimatedTime || 'Standard Processing';
          if (metaConf) metaConf.textContent = (data.confidence || 'HIGH').toUpperCase();
          if (metaDate) {
              const d = new Date(data.checkedAt || Date.now());
              metaDate.textContent = d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
          }

          const mandatory = [];
          const conditional = [];
          const recommended = [];

          (data.documents || []).forEach(doc => {
              const m = (doc.mandatory || 'mandatory').toLowerCase();
              if (m.includes('condition')) {
                  conditional.push(doc);
              } else if (m.includes('recommend')) {
                  recommended.push(doc);
              } else {
                  mandatory.push(doc);
              }
          });

          renderCategory('mandatory', mandatory, 'bg-rose-500/20 text-rose-300 border-rose-500/30');
          renderCategory('conditional', conditional, 'bg-amber-500/20 text-amber-300 border-amber-500/30');
          renderCategory('recommended', recommended, 'bg-sky-500/20 text-sky-300 border-sky-500/30');

          const sourcesBox = document.getElementById('live-sources-box');
          const sourcesList = document.getElementById('live-sources-list');
          if (sourcesBox && sourcesList) {
              if (data.groundingSources && data.groundingSources.length > 0) {
                  sourcesList.innerHTML = data.groundingSources.map(s => `
                      <a href="${s.uri}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-3 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-indigo-200 hover:text-white transition-colors">
                          <span>${s.title}</span>
                          <span class="text-[10px]">↗</span>
                      </a>
                  `).join('');
                  sourcesBox.classList.remove('hidden');
              } else {
                  sourcesBox.classList.add('hidden');
              }
          }
      }

      function renderCategory(category, items, badgeClass) {
          const sec = document.getElementById('section-' + category);
          const count = document.getElementById('count-' + category);
          const list = document.getElementById('list-' + category);
          if (!sec || !list) return;

          if (!items || items.length === 0) {
              sec.classList.add('hidden');
              return;
          }

          sec.classList.remove('hidden');
          if (count) count.textContent = `(${items.length} ${items.length === 1 ? 'item' : 'items'})`;

          list.innerHTML = items.map(doc => `
              <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2 hover:bg-white/[0.07] transition-colors">
                  <div class="flex items-start justify-between gap-3">
                      <h4 class="text-xs sm:text-sm font-bold text-white leading-snug">${doc.name || 'Required Document'}</h4>
                      <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider shrink-0 border ${badgeClass}">
                          ${category.toUpperCase()}
                      </span>
                  </div>
                  ${doc.description ? `<p class="text-xs text-slate-300 leading-relaxed">${doc.description}</p>` : ''}
                  ${doc.condition ? `<div class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-[11px] text-amber-200"><strong>Condition:</strong> ${doc.condition}</div>` : ''}
                  <div class="flex flex-wrap items-center justify-between gap-2 pt-1 border-t border-white/5 text-[10px] text-slate-400">
                      <span>${doc.sourceName ? `Authority: ${doc.sourceName}` : 'Official Consular Source'}</span>
                      ${doc.sourceUrl ? `<a href="${doc.sourceUrl}" target="_blank" rel="noopener noreferrer" class="text-indigo-300 hover:text-white underline inline-flex items-center gap-1">View Source →</a>` : ''}
                  </div>
              </div>
          `).join('');
      }
  </script>
</Layout>
