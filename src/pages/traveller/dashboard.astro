---
// src/pages/traveller/dashboard.astro
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import UserDashboard from '../../components/user-dashboard/UserDashboard';
---

<Layout 
  title="Traveller Dashboard | TravlTik" 
  description="Manage your travel and visa journey. Check your upcoming sessions, view files in your Document Vault, and track your applications online."
  hideHeader={true}
  hideFooter={true}
  hideWidgets={true}
>
  <div class="font-sans antialiased text-slate-900 [-webkit-font-smoothing:antialiased] [-moz-osx-font-smoothing:grayscale] [text-rendering:optimizeLegibility]">
    <UserDashboard client:only="react" />
  </div>
</Layout>
