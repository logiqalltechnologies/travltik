---
// src/pages/service-provider/dashboard.astro
import Layout from '../../layouts/Layout.astro';
import { ConsultantDashboard } from '../../components/interactive/ConsultantDashboard';
import { verifySession } from '../../backend/auth';

const token = Astro.cookies.get('travltik_sid')?.value;
if (token) {
  const authResult = await verifySession(token);
  if (authResult?.type === 'expert') {
    const category = authResult.user.service_category || authResult.user.advisor_type || '';
    if (category === 'work_permit') {
      return Astro.redirect('/dashboard/work-permit');
    }
  }
}
---

<Layout 
  title="Service Provider Dashboard | TravlTik" 
  description="Manage your practice, client pipeline, consultations, and escrow milestones."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Mount client-only React expert dashboard island -->
  <ConsultantDashboard client:only="react" />
</Layout>
